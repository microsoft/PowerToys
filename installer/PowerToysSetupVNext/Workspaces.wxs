<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?include $(sys.CURRENTDIR)\Common.wxi?>

  <?define WorkspacesImagesComponentFiles=?>
  <?define WorkspacesImagesComponentFilesPath=$(var.BinDir)WinUI3Apps\Assets\Workspaces\?>
  <?define WorkspacesWinUIImagesComponentFiles=?>
  <?define WorkspacesWinUIImagesComponentFilesPath=$(var.BinDir)WinUI3Apps\Assets\Workspaces\?>

  <Fragment>
    <!-- Keep root assets for the shared icon fallback and install the WinUI assets beside both applications. -->
    <DirectoryRef Id="BaseApplicationsAssetsFolder">
      <Directory Id="WorkspacesAssetsInstallFolder" Name="Workspaces" />
    </DirectoryRef>
    <DirectoryRef Id="WinUI3AppsAssetsFolder">
      <Directory Id="WorkspacesWinUIAssetsInstallFolder" Name="Workspaces" />
    </DirectoryRef>
    <DirectoryRef Id="WorkspacesAssetsInstallFolder" FileSource="$(var.WorkspacesImagesComponentFilesPath)">
    <!-- Generated by generateFileComponents.ps1 -->
    <!--WorkspacesImagesComponentFiles_Component_Def-->
    </DirectoryRef>
    <DirectoryRef Id="WorkspacesWinUIAssetsInstallFolder" FileSource="$(var.WorkspacesWinUIImagesComponentFilesPath)">
    <!-- Generated by generateFileComponents.ps1 -->
    <!--WorkspacesWinUIImagesComponentFiles_Component_Def-->
    </DirectoryRef>

    <!-- Workspaces -->
    <ComponentGroup Id="WorkspacesComponentGroup">
      <Component Id="RemoveWorkspacesAssetsFolder" Guid="34FC1245-1197-4025-9CF1-A298D509C2CC" Directory="WorkspacesAssetsInstallFolder">
        <RegistryKey Root="$(var.RegistryScope)" Key="Software\Classes\powertoys\components">
          <RegistryValue Type="string" Name="RemoveWorkspacesAssetsFolder" Value="" KeyPath="yes" />
        </RegistryKey>
        <RemoveFolder Id="RemoveFolderWorkspacesAssetsFolder" Directory="WorkspacesAssetsInstallFolder" On="uninstall" />
      </Component>
      <Component Id="RemoveWorkspacesWinUIAssetsFolder" Guid="690293C3-9BDA-44FB-93EC-D492678E4FC2" Directory="WorkspacesWinUIAssetsInstallFolder">
        <RegistryKey Root="$(var.RegistryScope)" Key="Software\Classes\powertoys\components">
          <RegistryValue Type="string" Name="RemoveWorkspacesWinUIAssetsFolder" Value="" KeyPath="yes" />
        </RegistryKey>
        <RemoveFolder Id="RemoveFolderWorkspacesWinUIAssetsFolder" Directory="WorkspacesWinUIAssetsInstallFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>
