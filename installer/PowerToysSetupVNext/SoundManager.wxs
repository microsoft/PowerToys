<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?include $(sys.CURRENTDIR)\Common.wxi?>

  <?define SoundManagerAssetsFiles=?>
  <?define SoundManagerAssetsFilesPath=$(var.BinDir)WinUI3Apps\Assets\SoundManager\?>

  <Fragment>
    <DirectoryRef Id="WinUI3AppsAssetsFolder">
      <Directory Id="SoundManagerAssetsFolder" Name="SoundManager" />
    </DirectoryRef>
    <DirectoryRef Id="SoundManagerAssetsFolder" FileSource="$(var.SoundManagerAssetsFilesPath)">
    <!-- Generated by generateFileComponents.ps1 -->
    <!--SoundManagerAssetsFiles_Component_Def-->
    </DirectoryRef>

    <ComponentGroup Id="SoundManagerComponentGroup">
      <Component Id="RemoveSoundManagerFolder" Guid="85B10A2E-C780-4137-B37D-8E89D0469BC5" Directory="SoundManagerAssetsFolder">
        <RegistryKey Root="$(var.RegistryScope)" Key="Software\Classes\powertoys\components">
          <RegistryValue Type="string" Name="RemoveSoundManagerFolder" Value="" KeyPath="yes" />
        </RegistryKey>
        <RemoveFolder Id="RemoveFolderSoundManagerAssetsFolder" Directory="SoundManagerAssetsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>
