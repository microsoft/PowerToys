<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?include $(sys.CURRENTDIR)\Common.wxi?>

  <?define RobocopyUIAssetsFiles=?>
  <?define RobocopyUIAssetsFilesPath=$(var.BinDir)WinUI3Apps\Assets\RegistryPreview?>

  <Fragment>
    <!-- Registry Preview -->
    <DirectoryRef Id="WinUI3AppsAssetsFolder">
      <Directory Id="RobocopyUIAssetsInstallFolder" Name="RobocopyUI" />
    </DirectoryRef>
    <DirectoryRef Id="RobocopyUIAssetsInstallFolder" FileSource="$(var.RobocopyUIAssetsFilesPath)">
    <!-- Generated by generateFileComponents.ps1 -->
    <!--RegistryPreviewAssetsFiles_Component_Def-->
    </DirectoryRef>

    <ComponentGroup Id="RobocopyUIComponentGroup">
      <Component Id="RobocopyUIPreviewFolder" Guid="D3DBC395-FAC5-44B1-BE44-3FE2B6E0F391" Directory="RobocopyUIAssetsInstallFolder">
        <RegistryKey Root="$(var.RegistryScope)" Key="Software\Classes\powertoys\components">
          <RegistryValue Type="string" Name="RemoveRobocopyUIFolder" Value="" KeyPath="yes" />
        </RegistryKey>
        <RemoveFolder Id="RemoveFolderRobocopyUIAssetsFolder" Directory="RobocopyUIAssetsInstallFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>
