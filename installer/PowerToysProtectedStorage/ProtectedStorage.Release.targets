<Project>
  <Target Name="RequireProtectedStorageRelease">
    <Error Condition="'$(ProtectedStorageExpectedSignerSha256)' == ''" Text="ProtectedStorageExpectedSignerSha256 must be explicitly supplied by release signing configuration." />
    <Error Condition="!Exists('$(ProtectedStorageSetupPath)') Or !Exists('$(ProtectedStorageStagedSetupPath)') Or !Exists('$(ProtectedStorageCarrierPath)') Or !Exists('$(ProtectedStorageLifecyclePath)') Or !Exists('$(ProtectedStorageReleaseManifestPath)')" Text="Finalize and publish the signed protected-storage release with Build-Carrier.ps1 -Package or the externally signed release stages through -ReleaseStage Publish before packaging the main installer." />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Verify-Release.ps1&quot; -PackageRoot &quot;$(ProtectedStoragePackageRoot)&quot; -ExpectedSignerSha256 &quot;$(ProtectedStorageExpectedSignerSha256)&quot; -Version &quot;$(ProtectedStorageReleaseVersion)&quot; -Platform &quot;$(Platform)&quot; -PublishedSetupPath &quot;$(ProtectedStorageSetupPath)&quot;" />
  </Target>
</Project>
