@@ -80,10 +80,51 @@ public class SandboxUxRegressionTests
 
         var rule = harness.Cli.Operations.Single(op => op.Contains("New-NetFirewallRule", StringComparison.Ordinal));
 
-        StringAssert.Contains(rule, $"-LocalPort {material.Port}");
-        StringAssert.Contains(rule, "-Program $agent");
-        StringAssert.Contains(rule, "-Direction Inbound");
-        StringAssert.Contains(rule, "-Protocol TCP");
+        StringAssert.Contains(
+            rule,
+            $"-Direction Inbound -Action Allow -Protocol TCP -LocalPort {material.Port} -Program $agent " +
+            "-Profile Any -EdgeTraversalPolicy Allow -PolicyStore ActiveStore -ErrorAction Stop | Out-Null");
+    }
+
+    [TestMethod]
+    public async Task FirewallCleanup_EnumeratesApplicationFiltersOnceAndResolvesOnlyExactProgramMatches()
+    {
+        using var harness = new BackendHarness();
+
+        await harness.RunUntilAgentLaunchAsync(TestContext.CancellationToken);
+
+        var command = harness.Cli.Operations.Single(op => op.Contains("New-NetFirewallRule", StringComparison.Ordinal));
+
+        StringAssert.Contains(
+            command,
+            "$existing=Get-NetFirewallApplicationFilter -PolicyStore ActiveStore -ErrorAction SilentlyContinue | " +
+            "Where-Object { $_.Program -eq $agent } | ForEach-Object { " +
+            "Get-NetFirewallRule -AssociatedNetFirewallApplicationFilter $_ -PolicyStore ActiveStore -ErrorAction SilentlyContinue }; ");
+        Assert.AreEqual(
+            1,
+            command.Split("Get-NetFirewallApplicationFilter", StringSplitOptions.None).Length - 1,
+            "The bulk query must not be followed by a per-rule application-filter query.");
+    }
+
+    [TestMethod]
+    public async Task FirewallCleanup_RemovesBlockAndStaleAllowRulesFromBothStoresBeforeCreatingTheNewRule()
+    {
+        using var harness = new BackendHarness();
+
+        await harness.RunUntilAgentLaunchAsync(TestContext.CancellationToken);
+
+        var command = harness.Cli.Operations.Single(op => op.Contains("New-NetFirewallRule", StringComparison.Ordinal));
+        var cleanup = command[..command.IndexOf("New-NetFirewallRule", StringComparison.Ordinal)];
+
+        // Filtering by action or port would leave a blocking rule or the old allowed port behind.
+        Assert.IsFalse(cleanup.Contains("-Action", StringComparison.Ordinal));
+        Assert.IsFalse(cleanup.Contains("-LocalPort", StringComparison.Ordinal));
+        StringAssert.Contains(
+            command,
+            "foreach ($rule in $existing) { " +
+            "Remove-NetFirewallRule -Name $rule.Name -PolicyStore ActiveStore -ErrorAction SilentlyContinue; " +
+            "Remove-NetFirewallRule -Name $rule.Name -PolicyStore PersistentStore -ErrorAction SilentlyContinue }; " +
+            "New-NetFirewallRule");
     }
 
