# Copy this file to .env outside the repository. Never commit .env.
DOCKUR_IMAGE=docker.io/dockurr/windows:latest
# Windows 10 Enterprise LTSC 2021 (21H2/build 19044). Use 11 only in a separate Win11 VM.
WINDOWS_VERSION=10l
VM_CONTAINER_NAME=powertoys-ui-windows
VM_VOLUME_NAME=powertoys-ui-windows-storage
VM_ADMIN_USERNAME=PTAdmin
VM_ADMIN_PASSWORD=replace-with-a-unique-password
# default gives the guest 4 vCPUs and 8G RAM; constrained gives 1 vCPU and 4G RAM.
VM_RESOURCE_PROFILE=default
# The default profile (Start-LocalVm.ps1 with no -ResourceProfile, or -ResourceProfile Default).
VM_RAM_SIZE=8G
VM_CPU_CORES=4
# The constrained profile (Start-LocalVm.ps1 -ResourceProfile Constrained). Use only after the suite is green.
VM_CONSTRAINED_RAM_SIZE=4G
VM_CONSTRAINED_CPU_CORES=1
# Optional disposable-install accelerator; increases corruption risk on host/container failure.
# DISK_CACHE=writeback
# DISK_IO=threads
VM_DISK_SIZE=128G
VM_REGION=en-US
VM_KEYBOARD=en-US
VM_VIEWER_PORT=8006
VM_RDP_PORT=13389
VM_WINRM_PORT=15986
VM_WINRM_SCHEME=https
VM_MSVSMON_PORT=14026
VM_MSVSMON_WOW64_PORT=14025
