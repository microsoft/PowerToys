<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPLATE app.manifest for a .Next UI-test project.

  Copy this into EVERY UI-test executable that references UITestAutomation.Next, including greenfield
  projects without a .Next suffix. Element.Click and MouseHelper consume physical-pixel bounds from
  winappcli; without PerMonitorV2, Win32 cursor coordinates can be virtualized by the display scale
  and miss their targets on scaled or mixed-DPI desktops.

  Wire it into the csproj:
    <PropertyGroup>
      <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

  Replace __ASSEMBLY_NAME__ with the final AssemblyName from the csproj.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="__ASSEMBLY_NAME__.app"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10+ feature support for unpackaged apps. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
