<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)src\Common.Dotnet.props" />
  <PropertyGroup>
    <AssemblyName>PowerToys.TextExpander.Core</AssemblyName>
    <RootNamespace>Microsoft.PowerToys.TextExpander</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(RepoRoot)$(Platform)\$(Configuration)\WinUI3Apps</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Only the apps' .deps.json files are read at run time, and they already list this library. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PowerToys.TextExpander" />
    <InternalsVisibleTo Include="PowerToys.TextExpander.Editor" />
    <InternalsVisibleTo Include="PowerToys.TextExpander.UnitTests" />
    <InternalsVisibleTo Include="PowerToys.TextExpander.Editor.UnitTests" />
  </ItemGroup>
</Project>
