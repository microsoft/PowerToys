<Page
    x:Class="Microsoft.PowerToys.TextExpander.Editor.Views.TextExpanderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.TextExpander.Editor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.TextExpander.Editor.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Microsoft.PowerToys.TextExpander.Editor.ViewModels"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  A snippet's trigger, drawn as the key it is typed with, in the style of a KeyVisual key: body text, 32 px tall.  -->
        <Style x:Key="SnippetTriggerKeycapStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
        <!--  The date format guide's chips, built in code: the code as the editor shows variables, then what it gives, in secondary caption text.  -->
        <Style x:Key="TextExpanderDateCodeStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style
            x:Key="TextExpanderDateExampleStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
    <Grid>

        <ScrollViewer>
            <StackPanel
                MaxWidth="1000"
                Padding="24"
                Spacing="12">
                <TextBlock
                    x:Uid="TextExpander_EditorHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{ThemeResource TitleTextBlockStyle}" />
                <InfoBar
                    x:Uid="TextExpander_ElevatedEditingNotice"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsElevated, Mode=OneWay}"
                    Severity="Warning" />
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.CanEditSnippets, Mode=OneWay}"
                    IsTabStop="False">
                    <StackPanel Spacing="8">

                        <!--  Collapsed while closed too, so the panel's spacing doesn't leave a gap above Add a snippet.  -->
                        <InfoBar
                            x:Name="SnippetErrorBar"
                            x:Uid="TextExpander_SnippetError"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasSnippetError, Mode=OneWay}"
                            Message="{x:Bind ViewModel.SnippetError, Mode=OneWay}"
                            Severity="Error"
                            Visibility="{x:Bind ViewModel.HasSnippetError, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button x:Uid="TextExpander_RetrySnippets" Click="ReloadSnippets_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <tkcontrols:SettingsCard x:Uid="TextExpander_AddSnippet" HeaderIcon="{ui:FontIcon Glyph=&#xE710;}">
                            <Button
                                x:Uid="TextExpander_AddSnippetButton"
                                AutomationProperties.AutomationId="Button_TextExpander_AddSnippet"
                                Click="AddSnippet_Click"
                                IsEnabled="{x:Bind ViewModel.HasNoSnippetError, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </tkcontrols:SettingsCard>

                        <Grid
                            Margin="0,12,0,8"
                            ColumnSpacing="8"
                            RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Name="SnippetSearchBox"
                                x:Uid="TextExpander_Search"
                                AutomationProperties.AutomationId="TextExpander_SnippetSearch"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Uid="TextExpander_ClearSearch"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="Button_TextExpander_ClearSearch"
                                Click="ClearSearch_Click"
                                IsEnabled="{x:Bind ViewModel.HasSearchText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SnippetCountText, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            x:Name="SnippetStatus"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <!--  Virtualized, so only the rows in view are built however long the list is. Same rows and spacing as before.  -->
                        <ItemsRepeater Margin="0,2,0,0" ItemsSource="{x:Bind ViewModel.FilteredSnippets, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:TextExpanderSnippetViewModel">
                                    <!--
                                        ItemsRepeater sets no DataContext on rows built with x:Bind, so the row and each item in
                                        its menu carry their snippet in Tag. The pencil says that selecting the row edits it.
                                    -->
                                    <tkcontrols:SettingsCard
                                        x:Uid="TextExpander_SnippetRow"
                                        Margin="0,2,0,0"
                                        ActionIcon="{ui:FontIcon Glyph=&#xE70F;}"
                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                        Click="EditSnippet_Click"
                                        IsClickEnabled="True"
                                        Tag="{x:Bind}">
                                        <!--
                                            The trigger as a keycap, then what the snippet does: a plain sentence for a
                                            dynamic snippet with its saved text below, or the saved text itself.
                                        -->
                                        <tkcontrols:SettingsCard.Header>
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--  As wide as the widest keycap in the list, so the descriptions line up.  -->
                                                <Grid Width="{x:Bind KeycapColumnWidth, Mode=OneWay}">
                                                    <Border
                                                        AutomationProperties.Name="{x:Bind CaseVariantAutomationName, Mode=OneWay}"
                                                        Style="{StaticResource SnippetTriggerKeycapStyle}"
                                                        ToolTipService.ToolTip="{x:Bind TriggerDisplay, Mode=OneWay}">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind TriggerDisplay, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                                    <!--
                                                        The sentence, with each variable it mentions as the same bubble the editor
                                                        uses. Too long for its two lines, it shows as text, since a bubble past the
                                                        ellipsis would be drawn over the start of the line.
                                                    -->
                                                    <controls:TextExpanderBubbleText
                                                        MaxLines="2"
                                                        Segments="{x:Bind SentenceParts, Mode=OneWay}"
                                                        TextOnlyWhenTrimmed="True"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasSentence, Mode=OneWay}" />
                                                    <!--  No sentence: the saved text itself, on up to two of its lines. A cut-off line's cursor bar is a character.  -->
                                                    <controls:TextExpanderBubbleText
                                                        MaxLines="2"
                                                        Segments="{x:Bind TitleSegments, Mode=OneWay}"
                                                        TextOnlyWhenTrimmed="True"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        Visibility="{x:Bind ShowsSavedTextAsTitle, Mode=OneWay}" />
                                                    <!--
                                                        The saved text on one line, all as text: WinUI draws a bubble that falls past
                                                        the ellipsis at the start of the line, over the text.
                                                    -->
                                                    <controls:TextExpanderBubbleText
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        MaxLines="1"
                                                        Segments="{x:Bind Segments, Mode=OneWay}"
                                                        ShowBreaksAsMarkers="True"
                                                        TextOnly="True"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        Visibility="{x:Bind ShowsSavedTextBelow, Mode=OneWay}" />
                                                    <!--  An icon and the reason in words, so color is never the only cue.  -->
                                                    <Grid ColumnSpacing="6" Visibility="{x:Bind HasWarning, Mode=OneWay}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon
                                                            Margin="0,2,0,0"
                                                            VerticalAlignment="Top"
                                                            AutomationProperties.AccessibilityView="Raw"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                            Glyph="&#xE7BA;" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Warning, Mode=OneWay}"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </tkcontrols:SettingsCard.Header>
                                        <!--  Destructive row actions belong behind a flyout on clickable rows, which also prevents competing ContentDialogs on one XamlRoot.  -->
                                        <Button
                                            x:Uid="TextExpander_MoreOptions"
                                            VerticalAlignment="Center"
                                            Content="&#xE712;"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Tag="{x:Bind}">
                                            <Button.Flyout>
                                                <MenuFlyout Opening="RowMenu_Opening">
                                                    <MenuFlyoutItem
                                                        x:Uid="TextExpander_EditSnippet"
                                                        Click="EditSnippet_Click"
                                                        Icon="{ui:FontIcon Glyph=&#xE70F;}"
                                                        Tag="{x:Bind}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="TextExpander_DuplicateSnippet"
                                                        Click="DuplicateSnippet_Click"
                                                        Icon="{ui:FontIcon Glyph=&#xE8C8;}"
                                                        Tag="{x:Bind}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="TextExpander_DeleteSnippet"
                                                        Click="DeleteSnippet_Click"
                                                        Icon="{ui:FontIcon Glyph=&#xE74D;}"
                                                        Tag="{x:Bind}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <ToolTipService.ToolTip>
                                                <TextBlock x:Uid="More_Options_ButtonTooltip" />
                                            </ToolTipService.ToolTip>
                                        </Button>
                                    </tkcontrols:SettingsCard>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBlock
                            x:Uid="TextExpander_NoSearchResults"
                            Margin="0,12"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoMatchingSnippets, Mode=OneWay}" />

                        <StackPanel
                            Margin="0,12,0,0"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.HasNoSnippets, Mode=OneWay}">
                            <tkcontrols:SettingsCard
                                x:Uid="TextExpander_NoSnippets"
                                Margin="0,2,0,0"
                                HeaderIcon="{ui:FontIcon Glyph=&#xE946;}" />
                            <TextBlock
                                x:Uid="TextExpander_StarterHint"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Uid="TextExpander_StarterSignature"
                                Click="StarterSnippet_Click"
                                Tag="!mysig" />
                            <Button
                                x:Uid="TextExpander_StarterEmail"
                                Click="StarterSnippet_Click"
                                Tag="!myemail" />
                            <Button
                                x:Uid="TextExpander_StarterDate"
                                Click="StarterSnippet_Click"
                                Tag="!isodate" />
                        </StackPanel>

                    </StackPanel>
                </ContentControl>

                <!--  The active file is the source of truth. A sync service may sync its folder independently.  -->
                <tkcontrols:SettingsExpander
                    x:Uid="TextExpander_SnippetFile"
                    Description="{x:Bind ViewModel.SnippetFileSummary, Mode=OneWay}"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}"
                    IsEnabled="{x:Bind ViewModel.CanEditSnippets, Mode=OneWay}">
                    <tkcontrols:SettingsExpander.ItemsHeader>
                        <TextBlock
                            x:Uid="TextExpander_SnippetFile_SyncGuidance"
                            Margin="16,12,16,8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </tkcontrols:SettingsExpander.ItemsHeader>
                    <tkcontrols:SettingsExpander.Items>
                        <tkcontrols:SettingsCard x:Uid="TextExpander_SnippetFolder_Current" Description="{x:Bind ViewModel.SnippetsFolderPath, Mode=OneWay}">
                            <Button
                                x:Uid="TextExpander_SnippetFolder_Choose"
                                AutomationProperties.AutomationId="Button_TextExpander_ChooseFolder"
                                Click="ChooseSnippetsFolder_Click" />
                        </tkcontrols:SettingsCard>
                        <tkcontrols:SettingsCard x:Uid="TextExpander_SnippetFile_Open">
                            <Button
                                x:Uid="TextExpander_SnippetFile_OpenButton"
                                AutomationProperties.AutomationId="Button_TextExpander_OpenSnippetFile"
                                Click="OpenSnippetsFile_Click" />
                        </tkcontrols:SettingsCard>
                        <tkcontrols:SettingsCard x:Uid="TextExpander_SnippetFolder_Reload">
                            <Button
                                x:Uid="TextExpander_SnippetFolder_ReloadButton"
                                AutomationProperties.AutomationId="Button_TextExpander_ReloadSnippets"
                                Click="ReloadSnippets_Click" />
                        </tkcontrols:SettingsCard>
                    </tkcontrols:SettingsExpander.Items>
                </tkcontrols:SettingsExpander>
                <!--  Reference, not a setting, so it comes last. The elevated warning stays at the top: it explains disabled controls.  -->
                <InfoBar
                    x:Uid="TextExpander_PrivacyNotice"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational">
                    <!--
                        One fact per bullet. A wrapped line lines up with its text, not with the bullet. The constructor
                        insets the bullets the way InfoBar insets its own message, which custom content doesn't get.
                    -->
                    <StackPanel x:Name="PrivacyNoticeBullets" Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock AutomationProperties.AccessibilityView="Raw" Text="&#x2022;" />
                            <TextBlock
                                x:Uid="TextExpander_PrivacyNotice_Expansion"
                                Grid.Column="1"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock AutomationProperties.AccessibilityView="Raw" Text="&#x2022;" />
                            <TextBlock
                                x:Uid="TextExpander_PrivacyNotice_Undo"
                                Grid.Column="1"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </InfoBar>


                <HyperlinkButton x:Uid="Attribution_TextExpander" NavigateUri="https://howdygary.github.io/text-expander/" />
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="SnippetDialog"
            x:Uid="TextExpander_SnippetDialog"
            Closing="SnippetDialog_Closing"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="{x:Bind IsSnippetValid, Mode=OneWay}"
            PrimaryButtonClick="SnippetDialog_PrimaryButtonClick">
            <ScrollViewer>
                <StackPanel
                    MinWidth="0"
                    MaxWidth="440"
                    Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="TextExpander_Dialog_Trigger" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBox
                            x:Name="TriggerBox"
                            x:Uid="TextExpander_Dialog_TriggerBox"
                            AutomationProperties.AutomationId="TextExpander_Trigger"
                            AutomationProperties.FullDescription="{x:Bind SnippetProblem, Mode=OneWay}"
                            FontFamily="Consolas"
                            GotFocus="SnippetField_GotFocus"
                            TextChanged="SnippetField_Changed" />
                        <TextBlock
                            x:Uid="TextExpander_Dialog_TriggerHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock
                                x:Uid="TextExpander_Dialog_Replacement"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button x:Uid="TextExpander_Dialog_InsertVariable" HorizontalAlignment="Right">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="VariableFlyout" Placement="Bottom" />
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <!--
                            A RichEditBox only so the variables can be colored. The page's
                            TextExpanderReplacementEditor keeps it plain text, with \n line breaks.
                        -->
                        <RichEditBox
                            x:Name="ReplacementBox"
                            x:Uid="TextExpander_Dialog_ReplacementBox"
                            MinHeight="96"
                            AcceptsReturn="True"
                            AutomationProperties.AutomationId="TextExpander_Replacement"
                            ClipboardCopyFormat="PlainText"
                            DisabledFormattingAccelerators="All"
                            GotFocus="SnippetField_GotFocus"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            TextWrapping="Wrap">
                            <FlyoutBase.AttachedFlyout>
                                <!--
                                    Styled after a teaching tip on the token, but a Flyout: a TeachingTip doesn't open when it can't
                                    fit around its target, and after a light dismiss canceled to keep an invalid question open, it no
                                    longer catches clicks outside, so the replacement could change under the pending edit.
                                -->
                                <Flyout
                                    x:Name="PromptFlyout"
                                    Closed="PromptFlyout_Closed"
                                    Closing="PromptFlyout_Closing"
                                    Opened="PromptFlyout_Opened"
                                    Placement="BottomEdgeAlignedLeft"
                                    ShouldConstrainToRootBounds="True">
                                    <!--  The page sizes and places the content against the token (TextExpanderPromptPlacement).  -->
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="MaxWidth" Value="Infinity" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <ScrollViewer
                                        x:Name="PromptFlyoutScroller"
                                        x:Uid="TextExpander_PromptFlyout"
                                        AutomationProperties.AutomationId="TextExpander_PromptFlyout"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel
                                            x:Name="PromptFlyoutContent"
                                            Padding="12"
                                            PreviewKeyDown="PromptFlyoutContent_PreviewKeyDown">
                                            <TextBlock
                                                x:Uid="TextExpander_PromptFlyout_Title"
                                                AutomationProperties.HeadingLevel="Level2"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                            <TextBox
                                                x:Name="PromptQuestionBox"
                                                x:Uid="TextExpander_PromptFlyout_Question"
                                                Margin="0,12,0,0"
                                                AutomationProperties.AutomationId="TextExpander_PromptQuestion"
                                                TextChanged="PromptQuestionBox_TextChanged" />
                                            <TextBlock
                                                x:Name="PromptQuestionError"
                                                Margin="0,4,0,0"
                                                AutomationProperties.LiveSetting="Assertive"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed" />
                                            <ToggleSwitch
                                                x:Name="PromptRequired"
                                                x:Uid="TextExpander_PromptFlyout_Required"
                                                Margin="0,4,0,0"
                                                AutomationProperties.AutomationId="Toggle_TextExpander_PromptRequired"
                                                IsOn="True"
                                                Toggled="PromptRequired_Toggled" />
                                            <!--
                                                The window the snippet asks in, drawn at its own width and scaled down: the question over an
                                                empty box, with OK off while a required answer is blank. Only to look at, so it takes no input
                                                or focus. A ScrollViewer, unlike a panel, has an automation peer to carry the preview's name.
                                            -->
                                            <ScrollViewer
                                                x:Name="PromptPreview"
                                                x:Uid="TextExpander_PromptFlyout_Preview"
                                                Margin="0,8,0,0"
                                                IsHitTestVisible="False"
                                                VerticalScrollBarVisibility="Disabled">
                                                <Border
                                                    Padding="10"
                                                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <!--  The mockup's size, however wide the flyout.  -->
                                                    <Viewbox MaxWidth="288">
                                                        <Grid
                                                            Width="420"
                                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource OverlayCornerRadius}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Border
                                                                Grid.RowSpan="2"
                                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                                CornerRadius="7,7,0,0" />
                                                            <Grid
                                                                Height="32"
                                                                Padding="16,0,0,0"
                                                                ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="46" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image
                                                                    x:Name="PromptPreviewIcon"
                                                                    Width="16"
                                                                    Height="16"
                                                                    AutomationProperties.AccessibilityView="Raw" />
                                                                <TextBlock
                                                                    x:Uid="TextExpander_PromptFlyout_PreviewTitle"
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                                                                <FontIcon
                                                                    Grid.Column="2"
                                                                    AutomationProperties.AccessibilityView="Raw"
                                                                    FontSize="10"
                                                                    Glyph="&#xE8BB;" />
                                                            </Grid>
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Margin="24,12,24,24"
                                                                Spacing="8">
                                                                <Grid>
                                                                    <TextBlock x:Name="PromptPreviewLabel" TextWrapping="Wrap" />
                                                                    <TextBlock
                                                                        x:Name="PromptPreviewPlaceholder"
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                        Text="{x:Bind PromptQuestionBox.PlaceholderText}"
                                                                        TextWrapping="Wrap" />
                                                                </Grid>
                                                                <!--  The answer box, focused, as the window opens.  -->
                                                                <Border
                                                                    Height="32"
                                                                    Background="{ThemeResource TextControlBackgroundFocused}"
                                                                    BorderBrush="{ThemeResource TextControlBorderBrushFocused}"
                                                                    BorderThickness="{ThemeResource TextControlBorderThemeThicknessFocused}"
                                                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                                            </StackPanel>
                                                            <Grid
                                                                Grid.Row="2"
                                                                Padding="24"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="0,1,0,0"
                                                                ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button
                                                                    x:Name="PromptPreviewOk"
                                                                    x:Uid="TextExpander_PromptFlyout_PreviewOk"
                                                                    HorizontalAlignment="Stretch"
                                                                    AutomationProperties.AccessibilityView="Raw"
                                                                    IsEnabled="False"
                                                                    IsTabStop="False"
                                                                    Style="{StaticResource AccentButtonStyle}" />
                                                                <Button
                                                                    x:Uid="TextExpander_PromptFlyout_PreviewCancel"
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Stretch"
                                                                    AutomationProperties.AccessibilityView="Raw"
                                                                    IsTabStop="False" />
                                                            </Grid>
                                                        </Grid>
                                                    </Viewbox>
                                                </Border>
                                            </ScrollViewer>
                                            <Grid Margin="0,12,0,0" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--  Add for a new question, Update when one is reopened; the page sets which.  -->
                                                <Button
                                                    x:Name="PromptAddButton"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.AutomationId="Button_TextExpander_PromptAdd"
                                                    Click="PromptAdd_Click"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                                <Button
                                                    x:Uid="TextExpander_PromptFlyout_Cancel"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.AutomationId="Button_TextExpander_PromptCancel"
                                                    Click="PromptCancel_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </RichEditBox>

                        <!--
                            The date format guide: shown while the caret is in a {{date:…}} variable, such as right after
                            Custom format…. Its chips, added in code, put a code in at the caret.
                        -->
                        <StackPanel
                            x:Name="DateFormatGuide"
                            Margin="0,4,0,0"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Uid="TextExpander_DateGuide_Title"
                                FontWeight="SemiBold"
                                Style="{ThemeResource CaptionTextBlockStyle}" />
                            <StackPanel x:Name="DateFormatCodes" Spacing="4" />
                            <TextBlock
                                x:Name="DateFormatShowsAs"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Uid="TextExpander_DateGuide_Tip"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <HyperlinkButton
                                x:Uid="TextExpander_DateGuide_MoreCodes"
                                Padding="0"
                                FontSize="12"
                                NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings" />
                        </StackPanel>

                        <!--  RichEdit takes colors rather than brushes, so the editor reads the theme's from here.  -->
                        <Border
                            x:Name="VariableColorProbe"
                            Background="{ThemeResource TextControlBackgroundFocused}"
                            BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Visibility="Collapsed">
                            <Border x:Name="VariableColorProbeBase" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        </Border>
                    </StackPanel>

                    <InfoBar
                        x:Name="SnippetProblemBar"
                        IsClosable="False"
                        IsOpen="{x:Bind HasSnippetProblem, Mode=OneWay}"
                        Message="{x:Bind SnippetProblem, Mode=OneWay}"
                        Severity="Warning"
                        Visibility="{x:Bind HasSnippetProblem, Mode=OneWay}" />

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="TextExpander_Dialog_Preview" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Border
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <controls:TextExpanderBubbleText x:Name="SnippetPreviewText" />
                        </Border>
                        <TextBlock
                            x:Name="PreviewHint"
                            x:Uid="TextExpander_PreviewHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--  About closing, so last, right above Save and Cancel. The buttons wrap in a narrow window.  -->
                    <InfoBar
                        x:Name="DiscardWarning"
                        x:Uid="TextExpander_DiscardWarning"
                        IsClosable="False"
                        IsOpen="{x:Bind ShowDiscardWarning, Mode=OneWay}"
                        Severity="Warning"
                        Visibility="{x:Bind ShowDiscardWarning, Mode=OneWay}">
                        <InfoBar.Content>
                            <!--
                                The constructor insets the buttons the way InfoBar insets its own message. Keep editing's
                                margin spaces them: WrapPanel adds HorizontalSpacing after the last button too, which would
                                push both buttons further in from the right.
                            -->
                            <tkcontrols:WrapPanel
                                x:Name="DiscardWarningButtons"
                                HorizontalAlignment="Right"
                                VerticalSpacing="8">
                                <Button
                                    x:Name="KeepEditingButton"
                                    x:Uid="TextExpander_KeepEditing"
                                    Margin="0,0,8,0"
                                    Click="KeepEditing_Click" />
                                <Button x:Uid="TextExpander_DiscardChanges" Click="DiscardChanges_Click" />
                            </tkcontrols:WrapPanel>
                        </InfoBar.Content>
                    </InfoBar>

                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
