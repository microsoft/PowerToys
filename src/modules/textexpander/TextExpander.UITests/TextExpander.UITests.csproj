<Project Sdk="Microsoft.NET.Sdk">
  <!-- Look at Directory.Build.props in root for common stuff as well -->
  <Import Project="$(RepoRoot)src\Common.Dotnet.CsWinRT.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The window the tests type triggers into is a WinForms text box in the test process. -->
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <RootNamespace>Microsoft.PowerToys.TextExpander.UITests</RootNamespace>
    <AssemblyName>TextExpander.UITests</AssemblyName>
    <!-- Element.Click and MouseHelper use physical winappcli bounds with Win32 cursor input. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Microsoft.Testing.Platform: appears in Test Explorer and runs as an executable. -->
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- UI tests need a live desktop; never run them as part of MSBuild. -->
    <RunVSTest>false</RunVSTest>

    <!-- The notice bubble's sources are compiled in (below); its COM interop uses pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Stage the built test app under <Platform>\<Configuration>\tests\ so the UI-tests pipeline picks it up. -->
  <PropertyGroup>
    <OutputPath>$(RepoRoot)$(Platform)\$(Configuration)\tests\TextExpander.UITests\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms' implicit usings would make the harness's Button, TextBox and ComboBox ambiguous; the typing target aliases WinForms. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\common\UITestAutomation.Next\UITestAutomation.Next.csproj" />
  </ItemGroup>

  <!--
    The engine's notice bubble, shown by the test process over its own typing target, as the engine shows it over the
    app being typed into. EngineText.cs here stands in for the engine's resource loader with the English.
  -->
  <ItemGroup>
    <Compile Include="..\TextExpander\Native.cs" Link="Engine\Native.cs" />
    <Compile Include="..\TextExpander\NoticeBubble.cs" Link="Engine\NoticeBubble.cs" />
    <Compile Include="..\TextExpander\NoticeRequests.cs" Link="Engine\NoticeRequests.cs" />
    <Compile Include="..\TextExpander\NoticePainter.cs" Link="Engine\NoticePainter.cs" />
    <Compile Include="..\TextExpander\NoticeRenderer.cs" Link="Engine\NoticeRenderer.cs" />
    <Compile Include="..\TextExpander\NoticeLayout.cs" Link="Engine\NoticeLayout.cs" />
    <Compile Include="..\TextExpander\NoticeTheme.cs" Link="Engine\NoticeTheme.cs" />
    <Compile Include="..\TextExpander\NoticeTiming.cs" Link="Engine\NoticeTiming.cs" />
    <Compile Include="..\TextExpander\NoticeAutomation.cs" Link="Engine\NoticeAutomation.cs" />
    <Compile Include="..\TextExpander\IRawElementProviderSimple.cs" Link="Engine\IRawElementProviderSimple.cs" />
    <Compile Include="..\TextExpander\IWindowProvider.cs" Link="Engine\IWindowProvider.cs" />
    <Compile Include="..\TextExpander\CaretLocator.cs" Link="Engine\CaretLocator.cs" />
    <Compile Include="..\TextExpander\CaretAutomation.cs" Link="Engine\CaretAutomation.cs" />
    <Compile Include="..\TextExpander\TimedWorker.cs" Link="Engine\TimedWorker.cs" />
  </ItemGroup>
</Project>
