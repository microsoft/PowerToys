<?xml version="1.0" encoding="utf-8"?>
<!--
  Element.Click and MouseHelper consume physical-pixel bounds from winappcli; without PerMonitorV2,
  Win32 cursor coordinates can be virtualized by the display scale and miss their targets on scaled
  or mixed-DPI desktops.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="RegistryPreview.UITests.app"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10+ feature support for unpackaged apps. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
