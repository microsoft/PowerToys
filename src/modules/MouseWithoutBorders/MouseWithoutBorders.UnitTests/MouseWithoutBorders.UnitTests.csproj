<Project Sdk="Microsoft.NET.Sdk">
  <!-- Look at Directory.Build.props in root for common stuff as well -->
  <Import Project="$(RepoRoot)src\Common.Dotnet.CsWinRT.props" />
  <Import Project="$(RepoRoot)src\Common.SelfContained.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Core\Logger.PrivateDump.expected.txt" />
    <None Remove="Core\Logger.PrivateDump.original.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\Logger.PrivateDump.expected.txt" />
    <EmbeddedResource Include="Core\Logger.PrivateDump.original.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App\MouseWithoutBorders.csproj" />
    <ProjectReference Include="..\Tests\ClipboardHelper.PipeTestHost\ClipboardHelper.PipeTestHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyClipboardPipeTestHost" AfterTargets="Build">
    <ItemGroup>
      <ClipboardPipeTestHostFiles Include="$(RepoRoot)$(Platform)\$(Configuration)\ClipboardHelper.PipeTestHost\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClipboardPipeTestHostFiles)" DestinationFiles="@(ClipboardPipeTestHostFiles->'$(TargetDir)ClipboardHelper.PipeTestHost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
