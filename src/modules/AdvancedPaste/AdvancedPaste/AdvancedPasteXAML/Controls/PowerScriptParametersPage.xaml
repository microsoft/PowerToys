<UserControl
    x:Class="AdvancedPaste.Controls.PowerScriptParametersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="PowerScriptParametersPage">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="ParameterDescriptionTextStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8,0,8,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <Grid MinHeight="40" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    Width="40"
                    MinHeight="40"
                    AutomationProperties.AutomationId="PowerScriptParametersBack"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Glyph="&#xE72B;" />
                </Button>
                <TextBlock
                    x:Name="ScriptTitle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PowerScriptParametersTitle"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="HelpButton"
                    Grid.Column="2"
                    Width="32"
                    Padding="8"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PowerScriptParametersHelp"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Glyph="&#xE946;" />
                    <Button.Flyout>
                        <Flyout>
                            <TextBlock
                                x:Name="ParameterHelp"
                                MaxWidth="320"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <TextBlock
                x:Name="ValidationError"
                Margin="12,0,12,0"
                AutomationProperties.AutomationId="PowerScriptParameterError"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
        <ScrollViewer
            Grid.Row="1"
            AutomationProperties.AutomationId="PowerScriptParametersScroll"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ParameterFields"
                Margin="12,0,12,8"
                Spacing="12" />
        </ScrollViewer>
        <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Button
                x:Name="RunButton"
                Grid.Row="1"
                MinHeight="40"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="PowerScriptParametersRun"
                Style="{StaticResource SubtleButtonStyle}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Glyph="&#xE768;" />
                    <TextBlock
                        x:Name="RunLabel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
