#include <windows.h>
#include "resource.h"
#include "../../../common/version/version.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

1 VERSIONINFO
 FILEVERSION FILE_VERSION
 PRODUCTVERSION PRODUCT_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", COMPANY_NAME
            VALUE "FileDescription", "PowerToys Auto Hide Cursor Module Interface"
            VALUE "FileVersion", FILE_VERSION_STRING
            VALUE "InternalName", "AutoHideCursor"
            VALUE "LegalCopyright", COPYRIGHT_NOTE
            VALUE "OriginalFilename", "PowerToys.AutoHideCursor.dll"
            VALUE "ProductName", PRODUCT_NAME
            VALUE "ProductVersion", PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_AUTO_HIDE_CURSOR_NAME L"Auto Hide Cursor"
    IDS_AUTO_HIDE_CURSOR_HIDE_ON_TYPING L"Hide after keyboard input"
    IDS_AUTO_HIDE_CURSOR_HIDE_ON_IDLE L"Hide after pointer inactivity"
    IDS_AUTO_HIDE_CURSOR_IDLE_DELAY L"Pointer idle delay (milliseconds)"
END
