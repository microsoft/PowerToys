<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MouseJump.WinUI3.UI.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MouseJump.WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MouseJump.WinUI3"
    mc:Ignorable="d">
    <!--
        Image and StackPanel can't take keyboard focus, so the preview is hosted in a
        focusable control to receive Escape and the screen navigation keys.
    -->
    <ContentControl
        x:Name="FocusHost"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        IsTabStop="True"
        UseSystemFocusVisuals="False">
        <StackPanel
            x:Name="StackPanel"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Image
                x:Name="PreviewImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </StackPanel>
    </ContentControl>
</Window>
