<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MouseJump.WinUI3.UI.PreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MouseJump.WinUI3.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="False">
    <!--
        BackgroundImage fills this control exactly (see PreviewPane.xaml.cs). ScreensCanvas is
        layered on top and populated in code-behind with one bezel/placeholder/content element
        per screen, each positioned absolutely to match its ScreenLayout bounds.
    -->
    <Grid>
        <Image
            x:Name="BackgroundImage"
            Stretch="Fill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <Canvas
            x:Name="ScreensCanvas" />
    </Grid>
</UserControl>
