<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MouseJump.WinUI3.UI.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MouseJump.WinUI3.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MouseJump.WinUI3">
    <!--
        BorderImage fills the whole window (the AppWindow is already sized/positioned to the
        host box's own outer bounds - see PreviewWindow.xaml.cs) - PreviewPane is positioned
        on top of it via an explicit Margin equal to the host's margin+border thickness, so it
        lines up exactly with the transparent hole in the middle of the border image.

        The window itself is clipped to a rounded-rectangle region matching that same shape (see
        PreviewWindow.ApplyWindowRegion) - an unpackaged WinUI3 window can't get real per-pixel
        alpha transparency from DWM, so this is what actually makes the corners outside the
        rounded border disappear against the real desktop, rather than BorderImage's own
        transparent corners alone.
    -->
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Image
            x:Name="BorderImage"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False" />
        <local:PreviewPane
            x:Name="PreviewPane"
            x:FieldModifier="internal"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
    </Grid>
</Window>
