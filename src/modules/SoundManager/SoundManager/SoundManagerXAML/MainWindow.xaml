<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="SoundManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SoundManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    IsMaximizable="False"
    IsResizable="False"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="titleBar" IsTabStop="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/SoundManager/SoundManager.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Margin="16,8,16,16" Spacing="20">

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="TxtOutput" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <ItemsControl x:Name="OutputDeviceList" ItemsSource="{x:Bind OutputDevices, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AudioDeviceInfo">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                              ColumnSpacing="8"
                                              RowDefinitions="Auto,Auto">
                                            <RadioButton Grid.Column="0"
                                                         HorizontalAlignment="Stretch"
                                                         Click="OutputDeviceRadio_Click"
                                                         GroupName="OutputDevices"
                                                         IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                         Tag="{x:Bind}">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{x:Bind Name, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ToolTipService.ToolTip>
                                                    <TextBlock x:Uid="BtnOutputDeviceTooltip" />
                                                </ToolTipService.ToolTip>
                                            </RadioButton>

                                            <!-- Mono, or where the sound sits between the two ears. -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Border Padding="8,1"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Visibility="{x:Bind MonoBadgeVisibility, Mode=OneWay}">
                                                    <Border.Background>
                                                        <SolidColorBrush Opacity="0.22" Color="{ThemeResource SystemAccentColor}" />
                                                    </Border.Background>
                                                    <Border.BorderBrush>
                                                        <SolidColorBrush Opacity="0.5" Color="{ThemeResource SystemAccentColor}" />
                                                    </Border.BorderBrush>
                                                    <TextBlock x:Uid="TxtMonoBadge"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource SystemAccentColor}" />
                                                </Border>

                                                <Grid Width="52"
                                                      Height="14"
                                                      Visibility="{x:Bind BalanceIndicatorVisibility, Mode=OneWay}">
                                                    <Border Width="52"
                                                            Height="3"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            CornerRadius="2" />
                                                    <Border Width="1"
                                                            Height="8"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Ellipse Width="10"
                                                             Height="10"
                                                             Margin="{x:Bind BalanceDotMargin, Mode=OneWay}"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Grid>
                                            </Grid>

                                            <Button Grid.Column="2"
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Click="CallsDeviceButton_Click"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{x:Bind CallsButtonTooltip, Mode=OneWay}">
                                                <Grid Width="16" Height="16">
                                                    <FontIcon FontSize="14"
                                                              Glyph="&#xE95B;"
                                                              Visibility="{x:Bind CallsIconIdleVisibility, Mode=OneWay}" />
                                                    <FontIcon FontSize="14"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              Glyph="&#xE95B;"
                                                              Visibility="{x:Bind CallsBadgeVisibility, Mode=OneWay}" />
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Margin="0,-3,-3,0"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Top"
                                                             Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                             Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                             StrokeThickness="1"
                                                             Visibility="{x:Bind CallsBadgeVisibility, Mode=OneWay}" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="3"
                                                    Width="24"
                                                    Height="24"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Click="DeviceExpandButton_Click"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind}">
                                                <FontIcon FontSize="14" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                                                <ToolTipService.ToolTip>
                                                    <TextBlock x:Uid="BtnMoreControlsTooltip" />
                                                </ToolTipService.ToolTip>
                                            </Button>

                                            <!-- Balance, mono, the test sound and the reset button. -->
                                            <Grid Grid.Row="1"
                                                  Grid.ColumnSpan="4"
                                                  Margin="24,8,0,0"
                                                  ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="16"
                                                  Visibility="{x:Bind DetailsVisibility, Mode=OneWay}">
                                                <TextBlock x:Uid="TxtBalance"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center" />

                                                <Grid Grid.Column="1"
                                                      ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="6">
                                                    <TextBlock x:Uid="TxtBalanceLeft"
                                                               Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                    <!-- The WinUI slider draws its track above the middle, so it is pushed down to line up with the words beside it. -->
                                                    <Slider Grid.Column="1"
                                                            Margin="0,5,0,-5"
                                                            IsEnabled="{x:Bind BalanceSliderEnabled, Mode=OneWay}"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Tag="{x:Bind}"
                                                            TickFrequency="50"
                                                            ValueChanged="DeviceBalanceSlider_ValueChanged"
                                                            Value="{x:Bind BalanceValue, Mode=OneWay}" />

                                                    <TextBlock x:Uid="TxtBalanceRight"
                                                               Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="10">
                                                    <TextBlock x:Uid="TxtMono"
                                                               VerticalAlignment="Center" />

                                                    <ToggleSwitch IsOn="{x:Bind IsMono, Mode=OneWay}"
                                                                  OffContent=""
                                                                  OnContent=""
                                                                  Tag="{x:Bind}"
                                                                  Toggled="DeviceMonoToggle_Toggled"
                                                                  Translation="0,1,0" />

                                                    <Button Width="24"
                                                            Height="24"
                                                            MinWidth="0"
                                                            MinHeight="0"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Click="DeviceTestButton_Click"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind TestButtonTooltip, Mode=OneWay}">
                                                        <Grid Width="16" Height="16">
                                                            <FontIcon FontSize="14"
                                                                      Glyph="&#xE768;"
                                                                      Visibility="{x:Bind TestIconIdleVisibility, Mode=OneWay}" />
                                                            <ProgressRing Width="14"
                                                                          Height="14"
                                                                          IsActive="{x:Bind IsTesting, Mode=OneWay}"
                                                                          Visibility="{x:Bind TestSpinnerVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                    </Button>

                                                    <Button Width="24"
                                                            Height="24"
                                                            MinWidth="0"
                                                            MinHeight="0"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Click="DeviceResetButton_Click"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Tag="{x:Bind}">
                                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                                        <ToolTipService.ToolTip>
                                                            <TextBlock x:Uid="BtnResetDeviceTooltip" />
                                                        </ToolTipService.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Slider x:Name="OutputVolumeSlider"
                                        Grid.Column="0"
                                        Maximum="100"
                                        Minimum="0"
                                        ValueChanged="OutputVolumeSlider_ValueChanged" />
                                <TextBlock x:Name="OutputVolumeLabel"
                                           Grid.Column="1"
                                           MinWidth="44"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" />
                                <Button x:Name="OutputMuteButton"
                                        Grid.Column="2"
                                        Width="28"
                                        Height="28"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Click="OutputMuteButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon x:Name="OutputMuteIcon" FontSize="14" Glyph="&#xE767;" />
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="BtnMuteTooltip" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="TxtMicrophone" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <ItemsControl x:Name="InputDeviceList" ItemsSource="{x:Bind InputDevices, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AudioDeviceInfo">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <RadioButton Grid.Column="0"
                                                         HorizontalAlignment="Stretch"
                                                         Click="InputDeviceRadio_Click"
                                                         GroupName="InputDevices"
                                                         IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                         Tag="{x:Bind}">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{x:Bind Name, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ToolTipService.ToolTip>
                                                    <TextBlock x:Uid="BtnInputDeviceTooltip" />
                                                </ToolTipService.ToolTip>
                                            </RadioButton>

                                            <Button Grid.Column="1"
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Click="ListenButton_Click"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{x:Bind ListenButtonTooltip, Mode=OneWay}">
                                                <Grid Width="16" Height="16">
                                                    <FontIcon FontSize="14"
                                                              Glyph="&#xE767;"
                                                              Visibility="{x:Bind ListenIconIdleVisibility, Mode=OneWay}" />
                                                    <FontIcon FontSize="14"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              Glyph="&#xE767;"
                                                              Visibility="{x:Bind ListenIconOnVisibility, Mode=OneWay}" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="2"
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Click="CallsDeviceButton_Click"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{x:Bind CallsButtonTooltip, Mode=OneWay}">
                                                <Grid Width="16" Height="16">
                                                    <FontIcon FontSize="14"
                                                              Glyph="&#xE95B;"
                                                              Visibility="{x:Bind CallsIconIdleVisibility, Mode=OneWay}" />
                                                    <FontIcon FontSize="14"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              Glyph="&#xE95B;"
                                                              Visibility="{x:Bind CallsBadgeVisibility, Mode=OneWay}" />
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Margin="0,-3,-3,0"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Top"
                                                             Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                             Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                             StrokeThickness="1"
                                                             Visibility="{x:Bind CallsBadgeVisibility, Mode=OneWay}" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Slider x:Name="InputVolumeSlider"
                                        Grid.Column="0"
                                        Maximum="100"
                                        Minimum="0"
                                        ValueChanged="InputVolumeSlider_ValueChanged" />
                                <TextBlock x:Name="InputVolumeLabel"
                                           Grid.Column="1"
                                           MinWidth="44"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" />
                                <Button x:Name="InputMuteButton"
                                        Grid.Column="2"
                                        Width="28"
                                        Height="28"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Click="InputMuteButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon x:Name="InputMuteIcon" FontSize="14" Glyph="&#xE720;" />
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="BtnMuteTooltip" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="TxtApplications" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Border Padding="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <TextBlock x:Name="EmptyStateText"
                                       x:Uid="TxtEmptyState"
                                       Margin="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />

                            <ItemsControl ItemsSource="{x:Bind Apps, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AppViewModel">
                                        <Grid Padding="12,8"
                                              ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="12"
                                              RowDefinitions="Auto,Auto">

                                            <Image Grid.Column="0"
                                                   Width="24"
                                                   Height="24"
                                                   VerticalAlignment="Center"
                                                   Source="{x:Bind Icon, Mode=OneWay}" />

                                            <Grid Grid.Column="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{x:Bind AppName, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                                <Grid Grid.Column="1" VerticalAlignment="Center">

                                                    <!-- The program plays in both ears at the same level. The fill is a soft wash of the accent colour. -->
                                                    <Border Padding="8,1"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Visibility="{x:Bind MonoBadgeVisibility, Mode=OneWay}">
                                                        <Border.Background>
                                                            <SolidColorBrush Opacity="0.22" Color="{ThemeResource SystemAccentColor}" />
                                                        </Border.Background>
                                                        <Border.BorderBrush>
                                                            <SolidColorBrush Opacity="0.5" Color="{ThemeResource SystemAccentColor}" />
                                                        </Border.BorderBrush>
                                                        <TextBlock x:Uid="TxtMonoBadge"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource SystemAccentColor}" />
                                                    </Border>

                                                    <Grid Width="52"
                                                          Height="14"
                                                          Visibility="{x:Bind BalanceIndicatorVisibility, Mode=OneWay}">
                                                        <Border Width="52"
                                                                Height="3"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                CornerRadius="2" />
                                                        <Border Width="1"
                                                                Height="8"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Ellipse Width="10"
                                                                 Height="10"
                                                                 Margin="{x:Bind BalanceDotMargin, Mode=OneWay}"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </Grid>
                                                </Grid>
                                            </Grid>

                                            <Button Grid.Column="2"
                                                    Width="130"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="AppDeviceButton_Click"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{x:Bind SelectedDeviceName, Mode=OneWay}"
                                                    Visibility="{x:Bind DeviceButtonVisibility, Mode=OneWay}">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{x:Bind SelectedDeviceName, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>

                                            <TextBlock x:Uid="TxtRecording"
                                                       Grid.Column="2"
                                                       Width="130"
                                                       Padding="9,0,0,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind RecordingVisibility, Mode=OneWay}" />

                                            <Grid Grid.Column="3"
                                                  Width="120"
                                                  RowDefinitions="Auto,Auto"
                                                  RowSpacing="4">
                                                <Slider Grid.Row="0"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        Tag="{x:Bind}"
                                                        ValueChanged="AppVolumeSlider_ValueChanged"
                                                        Value="{x:Bind VolumePercent, Mode=OneWay}" />

                                                <ItemsControl Grid.Row="1"
                                                              HorizontalAlignment="Left"
                                                              ItemsSource="{x:Bind Segments, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:MeterSegment">
                                                            <Border Width="6"
                                                                    Height="4"
                                                                    Background="{x:Bind Color, Mode=OneWay}"
                                                                    CornerRadius="1"
                                                                    Opacity="{x:Bind Level, Mode=OneWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <TextBlock Grid.Column="4"
                                                       Width="40"
                                                       VerticalAlignment="Center"
                                                       Text="{x:Bind VolumeText, Mode=OneWay}"
                                                       TextAlignment="Right" />

                                            <Button Grid.Column="5"
                                                    Width="24"
                                                    Height="24"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Click="MuteToggle_Click"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind}">
                                                <FontIcon FontSize="14" Glyph="{x:Bind MuteGlyph, Mode=OneWay}" />
                                                <ToolTipService.ToolTip>
                                                    <TextBlock x:Uid="BtnMuteTooltip" />
                                                </ToolTipService.ToolTip>
                                            </Button>

                                            <Button Grid.Column="6"
                                                    Width="24"
                                                    Height="24"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Click="ExpandButton_Click"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind}">
                                                <FontIcon FontSize="14" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                                                <ToolTipService.ToolTip>
                                                    <TextBlock x:Uid="BtnMoreControlsTooltip" />
                                                </ToolTipService.ToolTip>
                                            </Button>

                                            <!-- Balance, mono and the reset button. -->
                                            <Grid Grid.Row="1"
                                                  Grid.ColumnSpan="7"
                                                  Margin="36,8,0,0"
                                                  ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="16"
                                                  Visibility="{x:Bind DetailsVisibility, Mode=OneWay}">
                                                <TextBlock x:Uid="TxtBalance"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center" />

                                                <Grid Grid.Column="1"
                                                      ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="6">
                                                    <TextBlock x:Uid="TxtBalanceLeft"
                                                               Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                    <!-- The WinUI slider draws its track above the middle, so it is pushed down to line up with the words beside it. -->
                                                    <Slider Grid.Column="1"
                                                            Margin="0,5,0,-5"
                                                            IsEnabled="{x:Bind BalanceSliderEnabled, Mode=OneWay}"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Tag="{x:Bind}"
                                                            TickFrequency="50"
                                                            ValueChanged="BalanceSlider_ValueChanged"
                                                            Value="{x:Bind BalanceValue, Mode=OneWay}" />

                                                    <TextBlock x:Uid="TxtBalanceRight"
                                                               Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="10">
                                                    <TextBlock x:Uid="TxtMono"
                                                               VerticalAlignment="Center" />

                                                    <ToggleSwitch IsOn="{x:Bind IsMono, Mode=OneWay}"
                                                                  OffContent=""
                                                                  OnContent=""
                                                                  Tag="{x:Bind}"
                                                                  Toggled="MonoToggle_Toggled"
                                                                  Translation="0,1,0" />

                                                    <Button Width="24"
                                                            Height="24"
                                                            MinWidth="0"
                                                            MinHeight="0"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Click="ResetButton_Click"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Tag="{x:Bind}">
                                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                                        <ToolTipService.ToolTip>
                                                            <TextBlock x:Uid="BtnResetAppTooltip" />
                                                        </ToolTipService.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="16,0,16,12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed" />
    </Grid>
</winuiex:WindowEx>
