<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)src\Common.Dotnet.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PowerToys.TryRun.Worker</AssemblyName>
    <RootNamespace>PowerToys.TryRun.Worker</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>$(RepoRoot)$(Platform)\$(Configuration)\TryRun\Worker\</OutputPath>
    <OutputPath Condition="'$(TryRunOutputRoot)' != ''">$(TryRunOutputRoot)\Worker\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TryRun.Core\TryRun.Core.csproj" />
    <ProjectReference Include="$(MxcRoot)\sdk\dotnet\Microsoft.Mxc.Sdk\Microsoft.Mxc.Sdk.csproj" Condition="'$(MxcRoot)' != ''" />
  </ItemGroup>
  <Target Name="ValidateMxcRoot" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'$(MxcRoot)' == '' or !Exists('$(MxcRoot)\sdk\dotnet\Microsoft.Mxc.Sdk\Microsoft.Mxc.Sdk.csproj')" Text="Set MxcRoot to the pinned MXC checkout. See src/modules/TryRun/README.md." />
    <ReadLinesFromFile File="..\mxc-version.txt">
      <Output TaskParameter="Lines" PropertyName="ExpectedMxcRevision" />
    </ReadLinesFromFile>
    <Exec Command="git -C &quot;$(MxcRoot)&quot; rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ActualMxcRevision" />
    </Exec>
    <Error Condition="'$(ActualMxcRevision)' != '$(ExpectedMxcRevision)'" Text="MXC must be at $(ExpectedMxcRevision). Build the managed SDK and native unit from that same checkout." />
  </Target>
  <Target Name="BuildMxcImageHelper" AfterTargets="Build" Condition="'$(MxcWithWslc)' == 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\build-wxc-helper.ps1&quot; -MxcRoot &quot;$(MxcRoot)&quot; -OutputDirectory &quot;$(OutDir).&quot; -Platform $(Platform) -Configuration $(Configuration)" />
  </Target>
</Project>
