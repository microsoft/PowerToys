<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)src\Common.Dotnet.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PowerToys.TryRun</AssemblyName>
    <RootNamespace>PowerToys.TryRun</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\runner\svgs\icon.ico</ApplicationIcon>
    <OutputPath>$(RepoRoot)$(Platform)\$(Configuration)\TryRun\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TryRun.Core\TryRun.Core.csproj" />
  </ItemGroup>
</Project>
