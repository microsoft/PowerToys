<Window
    x:Class="PowerToys.TryRun.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Try Run — PowerToys (Experimental)"
    Width="1080"
    Height="860"
    MinWidth="800"
    MinHeight="640"
    Closing="OnClosing"
    Loaded="OnLoaded"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Try changes on a copy" />
            <TextBlock
                Margin="0,8,0,0"
                Text="Experimental: MXC is not currently a security boundary."
                TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="1. Choose input files (optional)" />
                <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                    <Button
                        x:Name="AddFilesButton"
                        Padding="10,5"
                        Click="OnAddFiles"
                        Content="Add _files…" />
                    <Button
                        x:Name="AddFolderButton"
                        Margin="8,0,0,0"
                        Padding="10,5"
                        Click="OnAddFolder"
                        Content="Add fol_der…" />
                    <Button
                        x:Name="RemoveInputButton"
                        Margin="8,0,0,0"
                        Padding="10,5"
                        Click="OnRemoveInput"
                        Content="_Remove" />
                </WrapPanel>
                <ListBox
                    x:Name="InputList"
                    Grid.Row="2"
                    AutomationProperties.Name="Input files and folders"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    SelectionMode="Extended" />
                <TextBlock
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    FontSize="12"
                    Text="Copies keep their file or folder name. Up to 1,000 entries, 32 MiB per file, 100 MiB total. Links are rejected."
                    TextWrapping="Wrap" />
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label
                    Padding="0,0,0,8"
                    Content="2. Write a _script"
                    Target="{Binding ElementName=ScriptBox}" />
                <TextBox
                    x:Name="ScriptBox"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    AutomationProperties.Name="PowerShell script"
                    FontFamily="Cascadia Mono, Consolas"
                    MaxLength="8192"
                    Text="Get-ChildItem -Recurse"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    FontSize="12"
                    Text="Use relative paths, such as .\notes.txt. Each run starts with fresh copies. Export results before running again or closing."
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,12">
            <TextBlock Text="Write access: this run's temporary workspace. Network and clipboard: off." TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                Text="Windows: allowed for PowerShell compatibility. Input injection: off."
                TextWrapping="Wrap" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <Label Content="_Timeout (seconds)" Target="{Binding ElementName=TimeoutBox}" />
                <TextBox
                    x:Name="TimeoutBox"
                    Width="64"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="Timeout in seconds"
                    MaxLength="3"
                    Text="60" />
                <Button
                    x:Name="RunButton"
                    Margin="16,0,0,0"
                    Padding="16,6"
                    Click="OnRun"
                    Content="_Run"
                    IsEnabled="False" />
                <Button
                    x:Name="StopButton"
                    Margin="8,0,0,0"
                    Padding="16,6"
                    Click="OnStop"
                    Content="_Stop"
                    IsEnabled="False" />
            </StackPanel>
        </StackPanel>
        <TabControl x:Name="ResultsTabs" Grid.Row="3">
            <TabItem Header="_Output">
                <TextBox
                    x:Name="OutputBox"
                    Margin="8"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Run output"
                    FontFamily="Cascadia Mono, Consolas"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="3. Review file _changes">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button
                            x:Name="ReviewButton"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Click="OnRefreshReview"
                            Content="Refresh review"
                            DockPanel.Dock="Right"
                            IsEnabled="False" />
                        <Button
                            x:Name="ExportButton"
                            Margin="12,0,0,0"
                            Padding="12,5"
                            Click="OnExport"
                            Content="_Export checked files…"
                            DockPanel.Dock="Right"
                            IsEnabled="False" />
                        <Button
                            x:Name="OpenExportButton"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Click="OnOpenExport"
                            Content="Open export folder"
                            DockPanel.Dock="Right"
                            IsEnabled="False" />
                        <TextBlock
                            x:Name="ChangesSummary"
                            VerticalAlignment="Center"
                            Text="Run a script to review files. Originals are kept unchanged."
                            TextWrapping="Wrap" />
                    </DockPanel>
                    <DataGrid
                        x:Name="ChangesGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="File changes and export selection"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        EnableRowVirtualization="True"
                        HeadersVisibility="Column"
                        SelectionChanged="OnChangeSelected"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="76" Header="Export">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding RelativePath}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CanExport}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Kind}"
                                Header="Change"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding RelativePath}"
                                Header="File"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding BeforeSize}"
                                Header="Before (bytes)"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding AfterSize}"
                                Header="After (bytes)"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,8,0,4"
                        FontSize="12"
                        Text="Select a row to preview its contents. Deleted files have no export. Exports always use a new folder."
                        TextWrapping="Wrap" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Before — copied input" />
                            <TextBox
                                x:Name="BeforePreview"
                                Grid.Row="1"
                                AcceptsReturn="True"
                                AutomationProperties.Name="File contents before run"
                                FontFamily="Cascadia Mono, Consolas"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Grid>
                        <Grid Grid.Column="1" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="After — run result" />
                            <TextBox
                                x:Name="AfterPreview"
                                Grid.Row="1"
                                AcceptsReturn="True"
                                AutomationProperties.Name="File contents after run"
                                FontFamily="Cascadia Mono, Consolas"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Margin="0,12,0,0"
            AutomationProperties.LiveSetting="Polite"
            Text="Checking availability…"
            TextWrapping="Wrap" />
    </Grid>
</Window>
