<local:OverlayChildWindow
    x:Class="FancyZonesEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FancyZonesEditor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:FancyZonesEditor.Helpers"
    xmlns:local="using:FancyZonesEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FancyZonesEditor.Models"
    xmlns:utils="using:FancyZonesEditor.Utils"
    MinWidth="360"
    mc:Ignorable="d">

    <!--  WinUI's Window is not a DependencyObject: DataContext, Resources and automation properties all live on this root Grid.  -->
    <Grid
        x:Name="RootGrid"
        AutomationProperties.Name="{helpers:StringResource Key=Fancy_Zones_Main_Editor}"
        Background="{ThemeResource PrimaryBackgroundBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="MonitorItemTemplate" x:DataType="utils:MonitorInfoModel">
                <Border Width="{x:Bind DisplayWidth}" Height="{x:Bind DisplayHeight}">
                    <ToolTipService.ToolTip>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind AccessibleName}" />
                            <TextBlock Text="{x:Bind Dimensions}" />
                        </StackPanel>
                    </ToolTipService.ToolTip>
                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="{x:Bind Index}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind Dimensions}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind Scaling}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="LayoutItemTemplate" x:DataType="models:LayoutModel">
                <Grid Background="Transparent">
                    <!--  The WPF ContextMenu resource became a per-item ContextFlyout so each menu item inherits the layout as its DataContext.  -->
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="EditLayout_Click"
                                Text="{helpers:StringResource Key=Edit}"
                                Visibility="{x:Bind IsNotBlankLayout}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Click="EditZones_Click"
                                Text="{helpers:StringResource Key=Edit_zones}"
                                Visibility="{x:Bind IsCustom}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED35;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Click="DuplicateLayout_Click"
                                Text="{helpers:StringResource Key=Duplicate}"
                                Visibility="{x:Bind IsCustom}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Click="DuplicateLayout_Click"
                                Text="{helpers:StringResource Key=Create_Custom_From_Template}"
                                Visibility="{x:Bind CanCreateCustomFromTemplate}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator Visibility="{x:Bind IsNotBlankLayout}" />
                            <MenuFlyoutItem
                                Click="DeleteLayout_Click"
                                Text="{helpers:StringResource Key=Delete}"
                                Visibility="{x:Bind IsCustom}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Grid.ContextFlyout>

                    <Grid
                        Width="180"
                        Height="140"
                        Margin="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="124" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="0,0,24,0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                        <local:LayoutPreview
                            Grid.Row="1"
                            Margin="0,8,0,8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                    </Grid>

                    <Button
                        Grid.RowSpan="2"
                        Width="36"
                        Height="36"
                        Margin="4"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.HelpText="{helpers:StringResource Key=Edit}"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                        Click="EditLayout_Click"
                        CornerRadius="18"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{helpers:StringResource Key=Edit}"
                        Visibility="{x:Bind IsNotBlankLayout}">
                        <TextBlock
                            AutomationProperties.Name="{helpers:StringResource Key=Edit}"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Text="&#xE70F;" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Monitor picker strip  -->
        <Grid Background="{ThemeResource TertiaryBackgroundBrush}">
            <ScrollViewer
                x:Name="MonitorScrollViewer"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid>
                    <GridView
                        x:Name="Monitors"
                        HorizontalAlignment="Center"
                        ContainerContentChanging="Monitors_ContainerContentChanging"
                        IsItemClickEnabled="True"
                        ItemClick="Monitor_ItemClick"
                        ItemContainerStyle="{StaticResource MonitorItemContainerStyle}"
                        ItemTemplate="{StaticResource MonitorItemTemplate}"
                        SelectionMode="Single"
                        TabIndex="0" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--
            The "open settings" button was removed because Settings would launch under the
            FancyZones editor overlay - see https://github.com/microsoft/PowerToys/issues/19828
        -->

        <Grid Grid.Row="1" Background="{ThemeResource PrimaryBackgroundBrush}">
            <ScrollViewer>
                <Grid Margin="16,16,16,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="TemplatesHeaderBlock"
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{helpers:StringResource Key=Templates}" />

                    <GridView
                        x:Name="TemplatesGridView"
                        Grid.Row="1"
                        Margin="-8,8,-8,0"
                        ContainerContentChanging="Layouts_ContainerContentChanging"
                        DoubleTapped="LayoutItem_DoubleTapped"
                        IsItemClickEnabled="True"
                        ItemClick="Layout_ItemClick"
                        ItemContainerStyle="{StaticResource LayoutItemContainerStyle}"
                        ItemTemplate="{StaticResource LayoutItemTemplate}"
                        SelectionMode="Single"
                        TabIndex="1" />

                    <TextBlock
                        x:Name="CustomHeaderBlock"
                        Grid.Row="2"
                        Margin="0,16,0,0"
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{helpers:StringResource Key=Custom}" />

                    <StackPanel
                        x:Name="NoCustomLayoutsPanel"
                        Grid.Row="3"
                        Height="240"
                        Margin="16,48,16,16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.6"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <PathIcon
                            Height="38"
                            Data="M45,48H25.5V45H45V25.5H25.5v-3H45V3H25.5V0H48V48ZM22.5,48H3V45H22.5V3H3V0H25.5V48ZM0,48V0H3V48Z"
                            Foreground="{ThemeResource SecondaryForegroundBrush}" />
                        <TextBlock
                            Margin="0,16,0,0"
                            Foreground="{ThemeResource SecondaryForegroundBrush}"
                            Text="{helpers:StringResource Key=No_Custom_Layouts_Message}" />
                    </StackPanel>

                    <GridView
                        x:Name="CustomGridView"
                        Grid.Row="3"
                        Margin="-8,8,-8,0"
                        ContainerContentChanging="Layouts_ContainerContentChanging"
                        DoubleTapped="LayoutItem_DoubleTapped"
                        IsItemClickEnabled="True"
                        ItemClick="Layout_ItemClick"
                        ItemContainerStyle="{StaticResource LayoutItemContainerStyle}"
                        ItemTemplate="{StaticResource LayoutItemTemplate}"
                        SelectionMode="Single"
                        TabIndex="2" />
                </Grid>
            </ScrollViewer>

            <Button
                x:Name="NewLayoutButton"
                Height="36"
                Margin="16"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{helpers:StringResource Key=Create_new_layout}"
                Click="NewLayoutButton_Click"
                Style="{StaticResource AccentButtonStyle}"
                TabIndex="3">
                <StackPanel Margin="8" Orientation="Horizontal">
                    <TextBlock
                        AutomationProperties.Name="{helpers:StringResource Key=Create_new_layout}"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="&#xE710;" />
                    <TextBlock
                        Margin="12,-3,0,0"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{helpers:StringResource Key=Create_new_layout}" />
                </StackPanel>
            </Button>
        </Grid>

        <ContentDialog
            x:Name="EditLayoutDialog"
            MaxWidth="320"
            Background="{ThemeResource PrimaryBackgroundBrush}"
            Closed="Dialog_Closed"
            KeyDown="Dialog_KeyDown"
            Opened="Dialog_Opened"
            PrimaryButtonClick="EditLayoutDialog_PrimaryButtonClick"
            PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
            PrimaryButtonText="{helpers:StringResource Key=Save}"
            SecondaryButtonClick="EditLayoutDialog_SecondaryButtonClick"
            SecondaryButtonText="{helpers:StringResource Key=Cancel}">
            <ContentDialog.Resources>
                <Thickness x:Key="ContentDialogPadding">24,16,0,24</Thickness>
                <Thickness x:Key="ContentDialogCommandSpaceMargin">0,24,24,0</Thickness>
            </ContentDialog.Resources>
            <ContentDialog.Title>
                <TextBlock
                    x:Name="EditLayoutDialogTitle"
                    MaxWidth="320"
                    Margin="0,0,96,0"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource HeadingTextBlock}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </ContentDialog.Title>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid x:Name="EditLayoutDialogBody" Margin="4,4,24,32">
                    <StackPanel
                        Margin="0,-37,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <Button
                            x:Name="DuplicateLayoutButton"
                            AutomationProperties.Name="{helpers:StringResource Key=Duplicate}"
                            Click="DuplicateLayout_Click"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            ToolTipService.ToolTip="{helpers:StringResource Key=Duplicate}">
                            <TextBlock
                                AutomationProperties.Name="{helpers:StringResource Key=Duplicate}"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Text="&#xE8C8;" />
                        </Button>

                        <!--  Used by narrator for announcements  -->
                        <TextBlock x:Name="LayoutCreationAnnounce" />

                        <Button
                            x:Name="CreateFromTemplateLayoutButton"
                            AutomationProperties.Name="{helpers:StringResource Key=Create_Custom_From_Template}"
                            Click="DuplicateLayout_Click"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            ToolTipService.ToolTip="{helpers:StringResource Key=Create_Custom_From_Template}">
                            <TextBlock
                                AutomationProperties.Name="{helpers:StringResource Key=Create_Custom_From_Template}"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Text="&#xE8C8;" />
                        </Button>

                        <Button
                            x:Name="DeleteLayoutButton"
                            AutomationProperties.Name="{helpers:StringResource Key=Delete}"
                            Click="DeleteLayout_Click"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            ToolTipService.ToolTip="{helpers:StringResource Key=Delete}">
                            <TextBlock
                                AutomationProperties.Name="{helpers:StringResource Key=Delete}"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Foreground="#C42B1C"
                                Text="&#xE74D;" />
                        </Button>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel
                            x:Name="LayoutNamePanel"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,0,8"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="{helpers:StringResource Key=Name}"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Text="&#xE932;"
                                ToolTipService.ToolTip="{helpers:StringResource Key=Name}" />
                            <TextBox
                                x:Name="LayoutNameBox"
                                MinWidth="286"
                                MaxWidth="286"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{helpers:StringResource Key=Name}"
                                GotFocus="TextBox_GotFocus"
                                Header="{helpers:StringResource Key=Name}"
                                PlaceholderText="{helpers:StringResource Key=Name}"
                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  Shortcut panel  -->
                        <StackPanel
                            x:Name="QuickKeyPanel"
                            Margin="0,12,0,36"
                            Orientation="Vertical">
                            <StackPanel Margin="28,0,0,4" Orientation="Horizontal">
                                <TextBlock x:Name="QuickKeyTitle" Text="{helpers:StringResource Key=QuickKey_Title}" />
                                <TextBlock
                                    Margin="8,4,0,0"
                                    AutomationProperties.Name="{helpers:StringResource Key=QuickKey_Description}"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Text="&#xE946;"
                                    ToolTipService.ToolTip="{helpers:StringResource Key=QuickKey_Description}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{helpers:StringResource Key=QuickKey_Title}"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Text="&#xEDA7;"
                                    ToolTipService.ToolTip="{helpers:StringResource Key=QuickKey_Title}" />

                                <ComboBox
                                    x:Name="QuickKeySelectionComboBox"
                                    Width="286"
                                    Margin="12,0,0,0"
                                    AutomationProperties.HelpText="{helpers:StringResource Key=QuickKey_Description}"
                                    AutomationProperties.Name="{helpers:StringResource Key=QuickKey_Title}"
                                    ItemsSource="{Binding QuickKeysAvailable}"
                                    KeyDown="ComboBox_KeyDown"
                                    SelectedItem="{Binding QuickKey, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid
                            Width="218"
                            Height="124"
                            Margin="24,12,0,24"
                            HorizontalAlignment="Left">
                            <local:LayoutPreview />

                            <Button
                                x:Name="EditZoneLayoutButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{helpers:StringResource Key=Edit_zones}"
                                Click="EditZones_Click"
                                Content="&#xE70F;"
                                CornerRadius="18"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{helpers:StringResource Key=Edit_zones}" />
                        </Grid>

                        <StackPanel
                            x:Name="ZoneCountPanel"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,16,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{helpers:StringResource Key=Number_of_zones}"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Text="&#xECA5;"
                                ToolTipService.ToolTip="{helpers:StringResource Key=Number_of_zones}" />

                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    Margin="12,0,0,4"
                                    Text="{helpers:StringResource Key=Number_of_zones}"
                                    TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal">
                                    <controls:CustomSlider
                                        x:Name="TemplateZoneCount"
                                        MinWidth="216"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.HelpText="{helpers:StringResource Key=Number_of_zones}"
                                        LargeChange="10"
                                        Maximum="{Binding TemplateZoneCountMaximum}"
                                        Minimum="{Binding TemplateZoneCountMinimum}"
                                        SmallChange="1"
                                        ValueChanged="TemplateZoneCount_ValueChanged"
                                        Value="{Binding TemplateZoneCount, Mode=TwoWay}" />

                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource SecondaryForegroundBrush}"
                                        Text="{Binding TemplateZoneCount}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource SecondaryForegroundBrush}"
                                        Text="{helpers:StringResource Key=Zones}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SpacingPanel" Margin="0,12,0,0">
                            <TextBlock
                                Margin="28,0,0,4"
                                Text="{helpers:StringResource Key=Space_Around_Zones}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{helpers:StringResource Key=Space_Around_Zones}"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Text="&#xE91B;"
                                    ToolTipService.ToolTip="{helpers:StringResource Key=Space_Around_Zones}" />

                                <StackPanel Orientation="Horizontal">
                                    <controls:CustomSlider
                                        x:Name="Spacing"
                                        MinWidth="216"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.HelpText="{helpers:StringResource Key=Space_Around_Zones}"
                                        IsEnabled="{Binding ShowSpacing}"
                                        LargeChange="10"
                                        Maximum="{Binding SpacingMaximum}"
                                        Minimum="{Binding SpacingMinimum}"
                                        SmallChange="1"
                                        ValueChanged="Spacing_ValueChanged"
                                        Value="{Binding Spacing, Mode=TwoWay}" />

                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource SecondaryForegroundBrush}"
                                        Text="{Binding Spacing}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource SecondaryForegroundBrush}"
                                        Text="{helpers:StringResource Key=Pixels}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch
                                    x:Name="SpaceAroundSetting"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{helpers:StringResource Key=Show_Space_Zones}"
                                    IsOn="{Binding ShowSpacing, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="">
                                    <ToggleSwitch.Resources>
                                        <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
                                    </ToggleSwitch.Resources>
                                </ToggleSwitch>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock
                                Margin="28,0,0,4"
                                Text="{helpers:StringResource Key=Distance_adjacent_zones}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Text="&#xE78A;"
                                    ToolTipService.ToolTip="{helpers:StringResource Key=Distance_adjacent_zones}" />

                                <controls:CustomSlider
                                    x:Name="SensitivityInput"
                                    MinWidth="216"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.HelpText="{helpers:StringResource Key=Distance_adjacent_zones}"
                                    LargeChange="10"
                                    Maximum="{Binding SensitivityRadiusMaximum}"
                                    Minimum="{Binding SensitivityRadiusMinimum}"
                                    SmallChange="1"
                                    ValueChanged="SensitivityInput_ValueChanged"
                                    Value="{Binding SensitivityRadius, Mode=TwoWay}" />

                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource SecondaryForegroundBrush}"
                                    Text="{Binding SensitivityRadius}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource SecondaryForegroundBrush}"
                                    Text="{helpers:StringResource Key=Pixels}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Vertical">
                            <Button
                                x:Name="SetLayoutAsHorizontalDefaultButton"
                                AutomationProperties.Name="{helpers:StringResource Key=Set_Layout_As_Horizontal_Default}"
                                Click="SetLayoutAsHorizontalDefaultButton_Click"
                                Style="{StaticResource IconOnlyButtonStyle}"
                                ToolTipService.ToolTip="{helpers:StringResource Key=Set_Layout_As_Horizontal_Default}">
                                <TextBlock AutomationProperties.Name="{helpers:StringResource Key=Set_Layout_As_Horizontal_Default}" FontSize="16">
                                    <Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE734;" />
                                    <Run Text="{helpers:StringResource Key=Default_Layout_Horizontal}" />
                                </TextBlock>
                            </Button>
                            <Button
                                x:Name="HorizontalDefaultLayoutButton"
                                AutomationProperties.Name="{helpers:StringResource Key=Default_Layout_Horizontal}"
                                Click="HorizontalDefaultLayoutButton_Click"
                                Style="{StaticResource IconOnlyButtonStyle}"
                                ToolTipService.ToolTip="{helpers:StringResource Key=Default_Layout_Horizontal}">
                                <TextBlock AutomationProperties.Name="{helpers:StringResource Key=Default_Layout_Horizontal}" FontSize="16">
                                    <Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE735;" />
                                    <Run Text="{helpers:StringResource Key=Default_Layout_Horizontal}" />
                                </TextBlock>
                            </Button>

                            <Button
                                x:Name="SetLayoutAsVerticalDefaultButton"
                                AutomationProperties.Name="{helpers:StringResource Key=Set_Layout_As_Vertical_Default}"
                                Click="SetLayoutAsVerticalDefaultButton_Click"
                                Style="{StaticResource IconOnlyButtonStyle}"
                                ToolTipService.ToolTip="{helpers:StringResource Key=Set_Layout_As_Vertical_Default}">
                                <TextBlock AutomationProperties.Name="{helpers:StringResource Key=Set_Layout_As_Vertical_Default}" FontSize="16">
                                    <Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE734;" />
                                    <Run Text="{helpers:StringResource Key=Default_Layout_Vertical}" />
                                </TextBlock>
                            </Button>
                            <Button
                                x:Name="VerticalDefaultLayoutButton"
                                AutomationProperties.Name="{helpers:StringResource Key=Default_Layout_Vertical}"
                                Click="VerticalDefaultLayoutButton_Click"
                                Style="{StaticResource IconOnlyButtonStyle}"
                                ToolTipService.ToolTip="{helpers:StringResource Key=Default_Layout_Vertical}">
                                <TextBlock AutomationProperties.Name="{helpers:StringResource Key=Default_Layout_Vertical}" FontSize="16">
                                    <Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE735;" />
                                    <Run Text="{helpers:StringResource Key=Default_Layout_Vertical}" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog
            x:Name="NewLayoutDialog"
            Background="{ThemeResource PrimaryBackgroundBrush}"
            Closed="Dialog_Closed"
            KeyDown="Dialog_KeyDown"
            Opened="Dialog_Opened"
            PrimaryButtonClick="NewLayoutDialog_PrimaryButtonClick"
            PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
            PrimaryButtonText="{helpers:StringResource Key=Create}"
            SecondaryButtonText="{helpers:StringResource Key=Cancel}">
            <ContentDialog.Title>
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource HeadingTextBlock}"
                    Text="{helpers:StringResource Key=Choose_layout_type}" />
            </ContentDialog.Title>
            <StackPanel Margin="0,16,24,0">
                <TextBlock x:Name="NameHeaderText" Text="{helpers:StringResource Key=Name}" />
                <TextBox
                    x:Name="LayoutNameText"
                    Margin="3,6,3,0"
                    TextChanged="LayoutNameText_TextChanged" />
                <RadioButton
                    x:Name="GridLayoutRadioButton"
                    Margin="0,24,0,0"
                    AutomationProperties.HelpText="{helpers:StringResource Key=Layout_Grid_Description}"
                    AutomationProperties.Name="{helpers:StringResource Key=Layout_Grid_Title}"
                    GroupName="LayoutTypeGroup"
                    IsChecked="False"
                    Style="{StaticResource LayoutTypeRadioButtonStyle}">
                    <Grid Width="420" Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{helpers:StringResource Key=Layout_Grid_Title}"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Text="&#xF0E2;" />
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock
                                Margin="0,3,0,0"
                                FontWeight="Bold"
                                Text="{helpers:StringResource Key=Layout_Grid_Title}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="{helpers:StringResource Key=Layout_Grid_Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </RadioButton>

                <RadioButton
                    x:Name="CanvasLayoutRadioButton"
                    Margin="0,0,0,64"
                    AutomationProperties.HelpText="{helpers:StringResource Key=Layout_Canvas_Description}"
                    AutomationProperties.Name="{helpers:StringResource Key=Layout_Canvas_Title}"
                    GroupName="LayoutTypeGroup"
                    IsChecked="False"
                    Style="{StaticResource LayoutTypeRadioButtonStyle}">
                    <Grid Width="420" Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{helpers:StringResource Key=Layout_Canvas_Title}"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Text="&#xF5ED;" />
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock
                                Margin="0,3,0,0"
                                FontWeight="Bold"
                                Text="{helpers:StringResource Key=Layout_Canvas_Title}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="{helpers:StringResource Key=Layout_Canvas_Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </RadioButton>
            </StackPanel>
        </ContentDialog>
    </Grid>
</local:OverlayChildWindow>
