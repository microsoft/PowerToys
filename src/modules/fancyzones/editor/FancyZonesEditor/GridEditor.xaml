<UserControl
    x:Class="FancyZonesEditor.GridEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:FancyZonesEditor.Helpers"
    xmlns:local="using:FancyZonesEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Viewbox Stretch="Uniform">
        <Grid>
            <Canvas x:Name="Preview" />
            <Canvas x:Name="AdornerLayer" />
            <Canvas
                x:Name="MergePanel"
                PointerReleased="MergePanelPointerReleased"
                Visibility="Collapsed">
                <StackPanel x:Name="MergeButtons" Orientation="Horizontal">
                    <Border Background="{ThemeResource PrimaryBackgroundBrush}" CornerRadius="4">
                        <Button
                            Width="134"
                            Height="36"
                            Margin="0"
                            Click="MergeClick"
                            Style="{StaticResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,3,8,0"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource PrimaryForegroundBrush}"
                                    Text="&#xE746;" />
                                <TextBlock Foreground="{ThemeResource PrimaryForegroundBrush}" Text="{helpers:StringResource Key=Merge_zones}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
