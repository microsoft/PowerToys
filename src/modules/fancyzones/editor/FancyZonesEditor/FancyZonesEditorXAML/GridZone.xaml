<UserControl
    x:Class="FancyZonesEditor.GridZone"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FancyZonesEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    IsTabStop="True"
    mc:Ignorable="d">

    <!--
        WinUI's UserControl has no ControlTemplate, so it does not render Background or
        BorderBrush the way the WPF UserControl did - the chrome lives on this root Border.
    -->
    <Border
        x:Name="ZoneBorder"
        Background="{ThemeResource GridZoneBackgroundBrush}"
        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <Canvas x:Name="Body" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    x:Name="LabelID"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    x:FieldModifier="public"
                    FontSize="68"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PrimaryForegroundBrush}"
                    Text="ID" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SecondaryForegroundBrush}">
                    <Run x:Name="WidthLabel" />
                    <Run Text="×" />
                    <Run x:Name="HeightLabel" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
