<UserControl
    x:Class="FancyZonesEditor.GridResizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FancyZonesEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="48"
    Height="48"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    mc:Ignorable="d">

    <!--
        WinUI's Thumb is sealed, so the resizer is a UserControl that hosts one and
        re-exposes its drag events. The rotation for horizontal resizers is applied to
        this Grid, and the focus ring replaces the keyboard-focus colour change the WPF
        ControlTemplate trigger used to make.
    -->
    <Grid x:Name="Body">
        <Border
            x:Name="FocusRing"
            Width="54"
            Height="54"
            BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
            BorderThickness="3"
            CornerRadius="27"
            Opacity="0" />
        <Thumb x:Name="ResizerThumb" Style="{StaticResource GridResizerThumbStyle}" />
    </Grid>
</UserControl>
