<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds the Rust implementation of PowerToys Awake with Cargo and places PowerToys.Awake.exe (and
  its PDB) next to the other PowerToys binaries. The Test target runs the Rust tests.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Globals">
    <VCProjectVersion>15.0</VCProjectVersion>
    <ProjectGuid>{66dd9426-f301-46aa-a271-cd75c6ed3af4}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>Awake</RootNamespace>
    <ProjectName>Awake</ProjectName>
    <TargetName>PowerToys.Awake</TargetName>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(RepoRoot)$(Platform)\$(Configuration)\</OutDir>
    <CargoTriple Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</CargoTriple>
    <CargoTriple Condition="'$(CargoTriple)' == ''">x86_64-pc-windows-msvc</CargoTriple>
    <CargoProfile Condition="'$(Configuration)' == 'Release'">release</CargoProfile>
    <CargoProfile Condition="'$(CargoProfile)' == ''">dev</CargoProfile>
    <CargoProfileDir Condition="'$(CargoProfile)' == 'release'">release</CargoProfileDir>
    <CargoProfileDir Condition="'$(CargoProfileDir)' == ''">debug</CargoProfileDir>
    <!-- Cargo's intermediate files stay with the other build outputs, outside the source tree. -->
    <CargoTargetDir>$(RepoRoot)$(Platform)\$(Configuration)\obj\Awake</CargoTargetDir>
    <CargoOutputDir>$(CargoTargetDir)\$(CargoTriple)\$(CargoProfileDir)\</CargoOutputDir>
    <CargoCommonArgs>--locked --target $(CargoTriple)</CargoCommonArgs>
    <!-- One-line diagnostics that the Exec patterns below turn into MSBuild errors and warnings,
         so they reach the Error List and the pipeline summary instead of only the log. -->
    <CargoDiagnosticArgs>--message-format=short</CargoDiagnosticArgs>
    <CargoErrorPattern>^(.+:\d+:\d+: )?error(\[\w+\])?: </CargoErrorPattern>
    <CargoWarningPattern>^(.+:\d+:\d+: )?warning(\[\w+\])?: </CargoWarningPattern>
    <!-- rc.exe from the Windows SDK this build selected, not whichever SDK is newest. -->
    <CargoEnvironment>POWERTOYS_VERSION=$(Version);WindowsSdkVerBinPath=$(WindowsSdkDir)bin\$(TargetPlatformVersion)\</CargoEnvironment>
  </PropertyGroup>
  <!-- Shown in Solution Explorer only; Cargo decides what is built. The patterns stay inside the
       source folders so they never walk a target directory. -->
  <ItemGroup>
    <None Include="Cargo.toml;Cargo.lock;rust-toolchain.toml;rustfmt.toml;.cargo\config.toml;Resources.resx" />
    <None Include="awake\Cargo.toml;awake\build.rs;awake\src\**\*.rs;awake\tests\**\*.rs;awake\examples\**\*.rs" />
    <None Include="awake\native\*.cpp;awake\native\*.manifest;awake\assets\*.ico" />
    <None Include="awake-core\Cargo.toml;awake-core\build.rs;awake-core\build\**\*.rs;awake-core\src\**\*.rs" />
    <None Include="tools\*.ps1" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CargoBuild" AfterTargets="Build">
    <Exec Command="cargo build $(CargoCommonArgs) $(CargoDiagnosticArgs) --target-dir &quot;$(CargoTargetDir)&quot; --profile $(CargoProfile) -p awake" WorkingDirectory="$(MSBuildThisFileDirectory)" EnvironmentVariables="$(CargoEnvironment)" CustomErrorRegularExpression="$(CargoErrorPattern)" CustomWarningRegularExpression="$(CargoWarningPattern)" />
    <Copy SourceFiles="$(CargoOutputDir)awake.exe" DestinationFiles="$(OutDir)PowerToys.Awake.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(CargoOutputDir)awake.pdb" DestinationFiles="$(OutDir)PowerToys.Awake.pdb" SkipUnchangedFiles="true" Condition="Exists('$(CargoOutputDir)awake.pdb')" />
  </Target>
  <!-- There are no ARM64 test agents, matching the other test projects. Tests build with the
       test hooks into their own folder, so they never replace the binary that ships. -->
  <Target Name="Test" Condition="'$(Platform)' != 'ARM64' and '$(BuildTests)' != 'false' and '$(BuildTests)' != 'False'">
    <Exec Command="cargo fmt --all --check" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Exec Command="cargo lint $(CargoCommonArgs) $(CargoDiagnosticArgs) --target-dir &quot;$(CargoTargetDir)-test&quot; --profile $(CargoProfile) -- -D warnings" WorkingDirectory="$(MSBuildThisFileDirectory)" EnvironmentVariables="$(CargoEnvironment)" CustomErrorRegularExpression="$(CargoErrorPattern)" CustomWarningRegularExpression="$(CargoWarningPattern)" />
    <Exec Command="cargo test-all $(CargoCommonArgs) $(CargoDiagnosticArgs) --target-dir &quot;$(CargoTargetDir)-test&quot; --profile $(CargoProfile)" WorkingDirectory="$(MSBuildThisFileDirectory)" EnvironmentVariables="$(CargoEnvironment)" CustomErrorRegularExpression="$(CargoErrorPattern)" CustomWarningRegularExpression="$(CargoWarningPattern)" />
  </Target>
  <Target Name="CargoClean" AfterTargets="Clean">
    <RemoveDir Directories="$(CargoTargetDir);$(CargoTargetDir)-test" />
    <Delete Files="$(OutDir)PowerToys.Awake.exe;$(OutDir)PowerToys.Awake.pdb" />
  </Target>
</Project>