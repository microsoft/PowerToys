<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds the Rust implementation of PowerToys Awake with Cargo and places PowerToys.Awake.exe (and
  its PDB) next to the other PowerToys binaries. The Test target runs the Rust tests.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Globals">
    <VCProjectVersion>15.0</VCProjectVersion>
    <ProjectGuid>{66dd9426-f301-46aa-a271-cd75c6ed3af4}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>Awake</RootNamespace>
    <ProjectName>Awake</ProjectName>
    <TargetName>PowerToys.Awake</TargetName>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(RepoRoot)$(Platform)\$(Configuration)\</OutDir>
    <CargoTriple Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</CargoTriple>
    <CargoTriple Condition="'$(CargoTriple)' == ''">x86_64-pc-windows-msvc</CargoTriple>
    <CargoProfile Condition="'$(Configuration)' == 'Release'">release</CargoProfile>
    <CargoProfile Condition="'$(CargoProfile)' == ''">dev</CargoProfile>
    <CargoProfileDir Condition="'$(CargoProfile)' == 'release'">release</CargoProfileDir>
    <CargoProfileDir Condition="'$(CargoProfileDir)' == ''">debug</CargoProfileDir>
    <!-- Cargo's intermediate files go in the git-ignored target folder next to this project, not
         under $(OutDir): the pipeline publishes, signs and indexes for symbols everything under
         $(OutDir), and only the two files copied there below ship. -->
    <CargoTargetDir>$(MSBuildThisFileDirectory)target\$(Platform)\$(Configuration)</CargoTargetDir>
    <!-- Tests build with the test hooks into their own folder, so they never replace the binary
         that ships. -->
    <CargoTestTargetDir>$(CargoTargetDir)-test</CargoTestTargetDir>
    <CargoOutputDir>$(CargoTargetDir)\$(CargoTriple)\$(CargoProfileDir)\</CargoOutputDir>
    <CargoCommonArgs>--locked --target $(CargoTriple)</CargoCommonArgs>
    <!-- One-line diagnostics that the Exec patterns below turn into MSBuild errors and warnings,
         so they reach the Error List and the pipeline summary instead of only the log. -->
    <CargoDiagnosticArgs>--message-format=short</CargoDiagnosticArgs>
    <CargoErrorPattern>^(.+:\d+:\d+: )?error(\[\w+\])?: </CargoErrorPattern>
    <CargoWarningPattern>^(.+:\d+:\d+: )?warning(\[\w+\])?: </CargoWarningPattern>
    <!-- Inside the repository checkout, where CI's PublishTestResults@2 collects every **/*.trx. -->
    <CargoTestResults>$(CargoTestTargetDir)\awake.trx</CargoTestResults>
    <!-- rc.exe from the Windows SDK this build selected, not whichever SDK is newest. -->
    <CargoEnvironment>POWERTOYS_VERSION=$(Version);WindowsSdkVerBinPath=$(WindowsSdkDir)bin\$(TargetPlatformVersion)\</CargoEnvironment>
  </PropertyGroup>
  <!-- Shown in Solution Explorer only; Cargo decides what is built. The patterns stay inside the
       source folders so they never walk a target directory. -->
  <ItemGroup>
    <None Include="Cargo.toml;Cargo.lock;rust-toolchain.toml;rustfmt.toml;.cargo\config.toml;Resources.resx" />
    <None Include="awake\Cargo.toml;awake\build.rs;awake\src\**\*.rs;awake\tests\**\*.rs;awake\examples\**\*.rs" />
    <None Include="awake\native\*.cpp;awake\native\*.manifest;awake\assets\*.ico" />
    <None Include="awake-core\Cargo.toml;awake-core\build.rs;awake-core\build\**\*.rs;awake-core\src\**\*.rs" />
    <None Include="tools\*.ps1" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Without a Rust toolchain the first cargo call fails with MSB3073 around "'cargo' is not
       recognized", which does not say what to install. 9009 is cmd's exit code for an unknown
       command; any other failure is the toolchain's own, explained in the output above it. -->
  <Target Name="CargoCheckToolchain">
    <Exec Command="cargo --version" WorkingDirectory="$(MSBuildThisFileDirectory)" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="CargoVersionExitCode" />
    </Exec>
    <Error Condition="'$(CargoVersionExitCode)' == '9009'" Text="Awake needs the Rust toolchain: install rustup (https://rustup.rs) and rerun the build. See src/modules/awake/README.md." />
    <Error Condition="'$(CargoVersionExitCode)' != '0' and '$(CargoVersionExitCode)' != '9009'" Text="cargo --version failed with exit code $(CargoVersionExitCode), so Awake's Rust toolchain is not usable; the output above says why." />
  </Target>
  <Target Name="CargoBuild" AfterTargets="Build" DependsOnTargets="CargoCheckToolchain">
    <Exec Command="cargo build $(CargoCommonArgs) $(CargoDiagnosticArgs) --target-dir &quot;$(CargoTargetDir)&quot; --profile $(CargoProfile) -p awake" WorkingDirectory="$(MSBuildThisFileDirectory)" EnvironmentVariables="$(CargoEnvironment)" CustomErrorRegularExpression="$(CargoErrorPattern)" CustomWarningRegularExpression="$(CargoWarningPattern)" />
    <Copy SourceFiles="$(CargoOutputDir)awake.exe" DestinationFiles="$(OutDir)PowerToys.Awake.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(CargoOutputDir)awake.pdb" DestinationFiles="$(OutDir)PowerToys.Awake.pdb" SkipUnchangedFiles="true" Condition="Exists('$(CargoOutputDir)awake.pdb')" />
  </Target>
  <!-- There are no ARM64 test agents, matching the other test projects. -->
  <Target Name="Test" DependsOnTargets="CargoCheckToolchain" Condition="'$(Platform)' != 'ARM64' and '$(BuildTests)' != 'false' and '$(BuildTests)' != 'False'">
    <Exec Command="cargo fmt --all --check" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Exec Command="cargo lint $(CargoCommonArgs) $(CargoDiagnosticArgs) --target-dir &quot;$(CargoTestTargetDir)&quot; --profile $(CargoProfile) -- -D warnings" WorkingDirectory="$(MSBuildThisFileDirectory)" EnvironmentVariables="$(CargoEnvironment)" CustomErrorRegularExpression="$(CargoErrorPattern)" CustomWarningRegularExpression="$(CargoWarningPattern)" />
    <Delete Files="$(CargoTestResults)" />
    <!-- ErrorAndContinue still fails the build when a test fails, but lets the results file below
         be written first, so the pipeline shows which test failed. -->
    <Exec Command="cargo test-all $(CargoCommonArgs) $(CargoDiagnosticArgs) --target-dir &quot;$(CargoTestTargetDir)&quot; --profile $(CargoProfile)" WorkingDirectory="$(MSBuildThisFileDirectory)" EnvironmentVariables="$(CargoEnvironment)" CustomErrorRegularExpression="$(CargoErrorPattern)" CustomWarningRegularExpression="$(CargoWarningPattern)" ConsoleToMSBuild="true" ContinueOnError="ErrorAndContinue">
      <Output TaskParameter="ConsoleOutput" ItemName="CargoTestOutput" />
    </Exec>
    <WriteCargoTestResults Lines="@(CargoTestOutput)" OutputFile="$(CargoTestResults)" />
  </Target>
  <!-- Turns libtest's "test NAME ... ok|FAILED|ignored" lines into a minimal TRX file, so the
       pipeline's existing PublishTestResults@2 step (**/*.trx) lists every Rust test by name.
       Stable libtest has no machine-readable output, and the pipeline cannot install tools. -->
  <UsingTask TaskName="WriteCargoTestResults" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Lines ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        XNamespace ns = "http://microsoft.com/schemas/VisualStudio/TeamTest/2010";
        const string unitTestType = "13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b";
        const string allResultsList = "19431567-8539-422a-85d7-44ee4e166bda";
        var testLine = new Regex(@"^test (\S+) \.\.\. (ok|FAILED|ignored)\b");
        var runningLine = new Regex(@"^\s*Running (?:unittests )?(\S+)");
        var docTestsLine = new Regex(@"^\s*Doc-tests (\S+)");
        var captureLine = new Regex(@"^---- (\S+) std(?:out|err) ----$");
        var lines = (Lines ?? new ITaskItem[0]).Select(l => l.ItemSpec).ToList();

        // What libtest prints for each failed test, by test name.
        var failures = new Dictionary<string, List<string>>();
        List<string> capture = null;
        foreach (var line in lines)
        {
            var m = captureLine.Match(line);
            if (m.Success)
            {
                if (!failures.TryGetValue(m.Groups[1].Value, out capture))
                {
                    capture = new List<string>();
                    failures[m.Groups[1].Value] = capture;
                }
            }
            else if (line == "failures:" || line.StartsWith("test result: ", StringComparison.Ordinal))
            {
                capture = null;
            }
            else if (capture != null)
            {
                capture.Add(line);
            }
        }

        var results = new XElement(ns + "Results");
        var definitions = new XElement(ns + "TestDefinitions");
        var entries = new XElement(ns + "TestEntries");
        int passed = 0, failed = 0, skipped = 0;
        string binary = "awake";
        foreach (var line in lines)
        {
            // "Running unittests src\main.rs (...)", "Running tests\process.rs (...)", "Doc-tests awake_core".
            var running = runningLine.Match(line);
            if (running.Success)
            {
                binary = running.Groups[1].Value.Replace('\\', '/');
                continue;
            }
            var doc = docTestsLine.Match(line);
            if (doc.Success)
            {
                binary = doc.Groups[1].Value + " (doc)";
                continue;
            }
            var m = testLine.Match(line);
            if (!m.Success)
            {
                continue;
            }
            string name = m.Groups[1].Value;
            string outcome = m.Groups[2].Value == "ok" ? "Passed" : m.Groups[2].Value == "FAILED" ? "Failed" : "NotExecuted";
            if (outcome == "Passed") { passed++; } else if (outcome == "Failed") { failed++; } else { skipped++; }
            string testId = Guid.NewGuid().ToString();
            string executionId = Guid.NewGuid().ToString();
            var result = new XElement(ns + "UnitTestResult",
                new XAttribute("executionId", executionId),
                new XAttribute("testId", testId),
                new XAttribute("testName", name),
                new XAttribute("computerName", Environment.MachineName),
                new XAttribute("duration", "00:00:00"),
                new XAttribute("outcome", outcome),
                new XAttribute("testType", unitTestType),
                new XAttribute("testListId", allResultsList));
            List<string> output;
            if (outcome == "Failed" && failures.TryGetValue(name, out output))
            {
                result.Add(new XElement(ns + "Output",
                    new XElement(ns + "ErrorInfo",
                        new XElement(ns + "Message", string.Join(Environment.NewLine, output).Trim()))));
            }
            results.Add(result);
            int split = name.LastIndexOf("::", StringComparison.Ordinal);
            definitions.Add(new XElement(ns + "UnitTest",
                new XAttribute("name", name),
                new XAttribute("storage", binary),
                new XAttribute("id", testId),
                new XElement(ns + "Execution", new XAttribute("id", executionId)),
                new XElement(ns + "TestMethod",
                    new XAttribute("codeBase", binary),
                    new XAttribute("adapterTypeName", "executor://cargo-test"),
                    new XAttribute("className", split < 0 ? binary : binary + "::" + name.Substring(0, split)),
                    new XAttribute("name", split < 0 ? name : name.Substring(split + 2)))));
            entries.Add(new XElement(ns + "TestEntry",
                new XAttribute("testId", testId),
                new XAttribute("executionId", executionId),
                new XAttribute("testListId", allResultsList)));
        }

        var run = new XElement(ns + "TestRun",
            new XAttribute("id", Guid.NewGuid().ToString()),
            new XAttribute("name", "Awake (cargo test)"),
            results,
            definitions,
            entries,
            new XElement(ns + "TestLists",
                new XElement(ns + "TestList", new XAttribute("name", "All Loaded Results"), new XAttribute("id", allResultsList))),
            new XElement(ns + "ResultSummary",
                new XAttribute("outcome", failed > 0 ? "Failed" : "Completed"),
                new XElement(ns + "Counters",
                    new XAttribute("total", passed + failed + skipped),
                    new XAttribute("executed", passed + failed),
                    new XAttribute("passed", passed),
                    new XAttribute("failed", failed),
                    new XAttribute("notExecuted", skipped))));
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        new XDocument(new XDeclaration("1.0", "utf-8", null), run).Save(OutputFile);
        Log.LogMessage(MessageImportance.High, "Awake test results: {0} passed, {1} failed, {2} ignored in {3}", passed, failed, skipped, OutputFile);
]]></Code>
    </Task>
  </UsingTask>
  <Target Name="CargoClean" AfterTargets="Clean">
    <RemoveDir Directories="$(CargoTargetDir);$(CargoTestTargetDir)" />
    <Delete Files="$(OutDir)PowerToys.Awake.exe;$(OutDir)PowerToys.Awake.pdb" />
  </Target>
</Project>