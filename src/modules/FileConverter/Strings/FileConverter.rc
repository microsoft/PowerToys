#include <windows.h>
#include "FileConverterResourceIds.h"
#include "../../../common/version/version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FILE_VERSION
 PRODUCTVERSION PRODUCT_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", COMPANY_NAME
            VALUE "FileDescription", "PowerToys File Converter"
            VALUE "FileVersion", FILE_VERSION_STRING
            VALUE "LegalCopyright", COPYRIGHT_NOTE
            VALUE "ProductName", PRODUCT_NAME
            VALUE "ProductVersion", PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_FILECONVERTER_APP_NAME L"File Converter"
    IDS_FILECONVERTER_SETTINGS_DESCRIPTION L"Convert image files to common formats."
    IDS_FILECONVERTER_CONTEXTMENU_ENTRY L"Convert to..."
    IDS_FILECONVERTER_CONTEXTMENU_FORMAT_PNG L"PNG"
    IDS_FILECONVERTER_CONTEXTMENU_FORMAT_JPG L"JPG"
    IDS_FILECONVERTER_CONTEXTMENU_FORMAT_JPEG L"JPEG"
    IDS_FILECONVERTER_CONTEXTMENU_FORMAT_BMP L"BMP"
    IDS_FILECONVERTER_CONTEXTMENU_FORMAT_TIFF L"TIFF"
    IDS_FILECONVERTER_CONTEXTMENU_FORMAT_HEIC L"HEIC"
    IDS_FILECONVERTER_CONTEXTMENU_FORMAT_HEIF L"HEIF"
    IDS_FILECONVERTER_CONTEXTMENU_FORMAT_WEBP L"WebP"
    IDS_FILECONVERTER_ERROR_EMPTYPAYLOAD L"empty payload"
    IDS_FILECONVERTER_ERROR_INVALIDJSON L"invalid JSON"
    IDS_FILECONVERTER_ERROR_MISSINGACTION L"missing action"
    IDS_FILECONVERTER_ERROR_ACTIONNOTSTRING L"action is not a string"
    IDS_FILECONVERTER_ERROR_UNSUPPORTEDACTION L"unsupported action"
    IDS_FILECONVERTER_ERROR_MISSINGFILESARRAY L"missing files array"
    IDS_FILECONVERTER_ERROR_FILESNOTARRAY L"files is not an array"
    IDS_FILECONVERTER_ERROR_NOVALIDPATHS L"no valid file paths"
    IDS_FILECONVERTER_ERROR_UNSUPPORTEDDESTINATION L"unsupported destination format"
    IDS_FILECONVERTER_ERROR_DESTINATIONUNAVAILABLE L"requested destination format is unavailable"
    IDS_FILECONVERTER_ENGINE_WICFACTORYNULL L"WIC factory is null."
    IDS_FILECONVERTER_ENGINE_NOENCODERINSTALLED L"No WIC encoder is installed for destination format '"
    IDS_FILECONVERTER_ENGINE_COINITIALIZEFAILED L"CoInitializeEx failed."
    IDS_FILECONVERTER_ENGINE_CREATEWICFACTORYFAILED L"Failed creating WIC factory."
    IDS_FILECONVERTER_ENGINE_INPUTUNSUPPORTED L"Input image format is not supported by installed WIC decoders."
    IDS_FILECONVERTER_ENGINE_OPENINPUTFAILED L"Failed opening input image."
    IDS_FILECONVERTER_ENGINE_READFIRSTFRAMEFAILED L"Failed reading first image frame."
    IDS_FILECONVERTER_ENGINE_READIMAGESIZEFAILED L"Failed reading image size."
    IDS_FILECONVERTER_ENGINE_READPIXELFORMATFAILED L"Failed reading source pixel format."
    IDS_FILECONVERTER_ENGINE_CREATESTREAMFAILED L"Failed creating WIC stream."
    IDS_FILECONVERTER_ENGINE_OPENOUTPUTFAILED L"Failed opening output path."
    IDS_FILECONVERTER_ENGINE_CREATEENCODERFAILED L"Failed creating image encoder."
    IDS_FILECONVERTER_ENGINE_INITENCODERFAILED L"Failed initializing encoder."
    IDS_FILECONVERTER_ENGINE_CREATETARGETFRAMEFAILED L"Failed creating target frame."
    IDS_FILECONVERTER_ENGINE_INITTARGETFRAMEFAILED L"Failed initializing target frame."
    IDS_FILECONVERTER_ENGINE_SETTARGETSIZEFAILED L"Failed setting target size."
    IDS_FILECONVERTER_ENGINE_SETTARGETPIXELFORMATFAILED L"Failed setting target pixel format."
    IDS_FILECONVERTER_ENGINE_CREATEFORMATCONVERTERFAILED L"Failed creating format converter."
    IDS_FILECONVERTER_ENGINE_UNSUPPORTEDPIXELCONVERSION L"Source pixel format cannot be converted to target pixel format."
    IDS_FILECONVERTER_ENGINE_INITFORMATCONVERTERFAILED L"Failed initializing format converter."
    IDS_FILECONVERTER_ENGINE_WRITETARGETFRAMEFAILED L"Failed writing target frame."
    IDS_FILECONVERTER_ENGINE_COMMITTARGETFRAMEFAILED L"Failed committing target frame."
    IDS_FILECONVERTER_ENGINE_COMMITENCODERFAILED L"Failed committing encoder."
    IDS_FILECONVERTER_ENGINE_PUBLISHOUTPUTFAILED L"Failed publishing converted image."
END
