#include <windows.h>
#include <common/version/version.h>
#include <modules/Workspaces/WorkspacesCLI/Generated Files/resource.h>
STRINGTABLE
BEGIN
    IDS_CLIARRANGEMENTUNCONFIRMED "Localized unconfirmed arrangement test message."
END
VS_VERSION_INFO VERSIONINFO
 FILEVERSION FILE_VERSION
 PRODUCTVERSION PRODUCT_VERSION
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Workspaces CLI runtime fixture"
            VALUE "FileVersion", FILE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
