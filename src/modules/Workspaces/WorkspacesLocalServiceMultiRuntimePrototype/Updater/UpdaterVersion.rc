#include <windows.h>

#ifndef PT_UPDATER_VERSION_MAJOR
#define PT_UPDATER_VERSION_MAJOR 5
#endif

#define PT_STRINGIZE_DETAIL(value) #value
#define PT_STRINGIZE(value) PT_STRINGIZE_DETAIL(value)
#define PT_UPDATER_VERSION_STRING PT_STRINGIZE(PT_UPDATER_VERSION_MAJOR) ".0.0.0\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PT_UPDATER_VERSION_MAJOR,0,0,0
 PRODUCTVERSION PT_UPDATER_VERSION_MAJOR,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Microsoft Corporation\0"
            VALUE "FileDescription", "PowerToys packaged-payload runtime updater prototype\0"
            VALUE "FileVersion", PT_UPDATER_VERSION_STRING
            VALUE "InternalName", "PtPuvrUpdater.exe\0"
            VALUE "OriginalFilename", "PtPuvrUpdater.exe\0"
            VALUE "ProductName", "PowerToys Workspaces runtime updater prototype\0"
            VALUE "ProductVersion", PT_UPDATER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
