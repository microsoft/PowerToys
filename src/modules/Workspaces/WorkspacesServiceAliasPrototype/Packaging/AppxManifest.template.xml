<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">
  <Identity
    Name="Microsoft.PowerToys.PtAliasProto"
    Publisher="CN=PowerToys PtAliasProto Test"
    Version="@@VERSION@@"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>PowerToys Alias Prototype Worker</DisplayName>
    <PublisherDisplayName>PowerToys prototype (test only)</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application
      Id="Worker"
      Executable="PtAliasProtoWorker.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:SupportsMultipleInstances="true">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="PowerToys Alias Prototype Worker"
        Description="Test-only packaged worker for the Workspaces service alias prototype"
        BackgroundColor="transparent"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" />
      <Extensions>
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="PtAliasProtoWorker.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="PtAliasProtoWorker.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
