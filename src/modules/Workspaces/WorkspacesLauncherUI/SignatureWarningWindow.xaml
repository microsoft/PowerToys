<Window
    x:Class="WorkspacesLauncherUI.SignatureWarningWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="600"
    MaxHeight="700"
    AutomationProperties.AutomationId="WorkspacesElevationWarning"
    AutomationProperties.HelpText="{Binding Explanation}"
    AutomationProperties.Name="{Binding Title}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="WrappedButtonText">
            <TextBlock
                Text="{Binding}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    AutomationProperties.HeadingLevel="Level1"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    Text="{Binding Explanation}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    Text="{Binding TrustLimits}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    AutomationProperties.AutomationId="SignatureWarningEscapedDisplay"
                    Text="{Binding EscapedDisplayExplanation}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasEscapedDisplayValues, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    x:Name="AppNameLabel"
                    FontWeight="SemiBold"
                    Text="{Binding AppLabel}" />
                <TextBlock
                    Margin="0,4,0,12"
                    AutomationProperties.AutomationId="SignatureWarningApp"
                    AutomationProperties.LabeledBy="{Binding ElementName=AppNameLabel}"
                    AutomationProperties.Name="{Binding DisplayAppName}"
                    Text="{Binding DisplayAppName, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="LocationLabel"
                    FontWeight="SemiBold"
                    Text="{Binding PathLabel}" />
                <TextBlock
                    Margin="0,4,0,12"
                    AutomationProperties.AutomationId="SignatureWarningPath"
                    AutomationProperties.LabeledBy="{Binding ElementName=LocationLabel}"
                    AutomationProperties.Name="{Binding DisplayPath}"
                    FlowDirection="LeftToRight"
                    Text="{Binding DisplayPath, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock FontWeight="SemiBold" Text="{Binding ReasonLabel}" />
                <TextBlock
                    Margin="0,4,0,16"
                    AutomationProperties.AutomationId="SignatureWarningReason"
                    AutomationProperties.Name="{Binding ReasonText}"
                    Text="{Binding ReasonText}"
                    TextWrapping="Wrap" />
                <Expander AutomationProperties.AutomationId="SignatureWarningDetails" Header="{Binding DetailsLabel}">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock
                            x:Name="CommandLineLabel"
                            FontWeight="SemiBold"
                            Text="{Binding ArgumentsLabel}" />
                        <TextBlock
                            Margin="0,4,0,12"
                            AutomationProperties.AutomationId="SignatureWarningArguments"
                            AutomationProperties.LabeledBy="{Binding ElementName=CommandLineLabel}"
                            AutomationProperties.Name="{Binding DisplayArguments}"
                            FlowDirection="LeftToRight"
                            Text="{Binding DisplayArguments, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="VerificationStatusLabel"
                            FontWeight="SemiBold"
                            Text="{Binding StatusLabel}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            AutomationProperties.AutomationId="SignatureWarningStatus"
                            AutomationProperties.LabeledBy="{Binding ElementName=VerificationStatusLabel}"
                            AutomationProperties.Name="{Binding DisplayStatus}"
                            FlowDirection="LeftToRight"
                            Text="{Binding DisplayStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,12,0,0"
                            Padding="12,6"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="CopySignatureDetails"
                            AutomationProperties.Name="{Binding CopyDetailsButtonText}"
                            Click="CopyDetails_Click"
                            Content="{Binding CopyDetailsButtonText}"
                            ContentTemplate="{StaticResource WrappedButtonText}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Grid
            x:Name="WarningActions"
            Grid.Row="1"
            Margin="0,24,0,0"
            HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SkipButton"
                MinWidth="120"
                Margin="0,0,12,0"
                Padding="12,6"
                AutomationProperties.AutomationId="SkipSignatureWarning"
                AutomationProperties.HelpText="{Binding SkipHelp}"
                AutomationProperties.Name="{Binding SkipText}"
                Content="{Binding SkipText}"
                ContentTemplate="{StaticResource WrappedButtonText}"
                IsCancel="True"
                IsDefault="True" />
            <Button
                x:Name="RunAnywayButton"
                Grid.Column="1"
                MinWidth="120"
                Padding="12,6"
                AutomationProperties.AutomationId="RunUnverifiedApp"
                AutomationProperties.HelpText="{Binding RunAnywayHelp}"
                AutomationProperties.Name="{Binding RunAnywayText}"
                Click="RunAnyway_Click"
                Content="{Binding RunAnywayText}"
                ContentTemplate="{StaticResource WrappedButtonText}"
                IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
