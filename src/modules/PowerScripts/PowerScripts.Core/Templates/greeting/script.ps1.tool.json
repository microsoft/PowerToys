{
  "name": "greeting-template",
  "title": "Greeting with parameters",
  "description": "Return a greeting without reading files, accessing the network or displaying UI.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "title": "Your name", "description": "Included literally in the greeting.", "default": "World" },
      "times": { "type": "integer", "title": "Repetitions", "description": "How many greetings to return.", "default": 1, "minimum": 1, "maximum": 5 }
    },
    "required": []
  },
  "x-powerscript": {
    "runtime": "powershell",
    "input": "none",
    "output": "text",
    "capabilities": []
  }
}
