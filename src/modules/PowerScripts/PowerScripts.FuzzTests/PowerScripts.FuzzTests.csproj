<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PowerScripts.FuzzTests</RootNamespace>
    <AssemblyName>PowerScripts.FuzzTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\..\$(Platform)\$(Configuration)\tests\PowerScripts.FuzzTests\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerScripts.Core\PowerScripts.Core.csproj" />
    <None Update="OneFuzzConfig.json;Seeds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
