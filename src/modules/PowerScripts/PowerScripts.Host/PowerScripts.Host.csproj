<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PowerScripts.Host</RootNamespace>
    <AssemblyName>PowerScripts.Host</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\AgentSkills\powertoys-powerscripts\**\*">
      <Link>AgentSkill\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <ProjectReference Include="..\PowerScripts.Core\PowerScripts.Core.csproj" />
    <ProjectReference Include="..\PowerScripts.Client\PowerScripts.Client.csproj" />
  </ItemGroup>
  <Import Project="..\Mxc.Runtime.targets" />
  <Target Name="DeployPowerScriptsHost" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(Platform)' == 'x64' or '$(Platform)' == 'ARM64')">
    <PropertyGroup>
      <PowerScriptsDeploymentDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\$(Platform)\$(Configuration)\PowerScripts\'))</PowerScriptsDeploymentDirectory>
    </PropertyGroup>
    <ItemGroup>
      <PowerScriptsHostDeploymentFiles Include="$(TargetDir)**\*" Exclude="$(TargetDir)publish\**" />
    </ItemGroup>
    <Copy SourceFiles="@(PowerScriptsHostDeploymentFiles)"
          DestinationFiles="@(PowerScriptsHostDeploymentFiles->'$(PowerScriptsDeploymentDirectory)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PowerScriptsDeploymentDirectory)PowerScripts.Host.exe')"
           Text="The PowerScripts Host was not deployed beside the PowerToys Runner." />
  </Target>
</Project>
