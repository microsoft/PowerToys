{
  "name": "copy-as-unc",
  "title": "Copy as UNC path",
  "description": "Resolve the selected item's mapped network drive to its UNC path (\\\\server\\share\\...) and copy it to the clipboard.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string",
          "x-powerscript": {
            "extensions": [
              "*"
            ]
          }
        },
        "minItems": 1
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  },
  "x-powerscript": {
    "capabilities": [
      "clipboard"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  }
}
