{
  "name": "sha256-checksum",
  "title": "Compute SHA-256",
  "description": "Compute the SHA-256 checksum of the selected file(s).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string",
          "x-powerscript": {
            "extensions": [
              "*"
            ]
          }
        },
        "minItems": 1
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  },
  "x-powerscript": {
    "capabilities": [
      "fileRead"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": { "text": { "type": "string" } },
    "required": ["text"],
    "additionalProperties": false
  }
}
