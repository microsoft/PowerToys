{
  "name": "py_uppercase_files",
  "title": "Uppercase File (Python)",
  "description": "Write an UPPERCASED copy of the selected text file(s) next to the original. A Python file PowerScript for the Explorer right-click menu.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string",
          "x-powerscript": {
            "extensions": [
              ".txt",
              ".md"
            ]
          }
        },
        "minItems": 1
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  },
  "x-powerscript": {
    "capabilities": [
      "fileRead",
      "fileWrite"
    ],
    "publisher": "PowerToys samples",
    "version": "1.0.0"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  }
}
