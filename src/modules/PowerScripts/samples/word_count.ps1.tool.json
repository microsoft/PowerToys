{
  "name": "word-count",
  "title": "Count words",
  "description": "Count the words in one or more text files. Metadata lives in the sibling .tool.json descriptor.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string",
          "x-powerscript": {
            "extensions": [
              ".txt",
              ".md"
            ]
          }
        },
        "minItems": 1
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  },
  "x-execute": {
    "command": [
      "powershell",
      "word_count.ps1"
    ]
  },
  "x-powerscript": {
    "capabilities": [
      "fileRead"
    ],
    "publisher": "PowerToys samples",
    "version": "1.0.0"
  },
  "outputSchema": {
    "type": "object",
    "properties": { "text": { "type": "string" } },
    "required": ["text"],
    "additionalProperties": false
  }
}
