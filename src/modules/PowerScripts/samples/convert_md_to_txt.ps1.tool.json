{
  "name": "convert_md_to_txt",
  "title": "Convert Markdown to Text",
  "description": "Convert selected Markdown files to plain text in the temporary workspace.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string",
          "x-powerscript": {
            "extensions": [
              ".md"
            ]
          }
        },
        "minItems": 1
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  },
  "x-powerscript": {
    "capabilities": [
      "fileRead",
      "fileWrite"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": { "type": "string", "x-powerscript": { "extensions": [".txt"] } },
        "minItems": 1
      }
    },
    "required": ["files"],
    "additionalProperties": false
  }
}
