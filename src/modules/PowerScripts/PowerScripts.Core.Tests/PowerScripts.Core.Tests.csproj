<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PowerScripts.Core.Tests</RootNamespace>
    <AssemblyName>PowerScripts.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerScripts.Core\PowerScripts.Core.csproj" />
    <ProjectReference Include="..\PowerScripts.Client\PowerScripts.Client.csproj" />
    <ProjectReference Include="..\PowerScripts.FuzzTests\PowerScripts.FuzzTests.csproj" />
    <ProjectReference Include="SessionHost\SessionHost.csproj" ReferenceOutputAssembly="false" OutputItemType="SessionHostTargetPath" />

    <!-- Build-order only: guarantees PowerScripts.Host.exe exists before the CLI tests run, so the
         host integration/CLI tests act as a real guard instead of silently skipping. The host is a
         net10.0-windows exe; we don't reference its output assembly (ReferenceOutputAssembly=false)
         and skip TFM negotiation so this net10.0 test project can still depend on its build. -->
    <ProjectReference Include="..\PowerScripts.Host\PowerScripts.Host.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="SessionHost\**\*.cs" />
    <Compile Include="..\PowerScripts.Editor\UI\ViewModels\PowerScriptMetadataDetails.cs"
             Link="EditorMetadata\PowerScriptMetadataDetails.cs" />
    <Compile Include="..\PowerScripts.Editor\UI\ViewModels\PowerScriptMetadataRow.cs"
             Link="EditorMetadata\PowerScriptMetadataRow.cs" />
    <Compile Include="..\PowerScripts.Editor\UI\ViewModels\PowerScriptMetadataSection.cs"
             Link="EditorMetadata\PowerScriptMetadataSection.cs" />
    <Compile Include="..\..\keyboardmanager\KeyboardManagerEditorUI\Helpers\PowerScriptInvocation.cs"
             Link="KbmHelpers\PowerScriptInvocation.cs" />
    <None Include="..\PowerScripts.FuzzTests\Seeds\**\*"
          Link="FuzzSeeds\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopySessionHost" AfterTargets="Build">
    <PropertyGroup>
      <SessionHostOutputDirectory>@(SessionHostTargetPath->'%(RootDir)%(Directory)')</SessionHostOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <SessionHostFiles Include="$(SessionHostOutputDirectory)SessionHost.*" />
      <SessionHostFiles Include="$(SessionHostOutputDirectory)PowerScripts.Client.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SessionHostFiles)" DestinationFolder="$(OutDir)session-host" />
    <Error Condition="!Exists('$(OutDir)session-host\SessionHost.exe')" Text="The session test Host was not deployed." />
  </Target>
</Project>
