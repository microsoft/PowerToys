<Project>
  <!--
    PROTOTYPE-ONLY build props for the PowerScripts module.
    Intentionally does NOT import the repo-root Directory.Build.props so the
    prototype stays isolated from StyleCop / TreatWarningsAsErrors / Central
    Package Management while we iterate. Before promoting PowerScripts out of
    prototype status, delete this file so the projects inherit the standard
    PowerToys build configuration and analyzers.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      Match the PowerToys solution platforms so these projects can be referenced from PowerToys.slnx.
      The repo-root Directory.Build.props (which normally supplies this) is intentionally not imported
      by the prototype, so the platforms are declared explicitly here instead.
    -->
    <Platforms>x64;ARM64</Platforms>
    <!--
      Keep the output at bin\$(Configuration)\... (no platform segment) so the path stays stable
      across AnyCPU/x64/ARM64 builds. The Settings dev-fallback that locates PowerScripts.Host.exe
      probes bin\Debug and bin\Release, and the prototype is built one platform at a time locally.
    -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>
</Project>
