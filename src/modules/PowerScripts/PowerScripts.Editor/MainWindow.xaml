<Window
    x:Class="PowerScripts.Editor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PowerScripts Editor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="EditorTitleBar"
            Title="PowerScripts Editor"
            Height="48"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Settings/Icons/PowerToys.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="EditorSearch"
                    x:Uid="PowerScripts_WorkspaceSearch"
                    MinWidth="364"
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PowerScriptsSearchTextBox"
                    Text="{x:Bind _viewModel.ScriptSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="Search_TextChanged">
                    <AutoSuggestBox.QueryIcon>
                        <FontIcon FontSize="16" Glyph="&#xE721;" />
                    </AutoSuggestBox.QueryIcon>
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="F"
                            Invoked="SearchAccelerator_Invoked"
                            Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>
        <InfoBar
            x:Name="ShellError"
            Grid.Row="1"
            Margin="16,0,16,8"
            AutomationProperties.AutomationId="PowerScriptsShellError"
            IsClosable="True"
            Severity="Error" />
        <NavigationView
            x:Name="Navigation"
            Grid.Row="2"
            AutomationProperties.AutomationId="PowerScriptsEditorNavigation"
            HighContrastAdjustment="None"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="Navigation_ItemInvoked"
            Loaded="Navigation_Loaded"
            SelectionChanged="Navigation_SelectionChanged"
            Style="{StaticResource MainNavigationViewStyle}">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MyScriptsTab"
                    x:Uid="PowerScripts_MyScriptsTab"
                    AutomationProperties.AutomationId="PowerScriptsMyScriptsTab"
                    Style="{StaticResource MainNavigationViewItemStyle}"
                    Tag="0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ActivityTab"
                    x:Uid="PowerScripts_ActivityTab"
                    AutomationProperties.AutomationId="PowerScriptsActivityTab"
                    Style="{StaticResource MainNavigationViewItemStyle}"
                    Tag="1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="PowerScripts_ConsumerModulesTab"
                    AutomationProperties.AutomationId="PowerScriptsConsumerModulesTab"
                    Style="{StaticResource MainNavigationViewItemStyle}"
                    Tag="2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <ContentControl
                x:Name="TabContent"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>