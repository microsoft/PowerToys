<Page
    x:Class="PowerScripts.Editor.Views.MyScriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="using:PowerScripts.Editor.Controls"
    xmlns:local="using:PowerScripts.Editor.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:PowerScripts.UI.ViewModels"
    xmlns:views="using:PowerScripts.Editor.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:PowerScriptsViewModel}"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">

    <layout:ManagementPage
        x:Name="PowerScriptsSettingsPage"
        IsTabStop="False"
        ModuleDescription="Create and manage scripts for compatible PowerToys modules. Global runtime, isolation, and integration options live in PowerToys Settings."
        ModuleTitle="My scripts">
        <layout:ManagementPage.ModuleContent>
            <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Orientation="Vertical">
                <tkcontrols:SettingsCard
                    x:Uid="PowerScripts_OpenGlobalSettings"
                    AutomationProperties.AutomationId="PowerScriptsOpenGlobalSettings"
                    Click="OpenGlobalSettings_Click"
                    Description="{x:Bind ViewModel.ExecutionSettingsSummary, Mode=OneWay}"
                    IsClickEnabled="True">
                    <FontIcon Glyph="&#xE713;" />
                </tkcontrols:SettingsCard>
                <InfoBar
                    x:Uid="PowerScripts_EditorDisabled"
                    AutomationProperties.AutomationId="PowerScriptsEditorDisabled"
                    IsClosable="False"
                    IsOpen="{x:Bind views:MyScriptsPage.IsDisabled(ViewModel.IsEnabled), Mode=OneWay}"
                    Severity="Informational" />
                <tkcontrols:SettingsCard x:Uid="PowerScripts_EditorFolder" Description="{x:Bind ViewModel.ScriptsFolder, Mode=OneWay}">
                    <Button
                        x:Uid="PowerScripts_OpenFolder"
                        AutomationProperties.AutomationId="PowerScriptsOpenFolderButton"
                        Click="OpenScriptsFolderButton_Click" />
                </tkcontrols:SettingsCard>
                <controls:SettingsGroup Header="Installed scripts" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <InfoBar
                        x:Name="ScriptSettingsError"
                        AutomationProperties.AutomationId="PowerScriptsSettingsError"
                        IsClosable="False"
                        Severity="Error" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.ColumnSpan="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="PowerScripts_CatalogueSearch"
                                AutomationProperties.AutomationId="PowerScriptsSearchTextBox"
                                Text="{x:Bind ViewModel.ScriptSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Uid="PowerScripts_CreateScriptAction"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="PowerScriptsCreateScript"
                                Style="{StaticResource AccentButtonStyle}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem
                                            x:Uid="PowerScripts_CreateCustomScript"
                                            AutomationProperties.AutomationId="PowerScriptsCreateCustomScript"
                                            Click="CreateCustomScript_Click" />
                                        <MenuFlyoutItem
                                            x:Uid="PowerScripts_CreatePowerToysOperations"
                                            AutomationProperties.AutomationId="PowerScriptsCreatePowerToysOperations"
                                            Click="CreatePowerToysOperations_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock x:Uid="PowerScripts_CreateScriptButton" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ComboBox
                            x:Uid="PowerScripts_CatalogueInputFilter"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PowerScriptsInputFilterComboBox"
                            SelectedIndex="{x:Bind ViewModel.ScriptInputFilterIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="PowerScripts_FilterAll" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterNone" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterFiles" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterText" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterImage" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterAudio" />
                        </ComboBox>
                        <ComboBox
                            x:Uid="PowerScripts_CatalogueOutputFilter"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PowerScriptsOutputFilterComboBox"
                            SelectedIndex="{x:Bind ViewModel.ScriptOutputFilterIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="PowerScripts_OutputFilterAll" />
                            <ComboBoxItem x:Uid="PowerScripts_OutputFilterNone" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterFiles" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterText" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterImage" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterAudio" />
                        </ComboBox>
                        <ComboBox
                            x:Uid="PowerScripts_CatalogueSort"
                            Grid.Row="1"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PowerScriptsSortComboBox"
                            SelectedIndex="{x:Bind ViewModel.ScriptSortIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="PowerScripts_SortNameAscending" />
                            <ComboBoxItem x:Uid="PowerScripts_SortNameDescending" />
                            <ComboBoxItem x:Uid="PowerScripts_SortInput" />
                            <ComboBoxItem x:Uid="PowerScripts_SortOutput" />
                            <ComboBoxItem x:Uid="PowerScripts_SortRuntime" />
                        </ComboBox>
                    </Grid>
                    <TextBlock
                        AutomationProperties.AutomationId="PowerScriptsCatalogueCount"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.CatalogueCount, Mode=OneWay}" />
                    <InfoBar
                        x:Uid="PowerScripts_SettingsEmptyCatalogue"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasScripts, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        Severity="Informational" />
                    <InfoBar
                        x:Uid="PowerScripts_CatalogueNoMatches"
                        AutomationProperties.AutomationId="PowerScriptsCatalogueNoMatches"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasNoMatchingScripts, Mode=OneWay}"
                        Severity="Informational" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.VisibleScripts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:PowerScriptListItem">
                                <tkcontrols:SettingsCard
                                    Margin="0,0,0,8"
                                    AutomationProperties.AutomationId="{x:Bind CardAutomationId, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                    Click="ScriptSettingsButton_Click"
                                    Description="{x:Bind Description, Mode=OneWay}"
                                    IsClickEnabled="True">
                                    <tkcontrols:SettingsCard.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="32" Height="32">
                                                <FontIcon Glyph="{x:Bind DefaultIconGlyph, Mode=OneWay}" Visibility="{x:Bind views:MyScriptsPage.InvertBoolToVisibility(HasIcon), Mode=OneWay}" />
                                                <Image
                                                    DataContext="{x:Bind}"
                                                    ImageFailed="ScriptIcon_ImageFailed"
                                                    Source="{Binding IconSourcePath, Mode=OneWay}"
                                                    Visibility="{x:Bind views:MyScriptsPage.BoolToVisibility(HasIcon), Mode=OneWay}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Name, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind CatalogueSummary, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </tkcontrols:SettingsCard.Header>
                                </tkcontrols:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:SettingsGroup>
            </StackPanel>
        </layout:ManagementPage.ModuleContent>

    </layout:ManagementPage>
</Page>
