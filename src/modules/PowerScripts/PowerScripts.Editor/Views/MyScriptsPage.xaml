<Page
    x:Class="PowerScripts.Editor.Views.MyScriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:PowerScripts.UI.ViewModels"
    xmlns:views="using:PowerScripts.Editor.Views"
    AutomationProperties.LandmarkType="Main">
    <Grid Margin="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Uid="PowerScripts_LibraryHeading"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Uid="PowerScripts_EditorDisabled"
                AutomationProperties.AutomationId="PowerScriptsEditorDisabled"
                IsClosable="False"
                IsOpen="{x:Bind views:MyScriptsPage.IsDisabled(ViewModel.IsEnabled), Mode=OneWay}"
                Severity="Informational" />
            <InfoBar
                x:Name="ScriptSettingsError"
                AutomationProperties.AutomationId="PowerScriptsSettingsError"
                IsClosable="False"
                Severity="Error" />
            <Border Padding="16,12" Style="{StaticResource EditorSurfaceStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        Glyph="&#xE72E;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ExecutionSettingsSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Uid="PowerScripts_OpenGlobalSettingsButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="PowerScriptsOpenGlobalSettings"
                        Click="OpenGlobalSettings_Click"
                        Content="{ui:FontIcon Glyph=&#xE713;,
                                              FontSize=16}"
                        Style="{StaticResource SubtleButtonStyle}" />
                </Grid>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="PowerScripts_CreateScriptAction"
                AutomationProperties.AutomationId="PowerScriptsCreateScript"
                Click="CreateScript_Click"
                IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock x:Uid="PowerScripts_CreateScriptButton" />
                </StackPanel>
            </Button>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind views:MyScriptsPage.BoolToVisibility(ViewModel.HasScripts), Mode=OneWay}">
                <ComboBox
                    x:Uid="PowerScripts_CatalogueSort"
                    MinWidth="160"
                    AutomationProperties.AutomationId="PowerScriptsSortComboBox"
                    SelectedIndex="{x:Bind ViewModel.ScriptSortIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="PowerScripts_SortNameAscending" />
                    <ComboBoxItem x:Uid="PowerScripts_SortNameDescending" />
                    <ComboBoxItem x:Uid="PowerScripts_SortInput" />
                    <ComboBoxItem x:Uid="PowerScripts_SortOutput" />
                    <ComboBoxItem x:Uid="PowerScripts_SortRuntime" />
                </ComboBox>
                <Button
                    x:Uid="PowerScripts_FilterButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="PowerScriptsFilterButton"
                    Style="{StaticResource SubtleButtonStyle}">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xE71C;" />
                        <InfoBadge
                            Margin="0,-4,-6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind views:MyScriptsPage.FilterBadgeVisibility(ViewModel.ScriptInputFilterIndex, ViewModel.ScriptOutputFilterIndex), Mode=OneWay}" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel
                                MinWidth="260"
                                Padding="4"
                                Spacing="16">
                                <ComboBox
                                    x:Uid="PowerScripts_CatalogueInputFilter"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="PowerScriptsInputFilterComboBox"
                                    SelectedIndex="{x:Bind ViewModel.ScriptInputFilterIndex, Mode=TwoWay}">
                                    <ComboBoxItem x:Uid="PowerScripts_FilterAll" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterNone" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterFiles" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterText" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterImage" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterAudio" />
                                </ComboBox>
                                <ComboBox
                                    x:Uid="PowerScripts_CatalogueOutputFilter"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="PowerScriptsOutputFilterComboBox"
                                    SelectedIndex="{x:Bind ViewModel.ScriptOutputFilterIndex, Mode=TwoWay}">
                                    <ComboBoxItem x:Uid="PowerScripts_OutputFilterAll" />
                                    <ComboBoxItem x:Uid="PowerScripts_OutputFilterNone" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterFiles" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterText" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterImage" />
                                    <ComboBoxItem x:Uid="PowerScripts_FilterAudio" />
                                </ComboBox>
                                <Button
                                    x:Uid="PowerScripts_ClearFilters"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="PowerScriptsClearFilters"
                                    Click="ClearFilters_Click"
                                    Style="{StaticResource SubtleButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Rectangle
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button
                    x:Uid="PowerScripts_OpenFolderButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="PowerScriptsOpenFolderButton"
                    Click="OpenScriptsFolderButton_Click"
                    Content="{ui:FontIcon Glyph=&#xE8B7;,
                                          FontSize=16}"
                    Style="{StaticResource SubtleButtonStyle}" />
            </StackPanel>
        </Grid>
        <Grid
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <ListView
                x:Uid="PowerScripts_ScriptList"
                Padding="0,4"
                AutomationProperties.AutomationId="PowerScriptsScriptGrid"
                IsItemClickEnabled="True"
                ItemClick="ScriptList_ItemClick"
                ItemsSource="{x:Bind ViewModel.VisibleScripts, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PowerScriptListItem">
                        <Grid
                            MinHeight="56"
                            Padding="0,8"
                            AutomationProperties.AutomationId="{x:Bind CardAutomationId, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="40"
                                Height="40"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <FontIcon
                                    FontSize="20"
                                    Glyph="{x:Bind DefaultIconGlyph, Mode=OneWay}"
                                    Visibility="{x:Bind views:MyScriptsPage.InvertBoolToVisibility(HasIcon), Mode=OneWay}" />
                                <Image
                                    Width="24"
                                    Height="24"
                                    ImageFailed="ScriptIcon_ImageFailed"
                                    Source="{Binding IconSourcePath, Mode=OneWay}"
                                    Visibility="{x:Bind views:MyScriptsPage.BoolToVisibility(HasIcon), Mode=OneWay}" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind views:MyScriptsPage.ScriptCaption(HasConfigurationErrors, Trusted, Description), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind CatalogueSummary, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <Button
                                x:Uid="PowerScripts_ScriptMoreButton"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Content="{ui:FontIcon Glyph=&#xE712;,
                                                      FontSize=14}"
                                Style="{StaticResource SubtleButtonStyle}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem
                                            x:Uid="PowerScripts_OpenScriptMenuItem"
                                            Click="OpenScriptMenuItem_Click"
                                            Icon="{ui:FontIcon Glyph=&#xE8A7;}"
                                            Tag="{x:Bind}" />
                                        <MenuFlyoutItem
                                            x:Uid="PowerScripts_EditScriptMenuItem"
                                            Click="EditScriptMenuItem_Click"
                                            Icon="{ui:FontIcon Glyph=&#xE70F;}"
                                            Tag="{x:Bind}" />
                                        <MenuFlyoutItem
                                            x:Uid="PowerScripts_ShowInExplorerMenuItem"
                                            Click="ShowInExplorerMenuItem_Click"
                                            Icon="{ui:FontIcon Glyph=&#xE838;}"
                                            Tag="{x:Bind}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsEmptyCatalogue"
                Spacing="8"
                Visibility="{x:Bind views:MyScriptsPage.InvertBoolToVisibility(ViewModel.HasScripts), Mode=OneWay}">
                <FontIcon
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE943;" />
                <TextBlock x:Uid="PowerScripts_EmptyCatalogueTitle" TextAlignment="Center" />
                <TextBlock
                    x:Uid="PowerScripts_EmptyCatalogueDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="PowerScripts_OpenFolder"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="OpenScriptsFolderButton_Click" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsCatalogueNoMatches"
                Spacing="8"
                Visibility="{x:Bind views:MyScriptsPage.BoolToVisibility(ViewModel.HasNoMatchingScripts), Mode=OneWay}">
                <FontIcon
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;" />
                <TextBlock x:Uid="PowerScripts_NoMatchesTitle" TextAlignment="Center" />
                <TextBlock
                    x:Uid="PowerScripts_NoMatchesDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="PowerScripts_ClearFilters"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="ClearFilters_Click" />
            </StackPanel>
        </Grid>
        <ContentDialog
            x:Name="NewScriptDialog"
            x:Uid="PowerScripts_NewScriptDialog"
            AutomationProperties.AutomationId="PowerScriptsNewScriptDialog"
            DefaultButton="None">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="PowerScripts_NewScriptDialogDescription"
                    Margin="0,0,0,12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <tkcontrols:SettingsCard
                    x:Uid="PowerScripts_NewScriptChoiceScript"
                    AutomationProperties.AutomationId="PowerScriptsNewScriptChoice"
                    Click="NewScriptChoice_Click"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE943;}"
                    IsClickEnabled="True"
                    Tag="Script" />
                <tkcontrols:SettingsCard
                    x:Uid="PowerScripts_NewScriptChoiceOperation"
                    AutomationProperties.AutomationId="PowerScriptsNewOperationChoice"
                    Click="NewScriptChoice_Click"
                    IsClickEnabled="True"
                    Tag="Operation">
                    <tkcontrols:SettingsCard.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Settings/Icons/PowerToys.png" />
                    </tkcontrols:SettingsCard.HeaderIcon>
                </tkcontrols:SettingsCard>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
