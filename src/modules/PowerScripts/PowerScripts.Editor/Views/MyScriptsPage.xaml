<Page
    x:Class="PowerScripts.Editor.Views.MyScriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:PowerScripts.Editor.Controls"
    xmlns:viewModels="using:PowerScripts.UI.ViewModels"
    xmlns:views="using:PowerScripts.Editor.Views"
    AutomationProperties.LandmarkType="Main">
    <Grid Margin="32,24,24,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,8,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="PowerScripts_LibraryHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="PowerScripts_LibraryHelp"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Uid="PowerScripts_OpenFolder"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsOpenFolderButton"
                Click="OpenScriptsFolderButton_Click"
                ToolTipService.ToolTip="{x:Bind ViewModel.ScriptsFolder, Mode=OneWay}" />
            <Button
                x:Uid="PowerScripts_CreateScriptAction"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsCreateScript"
                Click="CreateScriptButton_Click"
                IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock x:Uid="PowerScripts_CreateScriptButton" />
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel
            Grid.Row="1"
            Margin="0,0,8,0"
            Spacing="8">
            <InfoBar
                x:Uid="PowerScripts_EditorDisabled"
                AutomationProperties.AutomationId="PowerScriptsEditorDisabled"
                IsClosable="False"
                IsOpen="{x:Bind views:MyScriptsPage.IsDisabled(ViewModel.IsEnabled), Mode=OneWay}"
                Severity="Informational" />
            <InfoBar
                x:Name="ScriptSettingsError"
                AutomationProperties.AutomationId="PowerScriptsSettingsError"
                IsClosable="False"
                Severity="Error" />
            <Border Padding="16,12" Style="{StaticResource EditorSurfaceStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        Glyph="&#xE72E;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ExecutionSettingsSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Uid="PowerScripts_OpenGlobalSettingsButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="PowerScriptsOpenGlobalSettings"
                        Click="OpenGlobalSettings_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE713;" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
        <Grid
            Grid.Row="2"
            Margin="0,0,8,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Uid="PowerScripts_CatalogueInputFilter"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="PowerScriptsInputFilterComboBox"
                SelectedIndex="{x:Bind ViewModel.ScriptInputFilterIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="PowerScripts_FilterAll" />
                <ComboBoxItem x:Uid="PowerScripts_FilterNone" />
                <ComboBoxItem x:Uid="PowerScripts_FilterFiles" />
                <ComboBoxItem x:Uid="PowerScripts_FilterText" />
                <ComboBoxItem x:Uid="PowerScripts_FilterImage" />
                <ComboBoxItem x:Uid="PowerScripts_FilterAudio" />
            </ComboBox>
            <ComboBox
                x:Uid="PowerScripts_CatalogueOutputFilter"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="PowerScriptsOutputFilterComboBox"
                SelectedIndex="{x:Bind ViewModel.ScriptOutputFilterIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="PowerScripts_OutputFilterAll" />
                <ComboBoxItem x:Uid="PowerScripts_OutputFilterNone" />
                <ComboBoxItem x:Uid="PowerScripts_FilterFiles" />
                <ComboBoxItem x:Uid="PowerScripts_FilterText" />
                <ComboBoxItem x:Uid="PowerScripts_FilterImage" />
                <ComboBoxItem x:Uid="PowerScripts_FilterAudio" />
            </ComboBox>
            <ComboBox
                x:Uid="PowerScripts_CatalogueSort"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="PowerScriptsSortComboBox"
                SelectedIndex="{x:Bind ViewModel.ScriptSortIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="PowerScripts_SortNameAscending" />
                <ComboBoxItem x:Uid="PowerScripts_SortNameDescending" />
                <ComboBoxItem x:Uid="PowerScripts_SortInput" />
                <ComboBoxItem x:Uid="PowerScripts_SortOutput" />
                <ComboBoxItem x:Uid="PowerScripts_SortRuntime" />
            </ComboBox>
        </Grid>
        <TextBlock
            Grid.Row="3"
            AutomationProperties.AutomationId="PowerScriptsCatalogueCount"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.CatalogueCount, Mode=OneWay}" />
        <Grid Grid.Row="4">
            <StackPanel Margin="0,0,8,0" Spacing="8">
                <InfoBar
                    x:Uid="PowerScripts_SettingsEmptyCatalogue"
                    IsClosable="False"
                    IsOpen="{x:Bind views:MyScriptsPage.IsDisabled(ViewModel.HasScripts), Mode=OneWay}"
                    Severity="Informational" />
                <InfoBar
                    x:Uid="PowerScripts_CatalogueNoMatches"
                    AutomationProperties.AutomationId="PowerScriptsCatalogueNoMatches"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasNoMatchingScripts, Mode=OneWay}"
                    Severity="Informational" />
            </StackPanel>
            <GridView
                x:Name="ScriptGrid"
                AutomationProperties.AutomationId="PowerScriptsScriptGrid"
                AutomationProperties.Name="{x:Bind ViewModel.CatalogueCount, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="ScriptCard_ItemClick"
                ItemsSource="{x:Bind ViewModel.VisibleScripts, Mode=OneWay}"
                SelectionMode="None"
                SizeChanged="ScriptGrid_SizeChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="180"
                            ItemWidth="252"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PowerScriptListItem">
                        <layout:ScriptCard
                            AutomationProperties.AutomationId="{x:Bind CardAutomationId, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            Script="{x:Bind Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
