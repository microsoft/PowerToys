<Page
    x:Class="PowerScripts.Editor.Views.PowerScriptsActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PowerScripts.Editor.Helpers"
    xmlns:viewModels="using:PowerScripts.UI.ViewModels"
    xmlns:views="using:PowerScripts.Editor.Views"
    AutomationProperties.AutomationId="PowerScriptsActivityPage"
    AutomationProperties.LandmarkType="Main">
    <Grid Margin="32,24,32,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Uid="PowerScripts_ActivityHeading"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            x:Uid="PowerScripts_ActivityHelp"
            Grid.Row="1"
            TextWrapping="Wrap" />
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="PowerScripts_ActivityRefresh"
                AutomationProperties.AutomationId="PowerScriptsActivityRefresh"
                Click="RefreshButton_Click"
                IsEnabled="{x:Bind ViewModel.CanRefreshActivity, Mode=OneWay}" />
            <Button
                x:Uid="PowerScripts_ActivityClear"
                Grid.Column="1"
                AutomationProperties.AutomationId="PowerScriptsActivityClear"
                Click="ClearButton_Click"
                IsEnabled="{x:Bind ViewModel.CanRefreshActivity, Mode=OneWay}" />
            <ProgressRing
                Grid.Column="2"
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsActivityBusy, Mode=OneWay}"
                Visibility="{x:Bind views:MyScriptsPage.BoolToVisibility(ViewModel.IsActivityBusy), Mode=OneWay}" />
        </Grid>
        <InfoBar
            x:Uid="PowerScripts_ActivityError"
            Grid.Row="3"
            AutomationProperties.AutomationId="PowerScriptsActivityError"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasActivityError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ActivityError, Mode=OneWay}"
            Severity="Error" />
        <Grid Grid.Row="4">
            <TextBlock
                x:Uid="PowerScripts_ActivityEmpty"
                AutomationProperties.AutomationId="PowerScriptsActivityEmpty"
                Visibility="{x:Bind views:MyScriptsPage.BoolToVisibility(ViewModel.IsActivityEmpty), Mode=OneWay}" />
            <ListView
                x:Uid="PowerScripts_ActivityList"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="PowerScriptsActivityList"
                ItemsSource="{x:Bind ViewModel.ActivityItems, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PowerScriptActivityItem">
                        <Grid
                            Margin="0,0,0,8"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ScriptName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ScriptName}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Details}"
                                TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="{x:Bind Outcome, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
