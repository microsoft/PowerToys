<Page
    x:Class="PowerScripts.Editor.Views.PowerScriptsActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:PowerScripts.UI.ViewModels"
    xmlns:views="using:PowerScripts.Editor.Views"
    AutomationProperties.AutomationId="PowerScriptsActivityPage"
    AutomationProperties.LandmarkType="Main">
    <Grid Margin="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="PowerScripts_ActivityHeading"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressRing
                Grid.Column="1"
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsActivityBusy, Mode=OneWay}"
                Visibility="{x:Bind views:MyScriptsPage.BoolToVisibility(ViewModel.IsActivityBusy), Mode=OneWay}" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsActivityRefresh"
                Click="RefreshButton_Click"
                IsEnabled="{x:Bind ViewModel.CanRefreshActivity, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock x:Uid="PowerScripts_ActivityRefreshText" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsActivityClear"
                Click="ClearButton_Click"
                IsEnabled="{x:Bind ViewModel.CanRefreshActivity, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock x:Uid="PowerScripts_ActivityClearText" />
                </StackPanel>
            </Button>
        </Grid>
        <tkcontrols:Segmented
            x:Name="ActivityFilter"
            x:Uid="PowerScripts_ActivityFilter"
            Grid.Row="1"
            AutomationProperties.AutomationId="PowerScriptsActivityFilter"
            SelectedIndex="0"
            SelectionChanged="ActivityFilter_SelectionChanged">
            <tkcontrols:SegmentedItem x:Uid="PowerScripts_ActivityFilterAll" />
            <tkcontrols:SegmentedItem x:Uid="PowerScripts_ActivityFilterFailed" />
        </tkcontrols:Segmented>
        <InfoBar
            x:Uid="PowerScripts_ActivityError"
            Grid.Row="2"
            AutomationProperties.AutomationId="PowerScriptsActivityError"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasActivityError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ActivityError, Mode=OneWay}"
            Severity="Error" />
        <Grid
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <ListView
                x:Uid="PowerScripts_ActivityList"
                Padding="0,4"
                AutomationProperties.AutomationId="PowerScriptsActivityList"
                ItemsSource="{x:Bind VisibleActivity}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PowerScriptActivityItem">
                        <Grid
                            MinHeight="56"
                            Padding="0,8"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" VerticalAlignment="Center">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind views:PowerScriptsActivityPage.IsStatus(Status, 'running'), Mode=OneWay}"
                                    Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'running'), Mode=OneWay}" />
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xE73E;"
                                    Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'succeeded'), Mode=OneWay}" />
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE783;"
                                    Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'failed'), Mode=OneWay}" />
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE711;"
                                    Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'interrupted'), Mode=OneWay}" />
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE9CE;"
                                    Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'unknown'), Mode=OneWay}" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Text="{x:Bind ScriptName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind ScriptName}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Details}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                MaxWidth="320"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Outcome, Mode=OneWay}"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsActivityEmpty"
                Spacing="8"
                Visibility="{x:Bind views:MyScriptsPage.BoolToVisibility(ViewModel.IsActivityEmpty), Mode=OneWay}">
                <FontIcon
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE81C;" />
                <TextBlock x:Uid="PowerScripts_ActivityEmptyTitle" TextAlignment="Center" />
                <TextBlock
                    x:Uid="PowerScripts_ActivityEmptyDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                x:Name="NoFailedRuns"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsActivityNoMatches"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;" />
                <TextBlock x:Uid="PowerScripts_NoMatchesTitle" TextAlignment="Center" />
                <Button
                    x:Uid="PowerScripts_ActivityShowAll"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="ShowAll_Click" />
            </StackPanel>
        </Grid>
        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            Spacing="8">
            <FontIcon
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE72E;" />
            <TextBlock
                x:Uid="PowerScripts_ActivityPrivacy"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Page>
