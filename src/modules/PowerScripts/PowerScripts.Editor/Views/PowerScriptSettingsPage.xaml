<Page
    x:Class="PowerScripts.Editor.Views.PowerScriptSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:PowerScripts.Editor.Helpers"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:PowerScripts.UI.ViewModels"
    xmlns:views="using:PowerScripts.Editor.Views"
    AutomationProperties.AutomationId="PowerScriptsScriptSettingsPage"
    AutomationProperties.LandmarkType="Main">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Left"
            Invoked="BackKeyboardAccelerator_Invoked"
            Modifiers="Menu" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <Style x:Key="ScriptCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style
            x:Key="SideCardStyle"
            BasedOn="{StaticResource ScriptCardStyle}"
            TargetType="Border">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style
            x:Key="HintTextStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="CardHeadingStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="200" />
            <Setter Property="MaxHeight" Value="480" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <ItemsPanelTemplate x:Key="RowsPanel">
            <StackPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="PreviewRowTemplate" x:DataType="viewModels:PowerScriptPreviewRow">
            <Grid
                MinHeight="52"
                Padding="16,8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{x:Bind views:PowerScriptTemplatesPage.DividerThickness(HasDivider)}"
                ColumnSpacing="12"
                Opacity="{x:Bind views:PowerScriptTemplatesPage.OffOpacity(IsOff)}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="{x:Bind Icon}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource HintTextStyle}"
                        Text="{x:Bind Detail}"
                        Visibility="{x:Bind views:PowerScriptTemplatesPage.BoolToVisibility(HasDetail)}" />
                </StackPanel>
                <Border
                    Grid.Column="2"
                    Padding="8,1,8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{x:Bind views:PowerScriptTemplatesPage.BoolToVisibility(IsOff)}">
                    <TextBlock x:Uid="PowerScripts_NewScript_OffPill" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RecentRunTemplate" x:DataType="viewModels:PowerScriptActivityItem">
            <Grid
                MinHeight="52"
                Padding="16,8"
                AutomationProperties.Name="{x:Bind ToString(), Mode=OneWay}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind IsRunning, Mode=OneWay}"
                        Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'running'), Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'succeeded'), Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE783;"
                        Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'failed'), Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE711;"
                        Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'interrupted'), Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE9CE;"
                        Visibility="{x:Bind views:PowerScriptsActivityPage.StatusVisibility(Status, 'unknown'), Mode=OneWay}" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="16"
                            Height="16"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="{x:Bind SourceIconPath}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Meta, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Code, Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ExitText, Mode=OneWay}"
                    Visibility="{x:Bind HasExitCode, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1144"
            Padding="32,28,32,32"
            Spacing="20">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    Width="64"
                    Height="64"
                    VerticalAlignment="Top"
                    helpers:ScriptTileTint.Kind="{Binding TileKind, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <FontIcon
                            x:Name="HeaderDefaultIcon"
                            FontSize="30"
                            Glyph="{Binding DefaultIconGlyph, Mode=OneWay}" />
                        <Image
                            Width="36"
                            Height="36"
                            AutomationProperties.AutomationId="PowerScriptsHeroIcon"
                            ImageFailed="HeaderIcon_ImageFailed"
                            Source="{Binding IconSourcePath, Mode=OneWay}"
                            Visibility="{Binding HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </ContentPresenter>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{Binding Name, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Description, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <tkcontrols:WrapPanel
                        Margin="0,4,0,0"
                        HorizontalSpacing="16"
                        VerticalSpacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE943;" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding RuntimeDisplay, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8AB;" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding ContractDisplay, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE823;" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding LastRunDisplay, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{Binding NeedsTrust, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                x:Uid="PowerScripts_Script_NotAllowedFact"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </tkcontrols:WrapPanel>
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RunCommandButton"
                        AutomationProperties.AutomationId="PowerScriptsRunAction"
                        Click="RunCommandButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock x:Uid="PowerScripts_Script_Run" />
                        </StackPanel>
                    </Button>
                    <SplitButton
                        x:Name="HeroEditScriptButton"
                        x:Uid="PowerScripts_Script_EditSplit"
                        AutomationProperties.AutomationId="PowerScriptsHeroEditScript"
                        Click="HeroEditScriptButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                            <TextBlock x:Uid="PowerScripts_Script_Edit" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Uid="PowerScripts_Script_EditToolJson"
                                    AutomationProperties.AutomationId="PowerScriptsEditMetadata"
                                    Click="EditMetadataButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Uid="PowerScripts_Script_Refresh"
                                    AutomationProperties.AutomationId="PowerScriptsRefreshMetadata"
                                    Click="RefreshMetadataButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button
                        x:Name="CopyAgentInstructionsButton"
                        x:Uid="PowerScripts_CopyAgentInstructionsButton"
                        AutomationProperties.AutomationId="PowerScriptsCopySkillInstructionsButton"
                        Click="CopyAgentSkillInstructions_Click" />
                    <Button
                        x:Name="MoreButton"
                        x:Uid="PowerScripts_Script_More"
                        AutomationProperties.AutomationId="PowerScriptsMore"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Uid="PowerScripts_ShowInExplorerMenuItem"
                                    AutomationProperties.AutomationId="PowerScriptsShowInExplorer"
                                    Click="OpenScriptFolderButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Uid="PowerScripts_Script_CopyPathMenuItem"
                                    AutomationProperties.AutomationId="PowerScriptsCopyPathMenuItem"
                                    Click="CopyPath_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="ScriptSettingsError"
                AutomationProperties.AutomationId="PowerScriptsSettingsPageError"
                IsClosable="False"
                Severity="Error"
                Visibility="{x:Bind ScriptSettingsError.IsOpen, Mode=OneWay}" />
            <InfoBar
                x:Name="EditorStatus"
                x:Uid="PowerScripts_EditorFallback"
                AutomationProperties.AutomationId="PowerScriptsEditorStatus"
                IsClosable="True"
                Severity="Informational"
                Visibility="{x:Bind EditorStatus.IsOpen, Mode=OneWay}" />
            <InfoBar
                x:Name="AgentSkillFeedback"
                AutomationProperties.AutomationId="PowerScriptsAgentSkillFeedback"
                IsClosable="True"
                Visibility="{x:Bind AgentSkillFeedback.IsOpen, Mode=OneWay}" />
            <InfoBar
                x:Uid="PowerScripts_Script_IconWarning"
                AutomationProperties.AutomationId="PowerScriptsIconWarning"
                IsClosable="False"
                IsOpen="{Binding HasIconWarning, Mode=OneWay}"
                Message="{Binding IconWarning, Mode=OneWay}"
                Severity="Warning"
                Visibility="{Binding HasIconWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Grid
                x:Name="BodyGrid"
                ColumnSpacing="24"
                RowSpacing="16"
                SizeChanged="BodyGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="340" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="16">
                    <Border
                        x:Name="RunCard"
                        AutomationProperties.AutomationId="PowerScriptsRunPanel"
                        Style="{StaticResource ScriptCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="PowerScripts_Script_RunHeading" Style="{StaticResource CardHeadingStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="PowerScriptsRunStatus"
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{StaticResource HintTextStyle}"
                                    Text="{x:Bind RunModel.Status, Mode=OneWay}"
                                    TextWrapping="NoWrap" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource HintTextStyle}"
                                Text="{x:Bind RunModel.UnsupportedReason, Mode=OneWay}"
                                Visibility="{x:Bind RunModel.HasUnsupportedReason, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ContentControl
                                HorizontalContentAlignment="Stretch"
                                IsEnabled="{x:Bind RunModel.CanEdit, Mode=OneWay}"
                                Visibility="{x:Bind views:PowerScriptSettingsPage.RunInputsVisibility(RunModel.HasTextInput, RunModel.HasFileInput, RunModel.HasNoParameters), Mode=OneWay}">
                                <StackPanel Spacing="12">
                                    <TextBox
                                        x:Uid="PowerScripts_RunTextInput"
                                        MinHeight="72"
                                        AcceptsReturn="True"
                                        AutomationProperties.AutomationId="PowerScriptsRunTextInput"
                                        Text="{x:Bind RunModel.PrimaryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind RunModel.HasTextInput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Spacing="8" Visibility="{x:Bind RunModel.HasFileInput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBox
                                            x:Uid="PowerScripts_RunFileInput"
                                            MinHeight="72"
                                            AcceptsReturn="True"
                                            AutomationProperties.AutomationId="PowerScriptsRunFileInput"
                                            Text="{x:Bind RunModel.PrimaryFilesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Uid="PowerScripts_RunAddFile"
                                            AutomationProperties.AutomationId="PowerScriptsRunAddFile"
                                            Click="AddInputFileButton_Click" />
                                    </StackPanel>
                                    <ItemsRepeater ItemsSource="{x:Bind RunModel.Parameters, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="12" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:PowerScriptRunParameter">
                                                <StackPanel Spacing="8">
                                                    <CheckBox
                                                        x:Uid="PowerScripts_RunProvideValue"
                                                        AutomationProperties.AutomationId="{x:Bind ControlId('Provide')}"
                                                        IsChecked="{x:Bind IsProvided, Mode=TwoWay}"
                                                        Visibility="{x:Bind views:PowerScriptSettingsPage.BoolToVisibility(CanOmit), Mode=OneWay}" />
                                                    <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind IsProvided, Mode=OneWay}">
                                                        <StackPanel Spacing="8">
                                                            <TextBox
                                                                AutomationProperties.AutomationId="{x:Bind ControlId('Text')}"
                                                                Header="{x:Bind DisplayLabel}"
                                                                Text="{x:Bind TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Visibility="{x:Bind views:PowerScriptSettingsPage.BoolToVisibility(IsText), Mode=OneWay}" />
                                                            <ToggleSwitch
                                                                AutomationProperties.AutomationId="{x:Bind ControlId('Boolean')}"
                                                                Header="{x:Bind DisplayLabel}"
                                                                IsOn="{x:Bind BooleanValue, Mode=TwoWay}"
                                                                Visibility="{x:Bind views:PowerScriptSettingsPage.BoolToVisibility(IsBoolean), Mode=OneWay}" />
                                                            <ComboBox
                                                                HorizontalAlignment="Stretch"
                                                                AutomationProperties.AutomationId="{x:Bind ControlId('Choice')}"
                                                                Header="{x:Bind DisplayLabel}"
                                                                ItemsSource="{x:Bind Options}"
                                                                SelectedItem="{x:Bind TextValue, Mode=TwoWay}"
                                                                Visibility="{x:Bind views:PowerScriptSettingsPage.BoolToVisibility(IsChoice), Mode=OneWay}" />
                                                            <StackPanel Spacing="4" Visibility="{x:Bind views:PowerScriptSettingsPage.BoolToVisibility(IsFile), Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind DisplayLabel}" />
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox
                                                                        AutomationProperties.AutomationId="{x:Bind ControlId('File')}"
                                                                        AutomationProperties.Name="{x:Bind DisplayLabel}"
                                                                        Text="{x:Bind TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <Button
                                                                        x:Uid="PowerScripts_RunBrowse"
                                                                        Grid.Column="1"
                                                                        AutomationProperties.AutomationId="{x:Bind ControlId('Browse')}"
                                                                        Click="BrowseParameterFileButton_Click"
                                                                        Tag="{x:Bind}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ContentControl>
                                                    <TextBlock
                                                        Style="{StaticResource HintTextStyle}"
                                                        Text="{x:Bind Description}"
                                                        Visibility="{x:Bind views:PowerScriptSettingsPage.BoolToVisibility(HasDescription), Mode=OneWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </ContentControl>
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind RunModel.ValidationError, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind RunModel.HasValidationError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    MinWidth="96"
                                    AutomationProperties.AutomationId="PowerScriptsRunNow"
                                    Click="RunNowButton_Click"
                                    IsEnabled="{x:Bind RunModel.CanRun, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <TextBlock x:Uid="PowerScripts_Script_Run" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Uid="PowerScripts_RunCancel"
                                    AutomationProperties.AutomationId="PowerScriptsRunCancel"
                                    Click="CancelRunButton_Click"
                                    Visibility="{x:Bind RunModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{x:Bind RunModel.IsRunning, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind RunModel.FailureMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind RunModel.HasFailure, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                FontFamily="Cascadia Code, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind RunModel.ExitCode, Mode=OneWay}"
                                Visibility="{x:Bind views:PowerScriptSettingsPage.TextVisibility(RunModel.ExitCode), Mode=OneWay}" />
                            <TextBox
                                x:Uid="PowerScripts_RunOutput"
                                MaxHeight="280"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="PowerScriptsRunOutput"
                                IsReadOnly="True"
                                Text="{x:Bind RunModel.Output, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind RunModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBox
                                x:Uid="PowerScripts_RunDiagnostics"
                                MaxHeight="200"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="PowerScriptsRunDiagnostics"
                                IsReadOnly="True"
                                Text="{x:Bind RunModel.Diagnostics, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind RunModel.HasDiagnostics, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Border
                                x:Name="ResultPlaceholder"
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <TextBlock
                                    x:Uid="PowerScripts_Script_ResultPlaceholder"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource HintTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ScriptCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="PowerScripts_Script_CodeHeading" Style="{StaticResource CardHeadingStyle}" />
                                <tkcontrols:Segmented
                                    x:Name="CodeSwitch"
                                    x:Uid="PowerScripts_Script_CodeView"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="PowerScriptsCodeSwitch"
                                    SelectedIndex="0"
                                    SelectionChanged="CodeSwitch_SelectionChanged">
                                    <tkcontrols:SegmentedItem x:Name="ScriptFileItem" AutomationProperties.AutomationId="PowerScriptsCodeScript" />
                                    <tkcontrols:SegmentedItem AutomationProperties.AutomationId="PowerScriptsCodeMetadata" Content="tool.json" />
                                </tkcontrols:Segmented>
                                <Button
                                    x:Name="CodeEditButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="PowerScriptsEditScript"
                                    Click="CodeEditButton_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                        <TextBlock x:Uid="PowerScripts_Script_CodeEdit" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox
                                x:Name="SourceText"
                                AutomationProperties.AutomationId="PowerScriptsSourceCode"
                                Style="{StaticResource CodeTextBoxStyle}" />
                            <TextBox
                                x:Name="MetadataText"
                                AutomationProperties.AutomationId="PowerScriptsMetadata"
                                Style="{StaticResource CodeTextBoxStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="SidePanel"
                    Grid.Column="1"
                    Spacing="16">
                    <Border Style="{StaticResource SideCardStyle}">
                        <StackPanel>
                            <TextBlock
                                x:Uid="PowerScripts_NewScript_PlacesHeading"
                                Margin="16,14,16,6"
                                Style="{StaticResource CardHeadingStyle}" />
                            <ItemsControl
                                AutomationProperties.AutomationId="PowerScriptsScriptPlaces"
                                IsTabStop="False"
                                ItemTemplate="{StaticResource PreviewRowTemplate}"
                                ItemsPanel="{StaticResource RowsPanel}"
                                ItemsSource="{x:Bind Places}" />
                            <StackPanel
                                x:Name="PlacesEmpty"
                                Padding="16,8,16,14"
                                Orientation="Horizontal"
                                Spacing="12"
                                Visibility="Collapsed">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock x:Uid="PowerScripts_NewScript_PlacesEmpty" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                            <Expander
                                x:Name="UnavailableExpander"
                                x:Uid="PowerScripts_NewScript_Unavailable"
                                Margin="8,4,8,8"
                                Padding="0,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="PowerScriptsScriptUnavailable">
                                <ItemsControl
                                    IsTabStop="False"
                                    ItemTemplate="{StaticResource PreviewRowTemplate}"
                                    ItemsPanel="{StaticResource RowsPanel}"
                                    ItemsSource="{x:Bind UnavailablePlaces}" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SideCardStyle}">
                        <StackPanel Padding="0,0,0,6">
                            <TextBlock
                                x:Uid="PowerScripts_Script_SafetyHeading"
                                Margin="16,14,16,6"
                                Style="{StaticResource CardHeadingStyle}" />
                            <Grid
                                MinHeight="52"
                                Padding="16,8"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="TrustIcon"
                                    FontSize="16"
                                    Glyph="&#xEA18;" />
                                <TextBlock
                                    x:Name="TrustText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="PowerScriptsScriptTrust"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="16,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="16" Glyph="&#xE72E;" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock x:Uid="PowerScripts_Script_Sandbox" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding ExecutionPolicyDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="16,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="16" Glyph="&#xE943;" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock Text="{Binding RuntimeDisplay, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding ExecutionSummary, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding ExecutionBlockedReason, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasExecutionBlock, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                x:Name="CapabilitiesRow"
                                MinHeight="52"
                                Padding="16,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                ColumnSpacing="12"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="16" Glyph="&#xE946;" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock x:Uid="PowerScripts_Script_Capabilities" />
                                    <TextBlock x:Name="CapabilitiesText" Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SideCardStyle}">
                        <StackPanel>
                            <Grid Margin="16,10,8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="PowerScripts_Script_RecentHeading" Style="{StaticResource CardHeadingStyle}" />
                                <Button
                                    x:Name="SeeAllButton"
                                    x:Uid="PowerScripts_Script_SeeAll"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="PowerScriptsScriptSeeAllRuns"
                                    Click="SeeAll_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <ItemsControl
                                AutomationProperties.AutomationId="PowerScriptsScriptRecentRuns"
                                IsTabStop="False"
                                ItemTemplate="{StaticResource RecentRunTemplate}"
                                ItemsPanel="{StaticResource RowsPanel}"
                                ItemsSource="{x:Bind RecentRuns}" />
                            <TextBlock
                                x:Name="RecentEmpty"
                                x:Uid="PowerScripts_Script_NotRun"
                                Margin="16,4,16,14"
                                Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SideCardStyle}">
                        <StackPanel Padding="0,0,0,14" Spacing="4">
                            <Grid Margin="16,10,8,2" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="PowerScripts_Script_FilesHeading" Style="{StaticResource CardHeadingStyle}" />
                                <Button
                                    x:Uid="PowerScripts_Script_CopyPath"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="PowerScriptsScriptCopyPath"
                                    Click="CopyPath_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                </Button>
                                <Button
                                    x:Uid="PowerScripts_Script_OpenFolder"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="PowerScriptsScriptOpenFolder"
                                    Click="OpenScriptFolderButton_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Margin="16,0"
                                AutomationProperties.AutomationId="PowerScriptsScriptFolderPath"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding FolderPath, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="FileNames"
                                Margin="16,0"
                                FontFamily="Cascadia Code, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
