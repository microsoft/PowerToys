<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)src\Common.Dotnet.CsWinRT.props" />
  <Import Project="$(RepoRoot)src\Common.SelfContained.props" />
  <PropertyGroup>
    <AssemblyName>PowerToys.PowerScripts.UI</AssemblyName>
    <RootNamespace>PowerScripts.UI</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <ProjectPriFileName>PowerToys.PowerScripts.UI.pri</ProjectPriFileName>
    <OutputPath>$(RepoRoot)$(Platform)\$(Configuration)\WinUI3Apps</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <ProjectReference Include="$(RepoRoot)src\common\ManagedCommon\ManagedCommon.csproj" />
    <ProjectReference Include="$(RepoRoot)src\settings-ui\Settings.UI.Library\Settings.UI.Library.csproj" />
    <ProjectReference Include="..\..\PowerScripts.Client\PowerScripts.Client.csproj" />
    <InternalsVisibleTo Include="Settings.UI.UnitTests" />
  </ItemGroup>
</Project>
