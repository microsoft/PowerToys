<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RobocopyUI.OptionEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RobocopyUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkconverters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

    <Grid>
        <CheckBox x:Name="OptionEnabledCheckBox">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OptionName}" Margin="0,0,8,0" FontFamily="Cascadia Mono" />
                <TextBlock Text="{Binding OptionDescription}" />
                <TextBox x:Name="OptionTextValue" Width="400" Visibility="{Binding IsTextOption, Converter={StaticResource BoolToVisibilityConverter}}" />
                <NumberBox x:Name="OptionNumberValue" Width="100" Value="0" Minimum="0" SpinButtonPlacementMode="Compact" Visibility="{Binding IsNumberOption, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ComboBox x:Name="StorageUnitComboBox" Visibility="{Binding IsStorageOption, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBoxItem Content="KB" IsSelected="True" />
                    <ComboBoxItem Content="MB" />
                    <ComboBoxItem Content="GB" />
                </ComboBox>
                <Button x:Name="SelectOptionsButton" Content="Select Options" Visibility="{Binding IsMultiSelectOption, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <ItemsControl ItemsSource="{x:Bind MultiSelectOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:OptionEntry">
                                        <ContentPresenter Content="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunHoursOption, Converter={StaticResource BoolToVisibilityConverter}}">
                    <NumberBox Width="40" PlaceholderText="hh" Minimum="0" Maximum="23" x:Name="StartHourNumberBox" />
                    <NumberBox Width="40" PlaceholderText="mm" Minimum="0" Maximum="59" x:Name="StartMinuteNumberBox" />
                    <TextBlock>-</TextBlock>
                    <NumberBox Width="40" PlaceholderText="hh" Minimum="0" Maximum="23" x:Name="EndHourNumberBox" />
                    <NumberBox Width="40" PlaceholderText="mm" Minimum="0" Maximum="59" x:Name="EndMinuteNumberBox" />
                </StackPanel>
            </StackPanel>
        </CheckBox>
    </Grid>
</UserControl>
