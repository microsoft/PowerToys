<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="RobocopyUI.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RobocopyUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:RobocopyUI.Controls"
    xmlns:models="using:RobocopyUI.Models"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="OptionDataTemplate" x:DataType="models:OptionContent">
                <controls:OptionEntry
                    Loaded="OptionEntry_Loaded"
                    Unloaded="OptionEntry_Unloaded"
                    OptionName="{x:Bind OptionName}"
                    OptionDescription="{x:Bind OptionDescription}"
                    IsNumberOption="{x:Bind IsNumberOption}"
                    IsMultiSelectOption="{x:Bind IsMultiSelectOption}"
                    MultiSelectOptions="{x:Bind MultiSelectOptions}"
                    IsRunHoursOption="{x:Bind IsRunHoursOption}"
                    IsStorageOption="{x:Bind IsStorageOption}"
                    IsTextOption="{x:Bind IsTextOption}" />
            </DataTemplate>

            <DataTemplate x:Key="OptionGroupStyleHeaderTemplate">
                <TextBlock Text="{Binding Key}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,4" />
            </DataTemplate>

            <GroupStyle x:Key="OptionsGroupStyle" HeaderTemplate="{StaticResource OptionGroupStyleHeaderTemplate}"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,0">
            <TextBlock x:Uid="HomePageTitle" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <tkcontrols:Segmented
                x:Name="ModeSegmented"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                SelectionChanged="ModeSegmented_SelectionChanged">
                <tkcontrols:SegmentedItem
                    x:Name="SimpleModeSegmentedItem"
                    x:Uid="SimpleModeSegmentedItem"
                    AutomationProperties.AutomationId="SimpleModeSegmentedItem" />
                <tkcontrols:SegmentedItem
                    x:Name="AdvancedModeSegmentedItem"
                    x:Uid="AdvancedModeSegmentedItem"
                    AutomationProperties.AutomationId="AdvancedModeSegmentedItem" />
            </tkcontrols:Segmented>
        </Grid>

        <Grid x:Name="InputOutputPanel" Margin="12,12,12,0" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Uid="SourceLabel" Grid.Column="0" Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="DestinationLabel" Grid.Column="3" Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBox x:Name="SourceTextBox" Margin="0,0,4,0" Grid.Column="0" Grid.Row="1" TextChanged="SourceDestTextBox_TextChanged" />
            <Button x:Name="SourceBrowseButton" x:Uid="SourceBrowseButton" Margin="0,0,4,0" Grid.Column="1" Grid.Row="1" Click="SourceBrowseButton_Click">
                <FontIcon Glyph="&#xE8B7;" />
            </Button>
            <Button x:Name="SwapButton" x:Uid="SwapButton" Margin="4,0,4,0" Grid.Column="2" Grid.Row="1" Click="SwapButton_Click">
                <FontIcon Glyph="&#xE8AB;" />
            </Button>
            <TextBox x:Name="DestinationTextBox" Margin="4,0,4,0" Grid.Column="3" Grid.Row="1" TextChanged="SourceDestTextBox_TextChanged" />
            <Button x:Name="DestinationBrowseButton" x:Uid="DestinationBrowseButton" Margin="0,0,0,0" Grid.Column="4" Grid.Row="1" Click="DestinationBrowseButton_Click">
                <FontIcon Glyph="&#xE8B7;" />
            </Button>
            <Button x:Name="AIAssistButton" x:Uid="AIAssistButton" Margin="8,0,0,0" Grid.Column="5" Grid.Row="1" Click="AIAssistButton_Click">
                <FontIcon Glyph="&#xE945;" />
            </Button>
        </Grid>

        <Grid x:Name="CommandPreviewPanel" Margin="12" ColumnSpacing="5" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandPreviewTextBox" x:Uid="CommandPreviewTextBox" Width="Auto" Height="Auto" IsReadOnly="True" IsEnabled="False" TextWrapping="Wrap" />
            <Button VerticalAlignment="Bottom" Grid.Column="1">
                <Button.Content>
                    <FontIcon Glyph="&#xE712;" />
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="LoadButtonLabel" Click="LoadOptionsButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDE2;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="SaveButtonLabel"  Click="SaveOptionsButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDE1;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <SplitButton Style="{StaticResource AccentSplitButtonStyle}" Click="RunButton_Click" x:Name="RunButton" IsEnabled="False" VerticalAlignment="Bottom" Grid.Column="2">
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="RunExternalButton" Click="RunExternalButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE756;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE768;" />
                    <TextBlock Margin="4,0,0,0" x:Uid="RunButtonLabel"  />
                </StackPanel>
            </SplitButton>
        </Grid>

        <SelectorBar x:Name="AdvancedSelectorBar" SelectionChanged="SelectorBar_SelectionChanged" Grid.Row="3" Visibility="Collapsed">
            <SelectorBar.Resources>
                <x:Double x:Key="SelectorBarItemPillWidth">18</x:Double>
            </SelectorBar.Resources>
            <SelectorBarItem x:Uid="OptionsSelectorBarLabel" Tag="Options" IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE762;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="FiltersSelectorBarLabel" Tag="Filters">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE71C;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="LoggingSelectorBarLabel" Tag="Logging">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE9F9;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="AdvancedSelectorBarLabel" Tag="Advanced">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <ScrollViewer x:Name="SimpleContent" Grid.Row="4" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0" Spacing="12">
                <RadioButtons
                    x:Name="SimpleJobRadioButtons"
                    x:Uid="SimpleJobRadioButtons"
                    AutomationProperties.AutomationId="SimpleJobRadioButtons"
                    MaxColumns="1"
                    SelectionChanged="SimpleJobRadioButtons_SelectionChanged">
                    <RadioButton
                        x:Uid="SimpleJobCopyFolders"
                        AutomationProperties.AutomationId="SimpleJobCopyFolders"
                        IsChecked="True"
                        Tag="CopyFilesAndFolders" />
                    <RadioButton
                        x:Uid="SimpleJobSkipEmpty"
                        AutomationProperties.AutomationId="SimpleJobSkipEmpty"
                        Tag="CopySkipEmptyFolders" />
                    <RadioButton
                        x:Uid="SimpleJobThisFolder"
                        AutomationProperties.AutomationId="SimpleJobThisFolder"
                        Tag="CopyThisFolderOnly" />
                    <RadioButton
                        x:Uid="SimpleJobMirror"
                        AutomationProperties.AutomationId="SimpleJobMirror"
                        Tag="Mirror" />
                    <RadioButton
                        x:Uid="SimpleJobMoveEverything"
                        AutomationProperties.AutomationId="SimpleJobMoveEverything"
                        Tag="MoveEverything" />
                    <RadioButton
                        x:Uid="SimpleJobMoveFiles"
                        AutomationProperties.AutomationId="SimpleJobMoveFiles"
                        Tag="MoveFilesOnly" />
                </RadioButtons>

                <InfoBar
                    x:Name="SimpleWarningInfoBar"
                    x:Uid="SimpleWarningInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning" />

                <TextBlock
                    x:Name="SimpleAdditionalOptionsText"
                    x:Uid="SimpleAdditionalOptionsText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <ToggleSwitch
                    x:Name="SimpleKeepPermissionsToggle"
                    x:Uid="SimpleKeepPermissionsToggle"
                    AutomationProperties.AutomationId="SimpleKeepPermissionsToggle"
                    Toggled="SimpleOptions_Changed" />
                <ToggleSwitch
                    x:Name="SimpleKeepAllPropertiesToggle"
                    x:Uid="SimpleKeepAllPropertiesToggle"
                    AutomationProperties.AutomationId="SimpleKeepAllPropertiesToggle"
                    Toggled="SimpleOptions_Changed" />
                <ToggleSwitch
                    x:Name="SimpleSkipNewerToggle"
                    x:Uid="SimpleSkipNewerToggle"
                    AutomationProperties.AutomationId="SimpleSkipNewerToggle"
                    Toggled="SimpleOptions_Changed" />

                <TextBox
                    x:Name="SimpleExcludeFilesTextBox"
                    x:Uid="SimpleExcludeFilesTextBox"
                    AutomationProperties.AutomationId="SimpleExcludeFilesTextBox"
                    TextChanged="SimpleOptions_TextChanged" />
                <TextBox
                    x:Name="SimpleExcludeFoldersTextBox"
                    x:Uid="SimpleExcludeFoldersTextBox"
                    AutomationProperties.AutomationId="SimpleExcludeFoldersTextBox"
                    TextChanged="SimpleOptions_TextChanged" />

                <ToggleSwitch
                    x:Name="SimpleCopyFasterToggle"
                    x:Uid="SimpleCopyFasterToggle"
                    AutomationProperties.AutomationId="SimpleCopyFasterToggle"
                    Toggled="SimpleCopyFasterToggle_Toggled" />
                <NumberBox
                    x:Name="SimpleThreadCountNumberBox"
                    x:Uid="SimpleThreadCountNumberBox"
                    AutomationProperties.AutomationId="SimpleThreadCountNumberBox"
                    Minimum="1"
                    Maximum="128"
                    SpinButtonPlacementMode="Compact"
                    Value="8"
                    Visibility="Collapsed"
                    ValueChanged="SimpleNumberBox_ValueChanged" />

                <ToggleSwitch
                    x:Name="SimpleRetryToggle"
                    x:Uid="SimpleRetryToggle"
                    AutomationProperties.AutomationId="SimpleRetryToggle"
                    Toggled="SimpleRetryToggle_Toggled" />
                <StackPanel x:Name="SimpleRetryPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <NumberBox
                        x:Name="SimpleRetryCountNumberBox"
                        x:Uid="SimpleRetryCountNumberBox"
                        AutomationProperties.AutomationId="SimpleRetryCountNumberBox"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        Value="3"
                        Width="160"
                        ValueChanged="SimpleNumberBox_ValueChanged" />
                    <NumberBox
                        x:Name="SimpleRetryWaitNumberBox"
                        x:Uid="SimpleRetryWaitNumberBox"
                        AutomationProperties.AutomationId="SimpleRetryWaitNumberBox"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        Value="5"
                        Width="160"
                        ValueChanged="SimpleNumberBox_ValueChanged" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="SimplePreviewToggle"
                    x:Uid="SimplePreviewToggle"
                    AutomationProperties.AutomationId="SimplePreviewToggle"
                    Toggled="SimpleOptions_Changed" />

                <ToggleSwitch
                    x:Name="SimpleLogToggle"
                    x:Uid="SimpleLogToggle"
                    AutomationProperties.AutomationId="SimpleLogToggle"
                    Toggled="SimpleLogToggle_Toggled" />
                <Grid x:Name="SimpleLogPanel" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SimpleLogPathTextBox"
                        x:Uid="SimpleLogPathTextBox"
                        AutomationProperties.AutomationId="SimpleLogPathTextBox"
                        TextChanged="SimpleOptions_TextChanged" />
                    <Button
                        x:Name="SimpleLogBrowseButton"
                        x:Uid="SimpleLogBrowseButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="SimpleLogBrowseButton"
                        Click="SimpleLogBrowseButton_Click">
                        <FontIcon Glyph="&#xE8B7;" />
                    </Button>
                </Grid>

                <HyperlinkButton
                    x:Name="CustomizeInAdvancedButton"
                    x:Uid="CustomizeInAdvancedButton"
                    AutomationProperties.AutomationId="CustomizeInAdvancedButton"
                    Click="CustomizeInAdvancedButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SelectorPanels" Grid.Row="4">
            <Grid Margin="0,12,0,0">
                <Grid x:Name="OptionsContent" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="OptionsListView" ItemTemplate="{StaticResource OptionDataTemplate}" SelectionMode="None" IsItemClickEnabled="False" Grid.Column="0">
                        <ListView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource OptionGroupStyleHeaderTemplate}"/>
                        </ListView.GroupStyle>
                    </ListView>
                    <ListView x:Name="OptionsListViewRight"  ItemTemplate="{StaticResource OptionDataTemplate}" SelectionMode="None" IsItemClickEnabled="False" Grid.Column="1" >
                        <ListView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource OptionGroupStyleHeaderTemplate}"/>
                        </ListView.GroupStyle>
                    </ListView>
                </Grid>
                <Grid x:Name="FiltersContent" Visibility="Collapsed">
                    <ListView x:Name="FilterOptionsListView" ItemTemplate="{StaticResource OptionDataTemplate}" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource OptionGroupStyleHeaderTemplate}"/>
                        </ListView.GroupStyle>
                    </ListView>
                </Grid>
                <Grid x:Name="LoggingContent" Visibility="Collapsed">
                    <ListView x:Name="LoggingOptionsListView" ItemTemplate="{StaticResource OptionDataTemplate}" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource OptionGroupStyleHeaderTemplate}"/>
                        </ListView.GroupStyle>
                    </ListView>
                </Grid>
                <Grid x:Name="AdvancedContent" Visibility="Collapsed">
                    <ListView x:Name="AdvancedOptionsListView" ItemTemplate="{StaticResource OptionDataTemplate}" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource OptionGroupStyleHeaderTemplate}"/>
                        </ListView.GroupStyle>
                    </ListView>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Expander x:Name="CommandOutputExpander" IsEnabled="False" Margin="12" Grid.Row="5" HorizontalAlignment="Stretch">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock x:Uid="OutputStatusLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock>&#160;</TextBlock>
                    <TextBlock x:Name="OutputStatusText" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock>&#160;</TextBlock>
                    <TextBlock>(</TextBlock>
                    <TextBlock x:Uid="StatusCodeLabel" />
                    <TextBlock>&#160;</TextBlock>
                    <TextBlock x:Name="StatusCodeText" Style="{StaticResource BodyTextBlockStyle}">-</TextBlock>
                    <TextBlock>)</TextBlock>
                </StackPanel>
            </Expander.Header>
            <TextBox x:Name="OutputTextBox" Width="Auto" MinHeight="200" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Cascadia Mono" />
        </Expander>
    </Grid>
</Page>
