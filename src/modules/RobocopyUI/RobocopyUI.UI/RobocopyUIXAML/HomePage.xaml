<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="RobocopyUI.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RobocopyUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:RobocopyUI.Controls"
    xmlns:models="using:RobocopyUI.Models"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="12">
            <TextBlock Margin="4" x:Uid="HomePageTitle" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <StackPanel Margin="12">
                <Grid Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="SourceLabel" Grid.Column="0" Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="DestinationLabel" Grid.Column="3" Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox Margin="0,0,4,0" x:Name="SourceTextBox" Grid.Column="0" Grid.Row="1" TextChanged="SourceTextBox_TextChanged" />
                    <Button Margin="0,0,4,0" x:Uid="SourceBrowseButton" x:Name="SourceBrowseButton" Grid.Column="1" Grid.Row="1" Click="SourceBrowseButton_Click">
                        <FontIcon Glyph="&#xE8B7;" />
                    </Button>
                    <Button Margin="4,0,4,0" x:Uid="SwapButton" x:Name="SwapButton" Grid.Column="2" Grid.Row="1" Click="SwapButton_Click">
                        <FontIcon Glyph="&#xE8AB;" />
                    </Button>
                    <TextBox Margin="4,0,4,0" x:Name="DestinationTextBox" Grid.Column="3" Grid.Row="1" TextChanged="SourceTextBox_TextChanged" />
                    <Button Margin="0,0,0,0" x:Uid="DestinationBrowseButton" Grid.Column="4" Grid.Row="1" x:Name="DestinationBrowseButton" Click="DestinationBrowseButton_Click">
                        <FontIcon Glyph="&#xE8B7;" />
                    </Button>
                </Grid>
                <SelectorBar SelectionChanged="SelectorBar_SelectionChanged">
                    <SelectorBar.Resources>
                        <x:Double x:Key="SelectorBarItemPillWidth">15</x:Double>
                    </SelectorBar.Resources>
                    <SelectorBarItem x:Uid="OptionsSelectorBarLabel" Tag="Options" IsSelected="True">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE762;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Uid="FiltersSelectorBarLabel" Tag="Filters">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE71C;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Uid="LoggingSelectorBarLabel" Tag="Logging">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE9F9;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Uid="AdvancedSelectorBarLabel" Tag="Advanced">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Uid="CommandPreviewSelectorBarLabel" Tag="CommandPreview">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE756;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Uid="OutputSelectorBarLabel" Tag="Output" x:Name="OutputSelectorBarItem" IsEnabled="False">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
                <Grid x:Name="OptionsContent" Margin="12">
                    <ListView x:Name="OptionsListView" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OptionContent">
                                <controls:OptionEntry
                                    OptionName="{Binding OptionName}"
                                    OptionDescription="{Binding OptionDescription}"
                                    IsNumberOption="{Binding IsNumberOption}"
                                    IsMultiSelectOption="{Binding IsMultiSelectOption}"
                                    MultiSelectOptions="{Binding MultiSelectOptions}"
                                    IsRunHoursOption="{Binding IsRunHoursOption}"
                                    IsStorageOption="{Binding IsStorageOption}"
                                    IsTextOption="{Binding IsTextOption}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Grid x:Name="FiltersContent" Margin="12">
                    <StackPanel>
                        <TextBlock x:Uid="FileSelectionOptionsLabel" Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
                        <ListView x:Name="FilterOptionsListView" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:OptionContent">
                                    <controls:OptionEntry
                                        OptionName="{x:Bind OptionName}"
                                        OptionDescription="{Binding OptionDescription}"
                                        IsNumberOption="{Binding IsNumberOption}"
                                        IsMultiSelectOption="{Binding IsMultiSelectOption}"
                                        MultiSelectOptions="{Binding MultiSelectOptions}"
                                        IsRunHoursOption="{Binding IsRunHoursOption}"
                                        IsStorageOption="{Binding IsStorageOption}"
                                        IsTextOption="{Binding IsTextOption}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
                <Grid x:Name="LoggingContent" Margin="12">
                    <ListView x:Name="LoggingOptionsListView" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OptionContent">
                                <controls:OptionEntry
                                    OptionName="{Binding OptionName}"
                                    OptionDescription="{Binding OptionDescription}"
                                    IsNumberOption="{Binding IsNumberOption}"
                                    IsMultiSelectOption="{Binding IsMultiSelectOption}"
                                    MultiSelectOptions="{Binding MultiSelectOptions}"
                                    IsRunHoursOption="{Binding IsRunHoursOption}"
                                    IsStorageOption="{Binding IsStorageOption}"
                                    IsTextOption="{Binding IsTextOption}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Grid x:Name="AdvancedContent" Margin="12">
                    <ListView x:Name="AdvancedOptionsListView" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OptionContent">
                                <controls:OptionEntry
                                    OptionName="{Binding OptionName}"
                                    OptionDescription="{Binding OptionDescription}"
                                    IsNumberOption="{Binding IsNumberOption}"
                                    IsMultiSelectOption="{Binding IsMultiSelectOption}"
                                    MultiSelectOptions="{Binding MultiSelectOptions}"
                                    IsRunHoursOption="{Binding IsRunHoursOption}"
                                    IsStorageOption="{Binding IsStorageOption}"
                                    IsTextOption="{Binding IsTextOption}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Grid x:Name="CommandPreviewContent" Margin="12" Visibility="Collapsed">
                    <TextBox x:Name="CommandPreviewTextBox" Width="Auto" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" />
                </Grid>
                <StackPanel x:Name="OutputContent" Margin="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock x:Uid="OutputStatusLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock>&#160;</TextBlock>
                        <TextBlock x:Name="OutputStatusText" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock>&#160;</TextBlock>
                        <TextBlock>(</TextBlock>
                        <TextBlock x:Uid="StatusCodeLabel" />
                        <TextBlock>&#160;</TextBlock>
                        <TextBlock x:Name="StatusCodeText" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock>)</TextBlock>
                    </StackPanel>
                    <TextBox x:Name="OutputTextBox" Width="Auto" MinHeight="200" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Cascadia Mono" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                    <Button Margin="0,12,0,12" Click="SaveButton_Click" x:Name="SaveButton">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE78C;" />
                            <TextBlock Margin="4,0,0,0" x:Uid="SaveButtonLabel" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,12,0,12" Style="{StaticResource AccentButtonStyle}" Click="RunButton_Click" x:Name="RunButton" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE768;" />
                            <TextBlock Margin="4,0,0,0" x:Uid="RunButtonLabel" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
