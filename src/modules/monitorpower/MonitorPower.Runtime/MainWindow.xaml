<Window
    x:Class="MonitorPower.Runtime.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MonitorPower.Runtime"
    Title="Display profile selector">

    <!-- Overlay in stile flyout di Windows 11: sfondo acrilico (impostato da SystemBackdrop), angoli arrotondati, bordo sottile. -->
    <Border
        x:Name="OverlayBorder"
        Background="Transparent"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid Padding="20,18,20,16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">

            <!-- Intestazione: icona + titolo -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    x:Uid="MonitorPower_Selector_Title"
                    Text="Choose a display profile"
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <!-- Elenco profili: riga con nome e sottotitolo, il selezionato ha l'indicatore accento -->
            <ListView
                x:Uid="MonitorPower_Selector_ProfileList"
                x:Name="ProfileList"
                Grid.Row="1"
                SelectionMode="Single"
                AutomationProperties.Name="Display profiles"
                KeyDown="ProfileList_KeyDown">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RuntimeProfile">
                        <StackPanel Padding="4,8" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Messaggi di stato (nascosto quando vuoto) -->
            <TextBlock
                x:Name="StatusText"
                Grid.Row="2"
                Visibility="Collapsed"
                TextWrapping="Wrap"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Piede: suggerimenti dei tasti + Apply -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Apply" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="B" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Close" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74A;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="D-pad / stick" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button
                    x:Uid="MonitorPower_Selector_ApplyButton"
                    x:Name="ApplyButton"
                    Grid.Column="1"
                    Content="Apply"
                    MinWidth="96"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Apply_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
