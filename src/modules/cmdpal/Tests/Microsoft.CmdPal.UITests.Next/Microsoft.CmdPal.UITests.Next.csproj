<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)src\Common.Dotnet.CsWinRT.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Microsoft.CmdPal.UITests</RootNamespace>
    <AssemblyName>Microsoft.CmdPal.UITests.Next</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RunVSTest>false</RunVSTest>
    <!-- SamplePagesExtension is a self-contained exe referenced for build order only. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(RepoRoot)$(Platform)\$(Configuration)\tests\Microsoft.CmdPal.UITests.Next\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\common\UITestAutomation.Next\UITestAutomation.Next.csproj" />

    <!-- Build-order only: stage the generated package for installation by SamplePagesTests. -->
    <ProjectReference Include="..\..\ext\SamplePagesExtension\SamplePagesExtension.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="StageSamplePagesExtensionPackage" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(_IsSkippedTestProject)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\..\ext\SamplePagesExtension\SamplePagesExtension.csproj"
             Targets="GetFixturePackage"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_SamplePagesExtensionPackage" />
    </MSBuild>
    <Copy SourceFiles="@(_SamplePagesExtensionPackage)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)SamplePagesExtension.msix" />
    </ItemGroup>
  </Target>
</Project>
