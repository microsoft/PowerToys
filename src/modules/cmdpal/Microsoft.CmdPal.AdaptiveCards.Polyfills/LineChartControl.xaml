<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Microsoft.CmdPal.UI.Controls.AdaptiveCards.Charts.LineChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    HorizontalAlignment="Stretch"
    IsTabStop="False">

    <Grid x:Name="RootGrid" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PlotRow" Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="TitleText"
            Grid.Row="0"
            Margin="0,0,0,4"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            Visibility="Collapsed" />

        <Grid
            x:Name="HeaderRow"
            Grid.Row="1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="YAxisTitleText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="MaxLabelText"
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Canvas x:Name="PlotCanvas" Grid.Row="2">
            <Path
                x:Name="GridLinesPath"
                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                StrokeThickness="1" />
            <Canvas x:Name="SeriesLayer">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="ScrollTransform" />
                </Canvas.RenderTransform>
            </Canvas>
        </Canvas>

        <Canvas
            x:Name="XLabelsCanvas"
            Grid.Row="3"
            Height="16"
            Visibility="Collapsed" />

        <Grid
            x:Name="FooterRow"
            Grid.Row="4"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="XAxisTitleText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="MinLabelText"
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <toolkit:WrapPanel
            x:Name="LegendPanel"
            Grid.Row="5"
            Margin="0,4,0,0"
            HorizontalSpacing="16"
            VerticalSpacing="4"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
