{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "$when": "${errorMessage != null}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "size": "small"
        }
      ],
      "style": "warning"
    },
    {
      "type": "Container",
      "$when": "${errorMessage == null}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "Chart.Gauge",
                  "value": "${batteryPercent}",
                  "min": 0,
                  "max": 100,
                  "color": "${batteryColor}",
                  "subLabel": "%Battery_Widget_Template/Charge%",
                  "showMinMax": false,
                  "showLegend": false,
                  "fallback": {
                    "type": "TextBlock",
                    "size": "extraLarge",
                    "weight": "bolder",
                    "text": "${batteryCharge}"
                  }
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "spacing": "large",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "Badge",
                  "text": "${batteryStatus}",
                  "style": "${batteryStatusStyle}",
                  "appearance": "tint",
                  "size": "large",
                  "fallback": {
                    "type": "TextBlock",
                    "weight": "bolder",
                    "text": "${batteryStatus}"
                  }
                },
                {
                  "type": "TextBlock",
                  "$when": "${batteryTimeRemaining != ''}",
                  "isSubtle": true,
                  "size": "small",
                  "spacing": "medium",
                  "text": "%Battery_Widget_Template/TimeRemaining%"
                },
                {
                  "type": "TextBlock",
                  "$when": "${batteryTimeRemaining != ''}",
                  "size": "large",
                  "spacing": "none",
                  "wrap": true,
                  "text": "${batteryTimeRemaining}"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "medium",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "$when": "${batteryRate != null}",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "${batteryRateLabel}"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${batteryRate}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "$when": "${batteryHealth != null}",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Battery_Widget_Template/Health%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${batteryHealth}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "$when": "${batteryFullCapacity != null}",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Battery_Widget_Template/Full_Charge_Capacity%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${batteryFullCapacity}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
