{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "$when": "${errorMessage != null}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "size": "small"
        }
      ],
      "style": "warning"
    },
    {
      "type": "Container",
      "$when": "${errorMessage == null}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "text": "%Memory_Widget_Template/InUse%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "text": "${usedMem}"
                },
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "spacing": "none",
                  "text": "${memUsageOfTotal}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "horizontalAlignment": "right",
                  "text": "%Memory_Widget_Template/Available%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "horizontalAlignment": "right",
                  "text": "${availableMem}"
                }
              ]
            }
          ]
        },
        {
          "type": "Chart.Line",
          "spacing": "medium",
          "yAxisTitle": "%Memory_Widget_Template/Chart_Y_Axis%",
          "xAxisTitle": "%CPUUsage_Widget_Template/Chart_X_Axis%",
          "yMin": 0,
          "yMax": 100,
          "valueFormat": "percentage",
          "fill": "gradient",
          "data": "${memSeries}",
          "fallback": "drop"
        },
        {
          "type": "Chart.HorizontalBar.Stacked",
          "spacing": "medium",
          "title": "%Memory_Widget_Template/Composition%",
          "data": "${memComposition}",
          "fallback": "drop"
        },
        {
          "type": "ColumnSet",
          "spacing": "medium",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Memory_Widget_Template/Committed%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${committedMem} / ${committedLimitMem}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Memory_Widget_Template/Cached%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${cachedMem}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Memory_Widget_Template/PagedPool%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${pagedPoolMem}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Memory_Widget_Template/NonPagedPool%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${nonPagedPoolMem}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "$when": "${memSlots != null || memReserved != null}",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "$when": "${memSpeed != null}",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "height": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Memory_Widget_Template/Speed%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "medium",
                      "spacing": "none",
                      "text": "${memSpeed}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "$when": "${memSlots != null}",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "height": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Memory_Widget_Template/Slots_Used%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "medium",
                      "spacing": "none",
                      "text": "${memSlots}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "$when": "${memFormFactor != null}",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "height": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Memory_Widget_Template/Form_Factor%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "medium",
                      "spacing": "none",
                      "text": "${memFormFactor}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "$when": "${memReserved != null}",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "height": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%Memory_Widget_Template/Hardware_Reserved%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "medium",
                      "spacing": "none",
                      "text": "${memReserved}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
