{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "$when": "${errorMessage != null}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "size": "small"
        }
      ],
      "style": "warning"
    },
    {
      "type": "Container",
      "$when": "${errorMessage == null}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "text": "%DiskUsage_Widget_Template/Disk_Usage%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "text": "${diskUsage}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "horizontalAlignment": "right",
                  "text": "%DiskUsage_Widget_Template/Read%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "horizontalAlignment": "right",
                  "text": "${diskRead}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "spacing": "large",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "horizontalAlignment": "right",
                  "text": "%DiskUsage_Widget_Template/Write%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "horizontalAlignment": "right",
                  "text": "${diskWrite}"
                }
              ]
            }
          ]
        },
        {
          "type": "Chart.Line",
          "spacing": "medium",
          "yAxisTitle": "${diskChartAxis}",
          "xAxisTitle": "%CPUUsage_Widget_Template/Chart_X_Axis%",
          "yMin": 0,
          "fill": "gradient",
          "data": "${diskSeries}",
          "fallback": "drop"
        },
        {
          "type": "TextBlock",
          "spacing": "medium",
          "weight": "bolder",
          "text": "${diskDisplayName}"
        },
        {
          "type": "Container",
          "$data": "${volumes}",
          "spacing": "small",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "size": "small",
                      "text": "${name}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "horizontalAlignment": "right",
                      "text": "${freeText}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "ProgressBar",
              "spacing": "small",
              "value": "${usedPercent}",
              "color": "${color}",
              "fallback": "drop"
            }
          ]
        }
      ]
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
