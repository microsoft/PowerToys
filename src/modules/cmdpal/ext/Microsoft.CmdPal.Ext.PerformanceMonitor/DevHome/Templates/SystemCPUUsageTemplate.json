{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "$when": "${errorMessage != null}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "size": "small"
        }
      ],
      "style": "warning"
    },
    {
      "type": "Container",
      "$when": "${errorMessage == null}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "text": "%CPUUsage_Widget_Template/CPU_Usage%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "text": "${cpuUsage}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "horizontalAlignment": "right",
                  "text": "%CPUUsage_Widget_Template/CPU_Speed%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "horizontalAlignment": "right",
                  "text": "${cpuSpeed}"
                }
              ]
            }
          ]
        },
        {
          "type": "Chart.Line",
          "spacing": "medium",
          "yAxisTitle": "%CPUUsage_Widget_Template/Chart_Y_Axis%",
          "xAxisTitle": "%CPUUsage_Widget_Template/Chart_X_Axis%",
          "yMin": 0,
          "yMax": 100,
          "showLegend": false,
          "data": "${cpuSeries}",
          "fallback": "drop"
        },
        {
          "type": "TextBlock",
          "$when": "${cpuName != ''}",
          "spacing": "medium",
          "isSubtle": true,
          "wrap": true,
          "text": "${cpuName}"
        },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%CPUUsage_Widget_Template/Processes%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${cpuProcesses}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%CPUUsage_Widget_Template/Threads%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${cpuThreads}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%CPUUsage_Widget_Template/Handles%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${cpuHandles}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%CPUUsage_Widget_Template/Up_Time%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${cpuUptime}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%CPUUsage_Widget_Template/Base_Speed%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${cpuBaseSpeed}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%CPUUsage_Widget_Template/Logical_Processors%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${cpuLogicalProcessors}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Container",
          "$when": "${count(cpuTopProcesses) > 0}",
          "spacing": "small",
          "style": "emphasis",
          "roundedCorners": true,
          "showBorder": true,
          "items": [
            {
              "type": "TextBlock",
              "text": "%CPUUsage_Widget_Template/Top_Processes%",
              "weight": "bolder",
              "wrap": true
            },
            {
              "type": "ColumnSet",
              "$data": "${cpuTopProcesses}",
              "spacing": "small",
              "columns": [
                {
                  "type": "Column",
                  "width": 30,
                  "verticalContentAlignment": "center",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${name}",
                      "isSubtle": true
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": 55,
                  "verticalContentAlignment": "center",
                  "items": [
                    {
                      "type": "ProgressBar",
                      "value": "${percent}",
                      "fallback": "drop"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": 15,
                  "verticalContentAlignment": "center",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${text}",
                      "weight": "bolder",
                      "horizontalAlignment": "right"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Container",
          "$when": "${count(cpuCores) > 0}",
          "spacing": "small",
          "style": "emphasis",
          "roundedCorners": true,
          "showBorder": true,
          "items": [
            {
              "type": "Chart.VerticalBar",
              "title": "%CPUUsage_Widget_Template/Cores_Chart_Title%",
              "showTitle": true,
              "yAxisTitle": "%CPUUsage_Widget_Template/Chart_Y_Axis%",
              "yMin": 0,
              "yMax": 100,
              "color": "categoricalBlue",
              "data": "${cpuCores}",
              "fallback": "drop"
            }
          ]
        }
      ]
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
