{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "$when": "${errorMessage != null}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "size": "small"
        }
      ],
      "style": "warning"
    },
    {
      "type": "Container",
      "$when": "${errorMessage == null}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "text": "%GPUUsage_Widget_Template/GPU_Usage%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "text": "${gpuUsage}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "$when": "${gpuMemory != null}",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "horizontalAlignment": "right",
                  "text": "${gpuMemoryLabel}"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "horizontalAlignment": "right",
                  "text": "${gpuMemory}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "$when": "${gpuTemp != '--'}",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "horizontalAlignment": "right",
                  "text": "%GPUUsage_Widget_Template/GPU_Temperature%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "horizontalAlignment": "right",
                  "text": "${gpuTemp}"
                }
              ]
            }
          ]
        },
        {
          "type": "Chart.Line",
          "spacing": "medium",
          "yAxisTitle": "%CPUUsage_Widget_Template/Chart_Y_Axis%",
          "xAxisTitle": "%CPUUsage_Widget_Template/Chart_X_Axis%",
          "yMin": 0,
          "yMax": 100,
          "valueFormat": "percentage",
          "fill": "gradient",
          "data": "${gpuSeries}",
          "fallback": "drop"
        },
        {
          "type": "TextBlock",
          "$when": "${gpuName != ''}",
          "spacing": "medium",
          "isSubtle": true,
          "wrap": true,
          "text": "${gpuName}"
        },
        {
          "type": "ColumnSet",
          "$when": "${count(gpuEngines) > 0}",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "$data": "${gpuEngines}",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "${name}"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${text}"
                    },
                    {
                      "type": "Chart.Line",
                      "style": "sparkline",
                      "spacing": "small",
                      "yMin": 0,
                      "yMax": "${chartMax}",
                      "fill": "gradient",
                      "data": "${series}",
                      "fallback": "drop"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "$when": "${hasDedicatedMemory || hasSharedMemory}",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "$when": "${hasDedicatedMemory}",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%GPUUsage_Widget_Template/Dedicated_Memory%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${gpuDedicatedMemory}"
                    },
                    {
                      "type": "ProgressBar",
                      "spacing": "small",
                      "value": "${gpuDedicatedPercent}",
                      "color": "categoricalGreen",
                      "fallback": "drop"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "$when": "${hasSharedMemory}",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%GPUUsage_Widget_Template/Shared_Memory%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${gpuSharedMemory}"
                    },
                    {
                      "type": "ProgressBar",
                      "spacing": "small",
                      "value": "${gpuSharedPercent}",
                      "color": "categoricalGreen",
                      "fallback": "drop"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
