{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "$when": "${errorMessage != null}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "size": "small"
        }
      ],
      "style": "warning"
    },
    {
      "type": "Container",
      "$when": "${errorMessage == null}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "text": "%GPUUsage_Widget_Template/GPU_Usage%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "text": "${gpuUsage}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "$when": "${gpuTemp != '--'}",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "horizontalAlignment": "right",
                  "text": "%GPUUsage_Widget_Template/GPU_Temperature%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "horizontalAlignment": "right",
                  "text": "${gpuTemp}"
                }
              ]
            }
          ]
        },
        {
          "type": "Chart.Line",
          "spacing": "medium",
          "yAxisTitle": "%CPUUsage_Widget_Template/Chart_Y_Axis%",
          "xAxisTitle": "%CPUUsage_Widget_Template/Chart_X_Axis%",
          "yMin": 0,
          "yMax": 100,
          "valueFormat": "percentage",
          "fill": "gradient",
          "data": "${gpuSeries}",
          "fallback": "drop"
        },
        {
          "type": "TextBlock",
          "spacing": "medium",
          "isSubtle": true,
          "wrap": true,
          "text": "${gpuName}"
        }
      ]
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
