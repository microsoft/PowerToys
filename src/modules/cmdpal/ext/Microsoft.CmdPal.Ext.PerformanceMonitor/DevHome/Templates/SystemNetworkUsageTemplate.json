{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "$when": "${errorMessage != null}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "size": "small"
        }
      ],
      "style": "warning"
    },
    {
      "type": "Container",
      "$when": "${errorMessage == null}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "text": "%NetworkUsage_Widget_Template/Received%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "text": "${netReceived}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "isSubtle": true,
                  "size": "small",
                  "horizontalAlignment": "right",
                  "text": "%NetworkUsage_Widget_Template/Sent%"
                },
                {
                  "type": "TextBlock",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "spacing": "none",
                  "horizontalAlignment": "right",
                  "text": "${netSent}"
                }
              ]
            }
          ]
        },
        {
          "type": "Chart.Line",
          "spacing": "medium",
          "yAxisTitle": "${netChartAxis}",
          "xAxisTitle": "%CPUUsage_Widget_Template/Chart_X_Axis%",
          "yMin": 0,
          "fill": "gradient",
          "data": "${netSeries}",
          "fallback": "drop"
        },
        {
          "type": "TextBlock",
          "spacing": "medium",
          "isSubtle": true,
          "wrap": true,
          "text": "${networkName}"
        },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%NetworkUsage_Widget_Template/Link_Speed%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${netLinkSpeed}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "roundedCorners": true,
                  "showBorder": true,
                  "items": [
                    {
                      "type": "TextBlock",
                      "isSubtle": true,
                      "size": "small",
                      "text": "%NetworkUsage_Widget_Template/Network_Usage%"
                    },
                    {
                      "type": "TextBlock",
                      "size": "large",
                      "spacing": "none",
                      "text": "${networkUsage}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
