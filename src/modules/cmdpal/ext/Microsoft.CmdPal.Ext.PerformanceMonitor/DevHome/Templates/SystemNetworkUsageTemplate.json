{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "$when": "${errorMessage != null}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "size": "small"
        }
      ],
      "style": "warning"
    },
    {
      "type": "Container",
      "$when": "${errorMessage == null}",
      "items": [
        {
          "type": "Image",
          "url": "${netGraphUrl}",
          "height": "${chartHeight}",
          "width": "${chartWidth}",
          "$when": "${$host.widgetSize != \"small\"}",
          "horizontalAlignment": "center"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "items": [
                {
                  "text": "%NetworkUsage_Widget_Template/Sent%",
                  "type": "TextBlock",
                  "spacing": "none",
                  "size": "small",
                  "isSubtle": true
                },
                {
                  "text": "${netSent}",
                  "type": "TextBlock",
                  "size": "large",
                  "weight": "bolder"
                }
              ]
            },
            {
              "type": "Column",
              "items": [
                {
                  "text": "%NetworkUsage_Widget_Template/Received%",
                  "type": "TextBlock",
                  "spacing": "none",
                  "size": "small",
                  "isSubtle": true,
                  "horizontalAlignment": "right"
                },
                {
                  "text": "${netReceived}",
                  "type": "TextBlock",
                  "size": "large",
                  "weight": "bolder",
                  "horizontalAlignment": "right"
                }
              ]
            }
          ]
        },
        {
          "text": "%NetworkUsage_Widget_Template/Network_Name%",
          "type": "TextBlock",
          "size": "small",
          "isSubtle": true
        },
        {
          "text": "${networkName}",
          "type": "TextBlock",
          "size": "medium",
          "wrap": true
        },
        {
          "type": "Container",
          "$when": "${networkDescription != null}",
          "items": [
            {
              "text": "%NetworkUsage_Widget_Template/Description%",
              "type": "TextBlock",
              "size": "small",
              "isSubtle": true
            },
            {
              "text": "${networkDescription}",
              "type": "TextBlock",
              "spacing": "small",
              "wrap": true
            }
          ]
        },
        {
          "type": "ColumnSet",
          "$when": "${networkType != null}",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "text": "%NetworkUsage_Widget_Template/Type%",
                  "type": "TextBlock",
                  "size": "small",
                  "isSubtle": true
                },
                {
                  "text": "${networkType}",
                  "type": "TextBlock",
                  "spacing": "small",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "text": "%NetworkUsage_Widget_Template/Status%",
                  "type": "TextBlock",
                  "size": "small",
                  "isSubtle": true
                },
                {
                  "text": "${networkStatus}",
                  "type": "TextBlock",
                  "spacing": "small",
                  "wrap": true
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
