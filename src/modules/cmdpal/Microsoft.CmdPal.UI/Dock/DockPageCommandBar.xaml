<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Microsoft.CmdPal.UI.Dock.DockPageCommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.CmdPal.UI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <controls:ContextMenuFlyout x:Name="ContextMenuFlyout" />
        <converters:BoolToVisibilityConverter
            x:Key="BoolToInvertedVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
    </UserControl.Resources>

    <Grid
        MinHeight="44"
        Padding="8,4"
        ColumnSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
            VerticalAlignment="Center">
            <TextBlock
                Padding="8,0"
                VerticalAlignment="Center"
                Text="{x:Bind CurrentPage.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind CurrentPage.PageMenu.CanOpenContextMenu, Mode=OneWay, Converter={StaticResource BoolToInvertedVisibilityConverter}, FallbackValue=Collapsed}" />
            <Button
                x:Name="PageMenuButton"
                x:Uid="PageMenuButton"
                Padding="8,4"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="PageMenuButton"
                AutomationProperties.Name="{x:Bind CurrentPage.Title, Mode=OneWay}"
                Click="PageMenuButton_Click"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind CurrentPage.PageMenu.CanOpenContextMenu, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind CurrentPage.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Button>
        </Grid>
        <Button
            x:Name="PrimaryButton"
            Grid.Column="1"
            AutomationProperties.AutomationId="PrimaryCommandButton"
            AutomationProperties.Name="{x:Bind ViewModel.PrimaryCommand.Name, Mode=OneWay}"
            Click="PrimaryButton_Click"
            Content="{x:Bind ViewModel.PrimaryCommand.Name, Mode=OneWay}"
            Style="{StaticResource SubtleButtonStyle}"
            Visibility="{x:Bind ViewModel.HasPrimaryCommand, Mode=OneWay}" />
        <Button
            x:Name="SecondaryButton"
            Grid.Column="2"
            AutomationProperties.AutomationId="SecondaryCommandButton"
            AutomationProperties.Name="{x:Bind ViewModel.SecondaryCommand.Name, Mode=OneWay}"
            Click="SecondaryButton_Click"
            Content="{x:Bind ViewModel.SecondaryCommand.Name, Mode=OneWay}"
            Style="{StaticResource SubtleButtonStyle}"
            Visibility="{x:Bind ViewModel.HasSecondaryCommand, Mode=OneWay}" />
        <Button
            x:Name="MoreCommandsButton"
            x:Uid="MoreCommandsButton"
            Grid.Column="3"
            AutomationProperties.AutomationId="MoreContextMenuButton"
            Click="MoreCommandsButton_Click"
            Style="{StaticResource SubtleButtonStyle}"
            Visibility="{x:Bind ViewModel.ShouldShowMoreCommandsButton, Mode=OneWay}">
            <FontIcon Glyph="&#xE712;" />
        </Button>
    </Grid>
</UserControl>
