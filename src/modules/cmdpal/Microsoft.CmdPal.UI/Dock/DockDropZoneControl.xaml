<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Microsoft.CmdPal.UI.Dock.DockDropZoneControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    CornerRadius="{StaticResource ControlCornerRadius}"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:Double x:Key="PinDropFillOpacity">0.84</x:Double>
                    <x:Double x:Key="PinDropActiveFillOpacity">0.94</x:Double>
                    <x:Double x:Key="PinDropOutlineOpacity">0.45</x:Double>
                    <StaticResource x:Key="PinDropForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="PinDropActiveForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:Double x:Key="PinDropFillOpacity">0.84</x:Double>
                    <x:Double x:Key="PinDropActiveFillOpacity">0.94</x:Double>
                    <x:Double x:Key="PinDropOutlineOpacity">0.45</x:Double>
                    <StaticResource x:Key="PinDropForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="PinDropActiveForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="PinDropFillOpacity">1</x:Double>
                    <x:Double x:Key="PinDropActiveFillOpacity">1</x:Double>
                    <x:Double x:Key="PinDropOutlineOpacity">1</x:Double>
                    <SolidColorBrush x:Key="PinDropForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PinDropActiveForegroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Rectangle
            x:Name="ZoneFill"
            Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Opacity="{ThemeResource PinDropFillOpacity}"
            RadiusX="{x:Bind CornerRadius.TopLeft, Mode=OneWay}"
            RadiusY="{x:Bind CornerRadius.TopLeft, Mode=OneWay}">
            <Rectangle.OpacityTransition>
                <ScalarTransition Duration="{x:Bind AnimationDuration, Mode=OneWay}" />
            </Rectangle.OpacityTransition>
        </Rectangle>
        <Rectangle
            x:Name="ZoneOutline"
            Opacity="{ThemeResource PinDropOutlineOpacity}"
            RadiusX="{x:Bind CornerRadius.TopLeft, Mode=OneWay}"
            RadiusY="{x:Bind CornerRadius.TopLeft, Mode=OneWay}"
            Stroke="{ThemeResource PinDropForegroundBrush}"
            StrokeDashArray="4,3"
            StrokeDashCap="Round"
            StrokeThickness="1">
            <Rectangle.OpacityTransition>
                <ScalarTransition Duration="{x:Bind AnimationDuration, Mode=OneWay}" />
            </Rectangle.OpacityTransition>
        </Rectangle>
        <StackPanel
            Margin="2,2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="{x:Bind Orientation, Mode=OneWay}"
            Spacing="6">
            <FontIcon
                x:Name="PinIcon"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource PinDropForegroundBrush}"
                Glyph="&#xE718;" />
            <TextBlock
                x:Name="ZoneLabel"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{ThemeResource PinDropForegroundBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Label, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DropTargetStates">
                <VisualState x:Name="Inactive">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger Value="{x:Bind IsActive, Mode=OneWay}" To="False" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ZoneFill.Opacity" Value="{ThemeResource PinDropFillOpacity}" />
                        <Setter Target="ZoneOutline.Opacity" Value="{ThemeResource PinDropOutlineOpacity}" />
                        <Setter Target="ZoneOutline.Stroke" Value="{ThemeResource PinDropForegroundBrush}" />
                        <Setter Target="PinIcon.Foreground" Value="{ThemeResource PinDropForegroundBrush}" />
                        <Setter Target="ZoneLabel.Foreground" Value="{ThemeResource PinDropForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Active">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger Value="{x:Bind IsActive, Mode=OneWay}" To="True" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ZoneFill.Opacity" Value="{ThemeResource PinDropActiveFillOpacity}" />
                        <Setter Target="ZoneOutline.Opacity" Value="1" />
                        <Setter Target="ZoneOutline.Stroke" Value="{ThemeResource PinDropActiveForegroundBrush}" />
                        <Setter Target="PinIcon.Foreground" Value="{ThemeResource PinDropActiveForegroundBrush}" />
                        <Setter Target="ZoneLabel.Foreground" Value="{ThemeResource PinDropActiveForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
