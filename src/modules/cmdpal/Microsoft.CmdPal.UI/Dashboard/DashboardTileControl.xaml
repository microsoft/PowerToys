<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Microsoft.CmdPal.UI.Dashboard.DashboardTileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.CmdPal.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:help="using:Microsoft.CmdPal.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="Card"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <!--  The pinned page, hosted like a dock flyout  -->
        <ContentPresenter
            x:Name="PageHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <!--  Shown while the page loads, or when it can't be found  -->
        <StackPanel
            x:Name="Placeholder"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <controls:IconBox
                x:Name="PlaceholderIcon"
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                SourceRequested="{x:Bind help:IconProvider.SourceRequested32}" />
            <TextBlock
                x:Name="PlaceholderTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="24"
                Height="24"
                IsActive="True" />
            <TextBlock
                x:Name="PlaceholderMessage"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <!--  Edit mode: drag to move, grip to resize  -->
        <Grid
            x:Name="EditOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="8"
            ManipulationCompleted="EditOverlay_ManipulationCompleted"
            ManipulationDelta="EditOverlay_ManipulationDelta"
            ManipulationMode="TranslateX,TranslateY"
            ManipulationStarted="EditOverlay_ManipulationStarted"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Spacing="8">
                <FontIcon
                    FontSize="24"
                    Glyph="&#xE7C2;" />
                <TextBlock
                    x:Name="EditTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                x:Name="UnpinButton"
                x:Uid="Dashboard_Tile_UnpinButton"
                Margin="8"
                Padding="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="UnpinButton_Click">
                <FontIcon FontSize="14" Glyph="&#xE77A;" />
            </Button>

            <Border
                x:Name="ResizeGrip"
                x:Uid="Dashboard_Tile_ResizeGrip"
                Width="28"
                Height="28"
                Margin="0,0,2,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                ManipulationCompleted="ResizeGrip_ManipulationCompleted"
                ManipulationDelta="ResizeGrip_ManipulationDelta"
                ManipulationMode="TranslateX,TranslateY"
                ManipulationStarted="ResizeGrip_ManipulationStarted">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="&#xE740;" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
