<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Microsoft.CmdPal.UI.Settings.DashboardSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:cpControls="using:Microsoft.CmdPal.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dashboardVm="using:Microsoft.CmdPal.UI.ViewModels.Dashboard"
    xmlns:helpers="using:Microsoft.CmdPal.UI.Helpers"
    xmlns:local="using:Microsoft.CmdPal.UI.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <ScrollViewer>
        <Grid Padding="16,0,16,16">
            <StackPanel
                MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock
                    x:Uid="Settings_DashboardPage_Intro"
                    Margin="0,0,0,24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <!--  Enable dashboard  -->
                <controls:SettingsCard
                    x:Uid="Settings_DashboardPage_Enable_SettingsCard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xF246;}"
                    local:SettingsPageTarget.Id="enabled">
                    <ToggleSwitch AutomationProperties.AutomationId="CmdPal_DashboardSettingsPage_Enable" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Shortcut  -->
                <controls:SettingsCard
                    x:Uid="Settings_DashboardPage_Shortcut_SettingsCard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xEDA7;}"
                    IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                    local:SettingsPageTarget.Id="shortcut">
                    <cpControls:ShortcutControl AutomationProperties.AutomationId="CmdPal_DashboardSettingsPage_Shortcut" HotkeySettings="{x:Bind ViewModel.Hotkey, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Ignore the shortcut in full-screen apps  -->
                <controls:SettingsCard
                    x:Uid="Settings_DashboardPage_IgnoreInFullscreen_SettingsCard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7FC;}"
                    IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                    local:SettingsPageTarget.Id="ignore-fullscreen">
                    <ToggleSwitch AutomationProperties.AutomationId="CmdPal_DashboardSettingsPage_IgnoreInFullscreen" IsOn="{x:Bind ViewModel.IgnoreHotkeyWhenFullscreen, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Dismiss on focus lost  -->
                <controls:SettingsCard
                    x:Uid="Settings_DashboardPage_DismissOnFocusLost_SettingsCard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE765;}"
                    IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                    local:SettingsPageTarget.Id="dismiss-on-focus-lost">
                    <ToggleSwitch AutomationProperties.AutomationId="CmdPal_DashboardSettingsPage_DismissOnFocusLost" IsOn="{x:Bind ViewModel.DismissOnFocusLost, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Appearance  -->
                <TextBlock
                    x:Uid="Settings_DashboardPage_AppearanceHeader"
                    local:SettingsPageTarget.Id="appearance-section"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard
                    x:Uid="Settings_DashboardPage_Backdrop_SettingsCard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xF5EF;}"
                    IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                    local:SettingsPageTarget.Id="backdrop">
                    <ComboBox
                        MinWidth="{StaticResource SettingActionControlMinWidth}"
                        AutomationProperties.AutomationId="CmdPal_DashboardSettingsPage_Backdrop"
                        SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="Settings_DashboardPage_Backdrop_Dim" />
                        <ComboBoxItem x:Uid="Settings_DashboardPage_Backdrop_Acrylic" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="Settings_DashboardPage_BackgroundOpacity_SettingsCard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE790;}"
                    IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                    local:SettingsPageTarget.Id="background-opacity">
                    <Slider
                        x:Uid="Settings_DashboardPage_BackgroundOpacity_Slider"
                        MinWidth="{StaticResource SettingActionControlMinWidth}"
                        AutomationProperties.AutomationId="CmdPal_DashboardSettingsPage_BackgroundOpacity"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="5"
                        Value="{x:Bind ViewModel.BackgroundOpacity, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  Pinned pages  -->
                <TextBlock
                    x:Uid="Settings_DashboardPage_TilesHeader"
                    local:SettingsPageTarget.Id="tiles-section"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="Settings_DashboardPage_Tiles_SettingsCard" HeaderIcon="{ui:FontIcon Glyph=&#xE718;}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="Settings_DashboardPage_ResetLayout_Button"
                            AutomationProperties.AutomationId="CmdPal_DashboardSettingsPage_ResetLayout"
                            Command="{x:Bind ViewModel.ResetLayoutCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPinnedTiles, Mode=OneWay}" />
                        <Button
                            x:Uid="Settings_DashboardPage_Show_Button"
                            AutomationProperties.AutomationId="CmdPal_DashboardSettingsPage_Show"
                            Command="{x:Bind ViewModel.ShowDashboardCommand}"
                            IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock
                    x:Uid="Settings_DashboardPage_NoTiles"
                    Margin="4,4,4,4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind NoTilesVisibility, Mode=OneWay}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.PinnedTiles}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="dashboardVm:DashboardPinnedTileViewModel">
                            <controls:SettingsCard Description="{x:Bind Subtitle}" Header="{x:Bind Title}">
                                <controls:SettingsCard.HeaderIcon>
                                    <cpControls:ContentIcon>
                                        <cpControls:ContentIcon.Content>
                                            <cpControls:IconBox
                                                Width="20"
                                                Height="20"
                                                AutomationProperties.AccessibilityView="Raw"
                                                RequestSite="Settings"
                                                SourceKey="{x:Bind Icon}"
                                                SourceRequested="{x:Bind helpers:IconProvider.SourceRequested20}" />
                                        </cpControls:ContentIcon.Content>
                                    </cpControls:ContentIcon>
                                </controls:SettingsCard.HeaderIcon>
                                <Button
                                    x:Uid="Settings_DashboardPage_Unpin_Button"
                                    Click="UnpinButton_Click"
                                    Tag="{x:Bind}" />
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
