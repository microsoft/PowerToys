<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Microsoft.CmdPal.UI.Controls.ContentFormControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.CmdPal.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Microsoft.CmdPal.UI.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary x:Name="CardOverrideStyles">
            <Style x:Key="Adaptive.TextBlock" TargetType="TextBlock">
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <!--  Used by AdaptiveContainerDecoratorRenderer for roundedCorners and showBorder.  -->
            <Style x:Key="CmdPal.Adaptive.Container.Rounded" TargetType="Border">
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
            <Style x:Key="CmdPal.Adaptive.Container.Bordered" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8" />
            </Style>
            <Style
                x:Key="CmdPal.Adaptive.Container.RoundedBordered"
                BasedOn="{StaticResource CmdPal.Adaptive.Container.Bordered}"
                TargetType="Border">
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="CardHost" />
</UserControl>
