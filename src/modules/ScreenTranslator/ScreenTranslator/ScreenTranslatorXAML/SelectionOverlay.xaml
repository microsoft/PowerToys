<common:TransparentWindow
    x:Class="ScreenTranslator.SelectionOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Microsoft.PowerToys.Common.UI.Controls.Window"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ScreenTranslatorSelection"
    IsAlwaysOnTop="True"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="False"
    IsTitleBarVisible="False"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Canvas
            x:Name="SelectionCanvas"
            x:Uid="SelectionCanvas"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            AutomationProperties.Name="Screen region selection canvas"
            AutomationProperties.AutomationId="CanvasSelection"
            PointerPressed="SelectionCanvas_PointerPressed"
            PointerMoved="SelectionCanvas_PointerMoved"
            PointerReleased="SelectionCanvas_PointerReleased">
            <Rectangle
                x:Name="SelectionRectangle"
                Fill="{ThemeResource AccentFillColorTertiaryBrush}"
                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                StrokeThickness="2"
                Visibility="Collapsed" />
        </Canvas>

        <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BackgroundSizing="InnerBorderEdge"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Margin="16"
            Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Uid="QuickSelectLabel"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Quick select"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="FullScreenButton"
                    x:Uid="FullScreenButton"
                    AutomationProperties.AutomationId="BtnTranslateFullScreen"
                    AutomationProperties.Name="Translate full screen"
                    Click="FullScreenButton_Click"
                    Content="Full screen" />
                <Button
                    x:Name="ActiveWindowButton"
                    x:Uid="ActiveWindowButton"
                    AutomationProperties.AutomationId="BtnTranslateActiveWindow"
                    AutomationProperties.Name="Translate active window"
                    Click="ActiveWindowButton_Click"
                    Content="Active window" />
            </StackPanel>
        </Border>
    </Grid>
</common:TransparentWindow>
