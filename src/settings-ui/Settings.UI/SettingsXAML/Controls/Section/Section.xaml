<UserControl
    x:Class="Microsoft.PowerToys.Settings.UI.Controls.Section"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    HorizontalContentAlignment="Stretch">

    <!-- Section condivisa: titolo, sottotitolo, canvas, contenuto (in questo ordine). -->
    <StackPanel Spacing="0">
        <!-- SECTION - Titolo -->
        <TextBlock
            Margin="1,24,0,0"
            AutomationProperties.HeadingLevel="Level2"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Text="{Binding Title, ElementName=Root}"
            Visibility="{Binding TitleVisibility, ElementName=Root}" />

        <!-- SECTION - Sottotitolo (subito sotto il titolo) -->
        <TextBlock
            Margin="1,4,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="{Binding Subtitle, ElementName=Root}"
            TextWrapping="WrapWholeWords"
            Visibility="{Binding SubtitleVisibility, ElementName=Root}" />

        <!-- SECTION - Canvas: card con il contenuto grafico (slot CanvasContent) -->
        <Border
            Margin="0,8,0,0"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding CanvasVisibility, ElementName=Root}">
            <ContentPresenter Content="{Binding CanvasContent, ElementName=Root}" HorizontalContentAlignment="Center" />
        </Border>

        <!-- SECTION - Contenuto (slot SectionContent, e' anche il contenuto XAML di default).
             Il margine superiore e' 8 da solo, 4 se attaccato al canvas (come due card impilate). -->
        <ContentPresenter
            x:Name="ContentHost"
            Margin="0,8,0,0"
            Content="{Binding SectionContent, ElementName=Root}"
            HorizontalContentAlignment="Stretch" />
    </StackPanel>
</UserControl>
