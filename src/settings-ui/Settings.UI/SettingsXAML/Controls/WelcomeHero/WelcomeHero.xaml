<UserControl
    x:Class="Microsoft.PowerToys.Settings.UI.Controls.WelcomeHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AccessibilityView="Raw"
    mc:Ignorable="d">
    <Grid>
        <Grid
            x:Name="SceneHost"
            Background="Transparent"
            PointerCanceled="SceneHost_PointerExited"
            PointerCaptureLost="SceneHost_PointerExited"
            PointerEntered="SceneHost_PointerEntered"
            PointerExited="SceneHost_PointerExited"
            PointerMoved="SceneHost_PointerMoved"
            Tapped="SceneHost_Tapped" />

        <!--  Dock-style name label for the hovered tool  -->
        <Canvas IsHitTestVisible="False">
            <Border
                x:Name="LabelPill"
                Padding="10,5,10,6"
                Background="{ThemeResource ToolTipBackground}"
                BorderBrush="{ThemeResource ToolTipBorderBrush}"
                BorderThickness="{ThemeResource ToolTipBorderThemeThickness}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.14" />
                </Border.OpacityTransition>
                <Border.TranslationTransition>
                    <Vector3Transition Duration="0:0:0.18" />
                </Border.TranslationTransition>
                <TextBlock
                    x:Name="LabelText"
                    Foreground="{ThemeResource ToolTipForeground}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
