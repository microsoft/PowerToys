<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.PowerScriptsActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:viewModels="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    xmlns:views="using:Microsoft.PowerToys.Settings.UI.Views"
    AutomationProperties.AutomationId="PowerScriptsActivityPage"
    AutomationProperties.LandmarkType="Main">
    <local:NavigablePage.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Left"
            Invoked="BackKeyboardAccelerator_Invoked"
            Modifiers="Menu" />
    </local:NavigablePage.KeyboardAccelerators>
    <Grid Margin="24,0,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="PowerScripts_SettingsBack"
                AutomationProperties.AutomationId="PowerScriptsActivityBack"
                Click="BackButton_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <SymbolIcon Symbol="Back" />
            </Button>
            <BreadcrumbBar
                x:Name="ActivityBreadcrumb"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsActivityBreadcrumb"
                ItemClicked="ActivityBreadcrumb_ItemClicked" />
        </Grid>
        <TextBlock
            x:Uid="PowerScripts_ActivityHelp"
            Grid.Row="1"
            TextWrapping="Wrap" />
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="PowerScripts_ActivityRefresh"
                AutomationProperties.AutomationId="PowerScriptsActivityRefresh"
                Click="RefreshButton_Click"
                IsEnabled="{x:Bind ViewModel.CanRefreshActivity, Mode=OneWay}" />
            <Button
                x:Uid="PowerScripts_ActivityClear"
                Grid.Column="1"
                AutomationProperties.AutomationId="PowerScriptsActivityClear"
                Click="ClearButton_Click"
                IsEnabled="{x:Bind ViewModel.CanRefreshActivity, Mode=OneWay}" />
            <ProgressRing
                Grid.Column="2"
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsActivityBusy, Mode=OneWay}"
                Visibility="{x:Bind views:PowerScriptsPage.BoolToVisibility(ViewModel.IsActivityBusy), Mode=OneWay}" />
        </Grid>
        <InfoBar
            x:Uid="PowerScripts_ActivityError"
            Grid.Row="3"
            AutomationProperties.AutomationId="PowerScriptsActivityError"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasActivityError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ActivityError, Mode=OneWay}"
            Severity="Error" />
        <Grid Grid.Row="4">
            <TextBlock
                x:Uid="PowerScripts_ActivityEmpty"
                AutomationProperties.AutomationId="PowerScriptsActivityEmpty"
                Visibility="{x:Bind views:PowerScriptsPage.BoolToVisibility(ViewModel.IsActivityEmpty), Mode=OneWay}" />
            <ListView
                x:Uid="PowerScripts_ActivityList"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="PowerScriptsActivityList"
                ItemsSource="{x:Bind ViewModel.ActivityItems, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PowerScriptActivityItem">
                        <Grid Padding="4,8" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ScriptName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ScriptName}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Details}"
                                TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="{x:Bind Outcome, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</local:NavigablePage>
