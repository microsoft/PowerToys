<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.TextExpanderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">
    <Grid>

        <controls:SettingsPageControl
            x:Uid="TextExpander"
            IsTabStop="False"
            ModuleImageSource="ms-appx:///Assets/Settings/Modules/TextExpander.png">

        <controls:SettingsPageControl.ModuleContent>
            <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Orientation="Vertical">

                <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        Name="TextExpanderEnable"
                        x:Uid="TextExpander_Enable"
                        HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/TextExpander.png}">
                        <ToggleSwitch
                            x:Uid="ToggleSwitch"
                            AutomationProperties.AutomationId="Toggle_TextExpander"
                            IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:GPOInfoControl>

                <controls:SettingsGroup x:Uid="TextExpander_Snippets_GroupSettings" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">

                    <InfoBar
                        x:Uid="TextExpander_SnippetError"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasSnippetError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.SnippetError, Mode=OneWay}"
                        Severity="Error" />

                    <tkcontrols:SettingsCard
                        x:Uid="TextExpander_AddSnippet"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE710;}">
                        <Button
                            x:Uid="TextExpander_AddSnippetButton"
                            Click="AddSnippet_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    </tkcontrols:SettingsCard>

                    <ItemsControl
                        Margin="0,2,0,0"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.Snippets, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TextExpanderSnippetViewModel">
                                <tkcontrols:SettingsCard
                                    Margin="0,2,0,0"
                                    Click="EditSnippet_Click"
                                    Description="{x:Bind Summary, Mode=OneWay}"
                                    Header="{x:Bind Trigger, Mode=OneWay}"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}"
                                    IsActionIconVisible="False"
                                    IsClickEnabled="True">
                                    <tkcontrols:SettingsCard.Resources>
                                        <x:Double x:Key="SettingsCardActionButtonWidth">0</x:Double>
                                    </tkcontrols:SettingsCard.Resources>
                                    <!-- Destructive row actions belong behind a flyout on clickable rows, which also prevents competing ContentDialogs on one XamlRoot. -->
                                    <Button
                                        x:Uid="More_Options_Button"
                                        VerticalAlignment="Center"
                                        Content="&#xE712;"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{x:Bind}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    x:Uid="TextExpander_DuplicateSnippet"
                                                    Click="DuplicateSnippet_Click"
                                                    Icon="{ui:FontIcon Glyph=&#xE8C8;}"
                                                    Tag="{x:Bind}" />
                                                <MenuFlyoutItem
                                                    x:Uid="TextExpander_DeleteSnippet"
                                                    Click="DeleteSnippet_Click"
                                                    Icon="{ui:FontIcon Glyph=&#xE74D;}"
                                                    Tag="{x:Bind}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <ToolTipService.ToolTip>
                                            <TextBlock x:Uid="More_Options_ButtonTooltip" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </tkcontrols:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <tkcontrols:SettingsCard
                        x:Uid="TextExpander_NoSnippets"
                        Margin="0,2,0,0"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE946;}"
                        Visibility="{x:Bind ViewModel.HasNoSnippets, Mode=OneWay}" />

                </controls:SettingsGroup>

                <controls:SettingsGroup x:Uid="TextExpander_Injection_GroupSettings" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsExpander
                        x:Uid="TextExpander_InjectionBackend"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8C8;}"
                        IsExpanded="True">
                        <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{x:Bind ViewModel.InjectionBackendIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="TextExpander_Backend_Auto" />
                            <ComboBoxItem x:Uid="TextExpander_Backend_Clipboard" />
                            <ComboBoxItem x:Uid="TextExpander_Backend_Type" />
                        </ComboBox>
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard
                                x:Uid="TextExpander_ClipboardThreshold"
                                HeaderIcon="{ui:FontIcon Glyph=&#xE8C8;}">
                                <NumberBox
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    LargeChange="10"
                                    Maximum="1000"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.ClipboardThresholdChars, Mode=TwoWay}" />
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>
                </controls:SettingsGroup>

                <controls:SettingsGroup x:Uid="TextExpander_Advanced_GroupSettings" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        x:Uid="TextExpander_RequireWordBoundary"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE75A;}">
                        <ToggleSwitch
                            x:Uid="ToggleSwitch"
                            AutomationProperties.AutomationId="Toggle_TextExpander_RequireWordBoundary"
                            IsOn="{x:Bind ViewModel.RequireWordBoundary, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                    <tkcontrols:SettingsCard
                        x:Uid="TextExpander_SnippetsPath"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
                        <!-- Capped width: an unconstrained TextBox measures to the full path and starves the header column in narrow windows. -->
                        <Grid ColumnSpacing="8" MaxWidth="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="TextExpander_SnippetsPath_TextBox"
                                MinWidth="160"
                                Text="{x:Bind ViewModel.SnippetsPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SnippetsPath, Mode=OneWay}" />
                            <Button
                                x:Uid="TextExpander_SnippetsPath_BrowseButton"
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseForSnippetsFolderCommand, Mode=OneWay}" />
                        </Grid>
                    </tkcontrols:SettingsCard>
                    <tkcontrols:SettingsCard
                        x:Uid="TextExpander_TreatRemapsAsTyping"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE765;}">
                        <ToggleSwitch
                            x:Uid="ToggleSwitch"
                            AutomationProperties.AutomationId="Toggle_TextExpander_TreatRemapsAsTyping"
                            IsOn="{x:Bind ViewModel.TreatRemapsAsTyping, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>
    </controls:SettingsPageControl>

<!--
            The editor. Kept in the page rather than its own window because a snippet is a small
            edit and a ContentDialog is the shape PowerToys already uses for one (Advanced Paste's
            custom actions, the profile editor).
        -->
        <ContentDialog
            x:Name="SnippetDialog"
            x:Uid="TextExpander_SnippetDialog"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="{x:Bind IsSnippetValid, Mode=OneWay}">
            <ScrollViewer>
                <StackPanel Width="440" Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="TextExpander_Dialog_Trigger" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBox
                            x:Name="TriggerBox"
                            x:Uid="TextExpander_Dialog_TriggerBox"
                            FontFamily="Consolas"
                            TextChanged="SnippetField_Changed" />
                        <TextBlock
                            x:Uid="TextExpander_Dialog_TriggerHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock
                                x:Uid="TextExpander_Dialog_Replacement"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button x:Uid="TextExpander_Dialog_InsertVariable" HorizontalAlignment="Right">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="VariableFlyout" Placement="Bottom" />
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBox
                            x:Name="ReplacementBox"
                            x:Uid="TextExpander_Dialog_ReplacementBox"
                            AcceptsReturn="True"
                            MinHeight="96"
                            TextChanged="SnippetField_Changed"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind HasSnippetProblem, Mode=OneWay}"
                        Message="{x:Bind SnippetProblem, Mode=OneWay}"
                        Severity="Warning" />

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="TextExpander_Dialog_Preview" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                            <TextBlock
                                Text="{x:Bind SnippetPreview, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</local:NavigablePage>
