<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.PowerScriptTemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:viewModels="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    xmlns:views="using:Microsoft.PowerToys.Settings.UI.Views"
    AutomationProperties.AutomationId="PowerScriptsTemplatesPage"
    AutomationProperties.LandmarkType="Main">
    <local:NavigablePage.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Left"
            Invoked="BackKeyboardAccelerator_Invoked"
            Modifiers="Menu" />
    </local:NavigablePage.KeyboardAccelerators>
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="20,0,20,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="PowerScripts_SettingsBack"
                AutomationProperties.AutomationId="PowerScriptsTemplatesBack"
                Click="BackButton_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <SymbolIcon Symbol="Back" />
            </Button>
            <BreadcrumbBar
                x:Name="TemplateBreadcrumb"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PowerScriptsTemplatesBreadcrumb"
                ItemClicked="TemplateBreadcrumb_ItemClicked" />
        </Grid>
        <controls:SettingsPageControl
            x:Name="CreationForm"
            x:Uid="PowerScripts_TemplatesPage"
            Grid.Row="1">
            <controls:SettingsPageControl.ModuleContent>
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="PowerScripts_TemplatesHelp" TextWrapping="Wrap" />
                    <TextBox
                        x:Name="ProjectNameTextBox"
                        x:Uid="PowerScripts_TemplateProjectName"
                        AutomationProperties.AutomationId="PowerScriptsTemplateProjectName"
                        MaxLength="80"
                        TextChanged="ProjectName_TextChanged" />
                    <TextBlock
                        x:Uid="PowerScripts_TemplateProjectNameHelp"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="DescriptionTextBox"
                        x:Uid="PowerScripts_TemplateDescription"
                        MinHeight="72"
                        AcceptsReturn="True"
                        AutomationProperties.AutomationId="PowerScriptsTemplateDescription"
                        MaxLength="500"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="RuntimeComboBox"
                            x:Uid="PowerScripts_TemplateRuntime"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PowerScriptsTemplateRuntime"
                            SelectionChanged="Options_SelectionChanged">
                            <ComboBoxItem Content="PowerShell" Tag="powershell" />
                            <ComboBoxItem Content="Python" Tag="python" />
                        </ComboBox>
                        <ComboBox
                            x:Name="InputComboBox"
                            x:Uid="PowerScripts_TemplateInput"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PowerScriptsTemplateInput"
                            SelectionChanged="Options_SelectionChanged">
                            <ComboBoxItem x:Uid="PowerScripts_TemplateNone" Tag="none" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterText" Tag="text" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterFiles" Tag="files" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterImage" Tag="image" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterAudio" Tag="audio" />
                        </ComboBox>
                        <ComboBox
                            x:Name="OutputComboBox"
                            x:Uid="PowerScripts_TemplateOutput"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PowerScriptsTemplateOutput"
                            SelectionChanged="Options_SelectionChanged">
                            <ComboBoxItem x:Uid="PowerScripts_TemplateNone" Tag="none" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterText" Tag="text" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterFiles" Tag="files" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterImage" Tag="image" />
                            <ComboBoxItem x:Uid="PowerScripts_FilterAudio" Tag="audio" />
                        </ComboBox>
                    </Grid>
                    <TextBlock
                        x:Name="PythonHelp"
                        x:Uid="PowerScripts_TemplatePythonHelp"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <StackPanel
                        x:Name="FileInputOptions"
                        AutomationProperties.AutomationId="PowerScriptsTemplateFileOptions"
                        Spacing="16"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="ExtensionsTextBox"
                            x:Uid="PowerScripts_TemplateFileExtensions"
                            AutomationProperties.AutomationId="PowerScriptsTemplateFileExtensions"
                            MaxLength="1024"
                            PlaceholderText=".txt, .md, .png" />
                        <TextBlock
                            x:Uid="PowerScripts_TemplateFileExtensionsHelp"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="MinimumFilesNumberBox"
                                x:Uid="PowerScripts_TemplateMinimumFiles"
                                AutomationProperties.AutomationId="PowerScriptsTemplateMinimumFiles"
                                Maximum="2147483647"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="FileCount_ValueChanged" />
                            <NumberBox
                                x:Name="MaximumFilesNumberBox"
                                x:Uid="PowerScripts_TemplateMaximumFiles"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="PowerScriptsTemplateMaximumFiles"
                                Maximum="2147483647"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="FileCount_ValueChanged" />
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        x:Uid="PowerScripts_TemplateParameters"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="PowerScripts_TemplateParametersHelp" TextWrapping="Wrap" />
                    <TextBlock
                        x:Uid="PowerScripts_TemplateParameterDefaultHelp"
                        AutomationProperties.AutomationId="PowerScriptsTemplateDefaultHelp"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind Parameters}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:PowerScriptTemplateParameter">
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                    Header="{x:Bind views:PowerScriptTemplatesPage.ParameterHeader(Name), Mode=OneWay}"
                                    IsExpanded="True">
                                    <StackPanel Padding="16" Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Uid="PowerScripts_TemplateParameterName"
                                                AutomationProperties.AutomationId="{x:Bind ControlId('Name')}"
                                                MaxLength="64"
                                                Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox
                                                x:Uid="PowerScripts_TemplateParameterType"
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="{x:Bind ControlId('Type')}"
                                                SelectedIndex="{x:Bind TypeIndex, Mode=TwoWay}">
                                                <ComboBoxItem x:Uid="PowerScripts_TemplateParameterString" />
                                                <ComboBoxItem x:Uid="PowerScripts_TemplateParameterInteger" />
                                                <ComboBoxItem x:Uid="PowerScripts_TemplateParameterBoolean" />
                                                <ComboBoxItem x:Uid="PowerScripts_TemplateParameterFile" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBox
                                            x:Uid="PowerScripts_TemplateParameterTitle"
                                            AutomationProperties.AutomationId="{x:Bind ControlId('Title')}"
                                            MaxLength="100"
                                            Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            x:Uid="PowerScripts_TemplateParameterDescription"
                                            AcceptsReturn="True"
                                            AutomationProperties.AutomationId="{x:Bind ControlId('Description')}"
                                            MaxLength="500"
                                            Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                        <CheckBox
                                            x:Uid="PowerScripts_TemplateParameterRequired"
                                            AutomationProperties.AutomationId="{x:Bind ControlId('Required')}"
                                            IsChecked="{x:Bind Required, Mode=TwoWay}" />
                                        <StackPanel Spacing="8" Visibility="{x:Bind views:PowerScriptTemplatesPage.BoolToVisibility(IsString), Mode=OneWay}">
                                            <TextBox
                                                x:Uid="PowerScripts_TemplateParameterEnum"
                                                AcceptsReturn="True"
                                                AutomationProperties.AutomationId="{x:Bind ControlId('Enum')}"
                                                MaxLength="4096"
                                                Text="{x:Bind EnumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Uid="PowerScripts_TemplateParameterEnumHelp"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="12" Visibility="{x:Bind views:PowerScriptTemplatesPage.BoolToVisibility(IsInteger), Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Uid="PowerScripts_TemplateParameterMinimum"
                                                AutomationProperties.AutomationId="{x:Bind ControlId('Minimum')}"
                                                MaxLength="12"
                                                Text="{x:Bind MinimumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox
                                                x:Uid="PowerScripts_TemplateParameterMaximum"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="{x:Bind ControlId('Maximum')}"
                                                MaxLength="12"
                                                Text="{x:Bind MaximumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBox
                                            x:Uid="PowerScripts_TemplateParameterExtensions"
                                            AutomationProperties.AutomationId="{x:Bind ControlId('Extensions')}"
                                            MaxLength="1024"
                                            Text="{x:Bind FileExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{x:Bind views:PowerScriptTemplatesPage.BoolToVisibility(IsFile), Mode=OneWay}" />
                                        <CheckBox
                                            x:Uid="PowerScripts_TemplateParameterHasDefault"
                                            AutomationProperties.AutomationId="{x:Bind ControlId('HasDefault')}"
                                            IsChecked="{x:Bind HasDefault, Mode=TwoWay}" />
                                        <TextBox
                                            x:Uid="PowerScripts_TemplateParameterDefault"
                                            AutomationProperties.AutomationId="{x:Bind ControlId('Default')}"
                                            Text="{x:Bind DefaultText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{x:Bind views:PowerScriptTemplatesPage.BoolToVisibility(ShowTextDefault), Mode=OneWay}" />
                                        <ToggleSwitch
                                            x:Uid="PowerScripts_TemplateParameterBooleanDefault"
                                            AutomationProperties.AutomationId="{x:Bind ControlId('BooleanDefault')}"
                                            IsOn="{x:Bind DefaultBoolean, Mode=TwoWay}"
                                            Visibility="{x:Bind views:PowerScriptTemplatesPage.BoolToVisibility(ShowBooleanDefault), Mode=OneWay}" />
                                        <Button
                                            x:Uid="PowerScripts_TemplateParameterRemove"
                                            AutomationProperties.AutomationId="{x:Bind ControlId('Remove')}"
                                            Click="RemoveParameterButton_Click"
                                            Tag="{x:Bind}" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button
                        x:Name="AddParameterButton"
                        x:Uid="PowerScripts_TemplateParameterAdd"
                        AutomationProperties.AutomationId="PowerScriptsTemplateParameterAdd"
                        Click="AddParameterButton_Click" />
                    <TextBlock x:Uid="PowerScripts_TemplateSetupHelp" TextWrapping="Wrap" />
                    <InfoBar
                        x:Name="TemplateStatus"
                        AutomationProperties.AutomationId="PowerScriptsTemplateStatus"
                        IsClosable="False" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="CreateButton"
                            x:Uid="PowerScripts_TemplateCreate"
                            AutomationProperties.AutomationId="PowerScriptsTemplateCreate"
                            Click="CreateButton_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Uid="PowerScripts_TemplateCancel"
                            AutomationProperties.AutomationId="PowerScriptsTemplateCancel"
                            Click="BackButton_Click" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsPageControl.ModuleContent>
        </controls:SettingsPageControl>
    </Grid>
</local:NavigablePage>
