<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.DisplayProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    xmlns:tkconverters="using:CommunityToolkit.WinUI.Converters"
    AutomationProperties.LandmarkType="Main"
    PreviewKeyDown="DisplayProfilesPage_PreviewKeyDown"
    mc:Ignorable="d">

    <local:NavigablePage.Resources>
        <tkconverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" FalseValue="Collapsed" TrueValue="Visible" />
        <tkconverters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <tkconverters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <DataTemplate x:Key="DisplayTemplate" x:DataType="vm:MonitorDisplayInfo">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,3" Padding="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Details}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,3" Visibility="{x:Bind IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock x:Uid="DisplayProfiles_PrimaryBadge" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{x:Bind State}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Index}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PreviewTileTemplate" x:DataType="vm:MonitorDisplayInfo">
            <Grid Width="{Binding LayoutWidth}" Height="{Binding LayoutHeight}" Opacity="{Binding PreviewOpacity}" AutomationProperties.Name="{Binding AccessibilityDescription}">
                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" />
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2" Padding="4">
                    <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PreviewStatus}" HorizontalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProfileTemplate" x:DataType="vm:ProfileInfo">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,4" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="Medium" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                        <Button Content="Apply" Click="ApplyProfile_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Overwrite" Click="OverwriteProfile_Click" Style="{StaticResource DefaultButtonStyle}" />
                        <Button Content="Rename" Click="RenameProfile_Click" Style="{StaticResource DefaultButtonStyle}" />
                        <Button Content="Duplicate" Click="DuplicateProfile_Click" Style="{StaticResource DefaultButtonStyle}" />
                        <Button Content="Delete" Click="DeleteProfile_Click" Style="{StaticResource DefaultButtonStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </local:NavigablePage.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <controls:SettingsPageControl x:Uid="DisplayProfiles" ModuleImageSource="ms-appx:///Assets/Settings/Modules/PowerDisplay.png">
            <controls:SettingsPageControl.ModuleContent>
                <StackPanel Spacing="24">
                    <!-- Current Topology Section -->
                    <controls:SettingsGroup x:Uid="DisplayProfiles_CurrentTopology">
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_DisplayArrangement" HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="DisplayProfiles_Preview_Description" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid Height="296" AutomationProperties.Name="Display topology preview">
                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                        <Canvas x:Name="DisplayTopologyCanvas" Width="700" Height="296" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </tkcontrols:SettingsCard>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="DisplayProfiles_ActiveDisplays_Title" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="DisplayProfiles_DisplayList_Description" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Uid="DisplayProfiles_RefreshDisplays" Click="{x:Bind ViewModel.LoadDisplays}" Style="{StaticResource DefaultButtonStyle}" />
                                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <ListView ItemsSource="{x:Bind ViewModel.Displays, Mode=OneWay}" ItemTemplate="{StaticResource DisplayTemplate}" SelectionMode="None" MaxHeight="340" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                                <TextBlock x:Uid="DisplayProfiles_EmptyState" Visibility="{x:Bind ViewModel.HasDisplays, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Topology Quick Actions -->
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_QuickTopology" HeaderIcon="{ui:FontIcon Glyph=&#xE74E;}">
                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Uid="DisplayProfiles_QuickTopology_Description" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsApplying, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsApplying, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Button Click="{x:Bind ViewModel.SetTopologyPrimaryOnly}" Style="{StaticResource DefaultButtonStyle}" HorizontalContentAlignment="Left" Padding="16" MinHeight="72" IsEnabled="{x:Bind ViewModel.IsApplying, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="DisplayProfiles_Topology_PrimaryOnly_Title" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="DisplayProfiles_Topology_PrimaryOnly_Description" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Click="{x:Bind ViewModel.SetTopologyAllDisplays}" Style="{StaticResource DefaultButtonStyle}" HorizontalContentAlignment="Left" Padding="16" MinHeight="72" IsEnabled="{x:Bind ViewModel.IsApplying, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="DisplayProfiles_Topology_AllDisplays_Title" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="DisplayProfiles_Topology_AllDisplays_Description" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </tkcontrols:SettingsCard>

                        <!-- Base Topology -->
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_BaseTopology" HeaderIcon="{ui:FontIcon Glyph=&#xE77B;}">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Save as Base Topology" Click="{x:Bind ViewModel.SetCurrentAsBaseTopology}" Style="{StaticResource DefaultButtonStyle}" />
                                <Button Content="Restore Base Topology" Click="RestoreBaseTopology_Click" Style="{StaticResource DefaultButtonStyle}" />
                            </StackPanel>
                        </tkcontrols:SettingsCard>
                    </controls:SettingsGroup>

                    <!-- Profiles Section -->
                    <controls:SettingsGroup x:Uid="DisplayProfiles_Profiles">
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_Profiles_Header" HeaderIcon="{ui:FontIcon Glyph=&#xE73D;}">
                            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="250" Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay}" PlaceholderText="Profile name..." />
                                    <Button Content="Save Profile" Click="SaveProfile_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.IsApplying, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />
                                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsApplying, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsApplying, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsProfilesLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsProfilesLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Saved profiles retain the selected monitors, positions, resolutions, and orientations." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}" ItemTemplate="{StaticResource ProfileTemplate}" SelectionMode="None" Height="200" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                                <TextBlock Grid.Row="3" Text="No saved profiles yet. Select one or more displays and save a profile." Visibility="{x:Bind ViewModel.HasProfiles, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </tkcontrols:SettingsCard>
                    </controls:SettingsGroup>

                    <!-- Controller Section -->
                    <controls:SettingsGroup x:Uid="DisplayProfiles_Controller">
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_ControllerEnabled">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.XboxControllerEnabled, Mode=TwoWay}" />
                        </tkcontrols:SettingsCard>
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_ControllerShortcut" HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Shortcut:" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.ControllerShortcut, Mode=TwoWay}" PlaceholderText="Guide + View" />
                            </Grid>
                        </tkcontrols:SettingsCard>
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_ControllerTest" HeaderIcon="{ui:FontIcon Glyph=&#xE768;}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Test Controller" Click="TestController_Click" Style="{StaticResource DefaultButtonStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ControllerStatus, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </tkcontrols:SettingsCard>
                    </controls:SettingsGroup>

                    <controls:SettingsGroup x:Uid="DisplayProfiles_Diagnostics">
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_Diagnostics_Header" HeaderIcon="{ui:FontIcon Glyph=&#xE9D9;}">
                            <StackPanel Spacing="8">
                                <Button Content="Refresh diagnostics" Click="RefreshDiagnostics_Click" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Left" />
                                <TextBox Text="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" AutomationProperties.Name="Monitor Power diagnostics" />
                            </StackPanel>
                        </tkcontrols:SettingsCard>
                    </controls:SettingsGroup>

                    <!-- Activation Shortcut Section -->
                    <controls:SettingsGroup x:Uid="DisplayProfiles_ActivationShortcut">
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_ActivationShortcut_Header" HeaderIcon="{ui:FontIcon Glyph=&#xE72D;}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <TextBlock x:Uid="DisplayProfiles_ActivationShortcut_OpenSelector" Text="Open Selector:" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActivationShortcut, Mode=OneWay}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" />
                                <Button x:Uid="DisplayProfiles_ActivationShortcut_CaptureButton" Grid.Column="2" Content="Capture shortcut" Click="CaptureActivationShortcut_Click" Style="{StaticResource DefaultButtonStyle}" />
                            </Grid>
                        </tkcontrols:SettingsCard>
                        <tkcontrols:SettingsCard x:Uid="DisplayProfiles_ActivationShortcut_Description">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </tkcontrols:SettingsCard>
                    </controls:SettingsGroup>

                    <!-- Status Bar -->
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,16,0,0">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" />
                    </Border>
                </StackPanel>
            </controls:SettingsPageControl.ModuleContent>
        </controls:SettingsPageControl>
    </ScrollViewer>
</local:NavigablePage>
