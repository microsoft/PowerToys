<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.ContextMenuManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    mc:Ignorable="d">
    <controls:SettingsPageControl x:Uid="ContextMenuManager" ModuleImageSource="ms-appx:///Assets/Settings/Modules/RegistryPreview.png">
        <controls:SettingsPageControl.ModuleContent>
            <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Orientation="Vertical">
                <tkcontrols:SettingsCard
                    x:Uid="ContextMenuManager_EnableToggleControl_HeaderText"
                    HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/RegistryPreview.png}">
                    <ToggleSwitch x:Uid="ToggleSwitch" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                </tkcontrols:SettingsCard>

                <controls:SettingsGroup x:Uid="ContextMenuManager_PreviewGroup" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <InfoBar
                        x:Uid="ContextMenuManager_HklmElevationNotice"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsNotElevated}"
                        Severity="Informational" />

                    <InfoBar
                        x:Uid="ContextMenuManager_RestartExplorerNotice"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.NeedsExplorerRestart, Mode=OneWay}"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Uid="ContextMenuManager_RestartExplorerButton" Command="{x:Bind ViewModel.RestartExplorerCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <tkcontrols:SettingsCard x:Uid="ContextMenuManager_PreviewTargetCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind ViewModel.IsCapturing, Mode=OneWay}" />
                            <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{x:Bind ViewModel.PreviewTargetIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_Desktop" />
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_FolderBackground" />
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_Folder" />
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_File" />
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_Drive" />
                            </ComboBox>
                            <Button x:Uid="ContextMenuManager_RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" />
                            <Button x:Uid="ContextMenuManager_RestartExplorerButtonInline" Command="{x:Bind ViewModel.RestartExplorerCommand}" />
                        </StackPanel>
                    </tkcontrols:SettingsCard>

                    <InfoBar
                        x:Uid="ContextMenuManager_CaptureErrorNotice"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasCaptureError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.CaptureError, Mode=OneWay}"
                        Severity="Warning" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Styled after the classic Explorer context menu.  -->
                        <Border
                            Width="340"
                            Padding="4"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <HyperlinkButton
                                    x:Uid="ContextMenuManager_PreviewBackButton"
                                    Margin="4,0,4,4"
                                    Command="{x:Bind ViewModel.BackToModernMenuCommand}"
                                    Visibility="{x:Bind ViewModel.CanGoBackToModernMenu, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewItems, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ContextMenuPreviewItem">
                                            <Grid>
                                                <Rectangle
                                                    Height="1"
                                                    Margin="0,4"
                                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    Visibility="{x:Bind IsSeparator}" />
                                                <TextBlock
                                                    Margin="12,4,12,2"
                                                    Opacity="0.6"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Text}"
                                                    Visibility="{x:Bind IsHeader}" />
                                                <Button
                                                    Padding="12,5"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="PreviewItem_Click"
                                                    DataContext="{x:Bind}"
                                                    Visibility="{x:Bind IsItem}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="12" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Width="16"
                                                            Height="16"
                                                            Opacity="{x:Bind TextOpacity}"
                                                            Source="{x:Bind Icon}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Opacity="{x:Bind TextOpacity}"
                                                            Text="{x:Bind Text}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Opacity="0.6"
                                                            Text="{x:Bind SideText}" />
                                                        <FontIcon
                                                            Grid.Column="3"
                                                            FontSize="10"
                                                            Glyph="&#xE76C;"
                                                            Visibility="{x:Bind HasChildren}" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--  Details of the clicked menu item.  -->
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            VerticalAlignment="Top"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Grid>
                                <TextBlock
                                    x:Uid="ContextMenuManager_DetailsPlaceholder"
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}" />
                                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Source="{x:Bind ViewModel.SelectedPreviewItem.Icon, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SelectedPreviewItem.Text, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Opacity="0.8"
                                        Text="{x:Bind ViewModel.SelectedDescription, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasSelectedEntry, Mode=OneWay}">
                                        <TextBlock x:Uid="ContextMenuManager_DetailsLocationHeader" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind ViewModel.SelectedLocation, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Uid="ContextMenuManager_DetailsExtensionNote"
                                        Opacity="0.8"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.IsSelectedExtension, Mode=OneWay}" />
                                    <ToggleSwitch
                                        x:Uid="ContextMenuManager_DetailsToggle"
                                        IsEnabled="{x:Bind ViewModel.SelectedEntry.IsToggleable, Mode=OneWay, FallbackValue=False}"
                                        IsOn="{x:Bind ViewModel.SelectedEntry.IsEnabled, Mode=OneWay, FallbackValue=False}"
                                        Toggled="DetailsToggleSwitch_Toggled"
                                        Visibility="{x:Bind ViewModel.HasSelectedEntry, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </controls:SettingsGroup>
            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>
    </controls:SettingsPageControl>
</local:NavigablePage>
