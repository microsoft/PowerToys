<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.ContextMenuManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    mc:Ignorable="d">
    <controls:SettingsPageControl x:Uid="ContextMenuManager" ModuleImageSource="ms-appx:///Assets/Settings/Modules/RegistryPreview.png">
        <controls:SettingsPageControl.ModuleContent>
            <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Orientation="Vertical">
                <tkcontrols:SettingsCard
                    x:Uid="ContextMenuManager_EnableToggleControl_HeaderText"
                    HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/RegistryPreview.png}">
                    <ToggleSwitch x:Uid="ToggleSwitch" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                </tkcontrols:SettingsCard>

                <controls:SettingsGroup x:Uid="ContextMenuManager_PreviewGroup" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsCard x:Uid="ContextMenuManager_PreviewTargetCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind ViewModel.IsCapturing, Mode=OneWay}" />
                            <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{x:Bind ViewModel.PreviewTargetIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_Desktop" />
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_FolderBackground" />
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_Folder" />
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_File" />
                                <ComboBoxItem x:Uid="ContextMenuManager_PreviewTarget_Drive" />
                            </ComboBox>
                            <Button
                                x:Uid="ContextMenuManager_CaptureButton"
                                Command="{x:Bind ViewModel.CaptureRealMenuCommand}"
                                IsEnabled="{x:Bind ViewModel.IsNotCapturing, Mode=OneWay}" />
                        </StackPanel>
                    </tkcontrols:SettingsCard>

                    <InfoBar
                        x:Uid="ContextMenuManager_CaptureErrorNotice"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasCaptureError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.CaptureError, Mode=OneWay}"
                        Severity="Warning" />

                    <!--  Styled after the classic Explorer context menu.  -->
                    <Border
                        Width="340"
                        Padding="4"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="12,4,12,4"
                                Opacity="0.6"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.PreviewSourceText, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ContextMenuPreviewItem">
                                        <Grid>
                                            <Rectangle
                                                Height="1"
                                                Margin="0,4"
                                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                Visibility="{x:Bind IsSeparator}" />
                                            <Button
                                                Padding="12,5"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="PreviewItem_Click"
                                                DataContext="{x:Bind}"
                                                Visibility="{x:Bind IsItem}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Width="16"
                                                        Height="16"
                                                        Source="{x:Bind Icon}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Opacity="{x:Bind TextOpacity}"
                                                        Text="{x:Bind Text}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Opacity="0.6"
                                                        Text="{x:Bind Shortcut}" />
                                                    <FontIcon
                                                        Grid.Column="3"
                                                        FontSize="10"
                                                        Glyph="&#xE76C;"
                                                        Visibility="{x:Bind HasChildren}" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </controls:SettingsGroup>

                <controls:SettingsGroup x:Uid="ContextMenuManager_GroupSettings" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <InfoBar
                        x:Uid="ContextMenuManager_HklmElevationNotice"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsNotElevated}"
                        Severity="Informational" />

                    <InfoBar
                        x:Uid="ContextMenuManager_RestartExplorerNotice"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.NeedsExplorerRestart, Mode=OneWay}"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Uid="ContextMenuManager_RestartExplorerButton" Command="{x:Bind ViewModel.RestartExplorerCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <tkcontrols:SettingsCard x:Uid="ContextMenuManager_SearchAndRefresh">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <AutoSuggestBox
                                x:Uid="ContextMenuManager_SearchBox"
                                MinWidth="{StaticResource SettingActionControlMinWidth}"
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Uid="ContextMenuManager_RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" />
                            <Button x:Uid="ContextMenuManager_RestartExplorerButtonInline" Command="{x:Bind ViewModel.RestartExplorerCommand}" />
                        </StackPanel>
                    </tkcontrols:SettingsCard>

                    <!--
                        ItemsControl, not ItemsRepeater: the repeater recycles cards between entries, and
                        re-binding IsOn on a recycled ToggleSwitch fires Toggled for the new entry, which
                        opened the confirmation dialog without any click. The list is small enough to
                        realize in full.
                    -->
                    <ItemsControl x:Name="EntriesListView" ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ContextMenuEntry">
                                <tkcontrols:SettingsCard
                                    Margin="{x:Bind IndentMargin}"
                                    Description="{x:Bind ScopeAndSourceDisplayName}"
                                    Header="{x:Bind DisplayName}">
                                    <tkcontrols:SettingsCard.HeaderIcon>
                                        <ImageIcon Source="{x:Bind Icon, Mode=OneWay}" />
                                    </tkcontrols:SettingsCard.HeaderIcon>
                                    <ToggleSwitch
                                        DataContext="{x:Bind}"
                                        IsEnabled="{x:Bind IsToggleable, Mode=OneWay}"
                                        IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                        Toggled="ContextMenuEntryToggleSwitch_Toggled" />
                                </tkcontrols:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:SettingsGroup>
            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>
    </controls:SettingsPageControl>
</local:NavigablePage>
