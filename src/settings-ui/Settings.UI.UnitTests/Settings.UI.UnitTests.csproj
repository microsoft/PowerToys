<Project Sdk="Microsoft.NET.Sdk">
  <!-- Look at Directory.Build.props in root for common stuff as well -->
  <Import Project="$(RepoRoot)src\Common.Dotnet.CsWinRT.props" />

  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <IsPackable>false</IsPackable>
    <OutputPath>$(RepoRoot)$(Configuration)\$(Platform)\tests\SettingsTests\</OutputPath>

    <!-- TODO: fix issues and reenable -->
    <!-- These are caused by streamjsonrpc dependency on Microsoft.VisualStudio.Threading.Analyzers -->
    <!-- We might want to add that to the project and fix the issues as well -->
    <NoWarn>VSTHRD002;VSTHRD110;VSTHRD100;VSTHRD200;VSTHRD101</NoWarn>
    <OutputType>Exe</OutputType>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Settings.UI.Library\Settings.UI.Library.csproj" />
    <ProjectReference Include="..\Settings.UI\PowerToys.Settings.csproj" />
  </ItemGroup>

  <!-- Pure Keyboard Manager editor recovery logic is linked here so it can be tested without
       loading WinUI or the native editor DLL. -->
  <ItemGroup>
    <Compile Include="$(RepoRoot)src\modules\keyboardmanager\KeyboardManagerEditorUI\Interop\ShortcutKeyMapping.cs" Link="KeyboardManagerEditorRecovery\ShortcutKeyMapping.cs" />
    <Compile Include="$(RepoRoot)src\modules\keyboardmanager\KeyboardManagerEditorUI\Interop\ShortcutOperationType.cs" Link="KeyboardManagerEditorRecovery\ShortcutOperationType.cs" />
    <Compile Include="$(RepoRoot)src\modules\keyboardmanager\KeyboardManagerEditorUI\Interop\TextReplacement.cs" Link="KeyboardManagerEditorRecovery\TextReplacement.cs" />
    <Compile Include="$(RepoRoot)src\modules\keyboardmanager\KeyboardManagerEditorUI\Helpers\TextReplacementTextValidator.cs" Link="KeyboardManagerEditorRecovery\TextReplacementTextValidator.cs" />
    <Compile Include="$(RepoRoot)src\modules\keyboardmanager\KeyboardManagerEditorUI\Settings\EditorSettings.cs" Link="KeyboardManagerEditorRecovery\EditorSettings.cs" />
    <Compile Include="$(RepoRoot)src\modules\keyboardmanager\KeyboardManagerEditorUI\Settings\EditorSettingsRecoveryValidator.cs" Link="KeyboardManagerEditorRecovery\EditorSettingsRecoveryValidator.cs" />
    <Compile Include="$(RepoRoot)src\modules\keyboardmanager\KeyboardManagerEditorUI\Settings\ShortcutSettings.cs" Link="KeyboardManagerEditorRecovery\ShortcutSettings.cs" />
    <Compile Include="$(RepoRoot)src\modules\keyboardmanager\KeyboardManagerEditorUI\Settings\TextReplacementMappingReconciler.cs" Link="KeyboardManagerEditorRecovery\TextReplacementMappingReconciler.cs" />
  </ItemGroup>
</Project>
