# Versions in package.json are exact pins; package-lock.json carries integrity hashes.
# Resolved URLs in the lockfile use registry.npmjs.org; npm rewrites that host to whatever
# registry is configured (for example the Azure Artifacts feed used by official builds).
save-exact=true
engine-strict=true
# Nothing here needs install scripts (esbuild ships its binary as an optional dependency).
ignore-scripts=true
fund=false
audit=false
