#include <windows.h>

#define PTPS_STRING2(value) #value
#define PTPS_STRING(value) PTPS_STRING2(value)
#define PTPS_VERSION_TEXT PTPS_STRING(PTPS_VERSION_MAJOR) "." PTPS_STRING(PTPS_VERSION_MINOR) "." PTPS_STRING(PTPS_VERSION_BUILD) "." PTPS_STRING(PTPS_VERSION_REVISION)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PTPS_VERSION_MAJOR,PTPS_VERSION_MINOR,PTPS_VERSION_BUILD,PTPS_VERSION_REVISION
 PRODUCTVERSION PTPS_VERSION_MAJOR,PTPS_VERSION_MINOR,PTPS_VERSION_BUILD,PTPS_VERSION_REVISION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Microsoft Corporation"
   VALUE "FileDescription", "PowerToys Protected Storage Setup"
   VALUE "FileVersion", PTPS_VERSION_TEXT
   VALUE "InternalName", "PowerToys.ProtectedStorageSetup"
   VALUE "OriginalFilename", "PowerToys.ProtectedStorageSetup.exe"
   VALUE "ProductName", "PowerToys (Preview) Protected Storage"
   VALUE "ProductVersion", PTPS_VERSION_TEXT
   VALUE "LegalCopyright", "Copyright (C) Microsoft Corporation. All rights reserved."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
