<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)src\Common.Dotnet.props" />
  <Import Project="$(RepoRoot)src\Common.SelfContained.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PowerToys.ProtectedStorage.LocalSmoke</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(RepoRoot)artifacts\ProtectedStorageLocalTest\$(Platform)\$(Configuration)\Smoke\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\modules\Workspaces\WorkspacesCsharpLibrary\WorkspacesCsharpLibrary.csproj" />
  </ItemGroup>
</Project>
