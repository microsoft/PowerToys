<Project Sdk="Microsoft.NET.Sdk">
  <!-- Look at Directory.Build.props in root for common stuff as well -->
  <Import Project="$(RepoRoot)src\Common.Dotnet.CsWinRT.props" />
  <Import Project="$(RepoRoot)src\Common.Dotnet.AotCompatibility.props" />

  <!-- No UI framework here: WPF, WinForms and WinUI apps reference this, and framework references flow into all of them. -->
  <PropertyGroup>
    <AssemblyName>PowerToys.Common.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManagedCommon\ManagedCommon.csproj" />
  </ItemGroup>


</Project>
